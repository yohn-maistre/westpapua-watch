{
  "name": "westpapua-watch",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "cf:dev": "npm run build && wrangler pages dev dist",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name=westpapua-watch",
    "check:content": "node scripts/check-content.mjs",
    "steward:content": "node scripts/steward-content.mjs",
    "steward:daily": "node scripts/watch-daily.mjs",
    "watch:config": "node scripts/render-watch-config.mjs",
    "watch:routes": "node scripts/deploy-ai-routes.mjs",
    "watch:deploy": "npm run watch:config && wrangler deploy --config services/watch-engine/wrangler.generated.jsonc",
    "watch:migrate": "npm run watch:config && wrangler d1 migrations apply DB --remote --config services/watch-engine/wrangler.generated.jsonc",
    "watch:dev": "npm run watch:config && wrangler dev --remote --config services/watch-engine/wrangler.generated.jsonc",
    "geo:source": "node geo/build.mjs",
    "geo:compile": "bash geo/compile.sh",
    "geo:build": "npm run geo:source && npm run geo:compile"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@mozilla/readability": "0.6.0",
    "@rowanmanning/feed-parser": "2.1.4",
    "astro": "7.2.10",
    "defuddle": "0.19.3",
    "linkedom": "0.18.13",
    "maplibre-gl": "5.24.0",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "wrangler": "4.127.1"
  }
}

---
import { NAV_ITEMS } from '../data/site';
import { alternateLocalePath, t, withLocale } from '../lib/i18n';
import type { Locale } from '../data/types';
const { locale='en', active='now', path=Astro.url.pathname } = Astro.props as { locale?: Locale; active?: string; path?: string };
---
<header class="masthead" data-masthead>
  <div class="wrap">
    <a href={withLocale('/', locale)} aria-label="West Papua Watch">
      <h1 class="masthead-brand"><span>WEST PAPUA</span><span class="watch">Watch</span></h1>
    </a>
    <nav class="masthead-nav" aria-label="Primary navigation">
      {NAV_ITEMS.map((item) => <a href={withLocale(item.href, locale)} aria-current={active===item.key?'page':undefined}>{t(item.label, locale)}</a>)}
    </nav>
    <div class="masthead-utils">
      <div class="utility-group">
        <div class="language-switch" aria-label="Language">
          <a class:list={[locale==='en' && 'active']} href={locale==='en'?path:alternateLocalePath(path, locale)} hreflang="en">EN</a>
          <a class:list={[locale==='pmy' && 'active']} href={locale==='pmy'?path:alternateLocalePath(path, locale)} hreflang="pmy">PMY</a>
        </div>
        <button class="ask-trigger" type="button" data-ask-open><span>{locale==='en'?'Ask':'Tanya'}</span><span class="key">⌘K</span></button>
      </div>
      <span class="eyebrow">{active === 'now' ? (locale==='en'?'Current':'Sekarang') : t(NAV_ITEMS.find(i=>i.key===active)?.label ?? active, locale)}</span>
    </div>
  </div>
</header>

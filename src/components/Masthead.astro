---
import '../styles/polish-04.css';
import { NAV_ITEMS } from '../data/site';
import { alternateLocalePath, t, withLocale } from '../lib/i18n';
import type { Locale } from '../data/types';
const { locale='en', active='now', path=Astro.url.pathname } = Astro.props as { locale?: Locale; active?: string; path?: string };
---
<header class="masthead" data-masthead>
  <div class="wrap">
    <a href={withLocale('/', locale)} aria-label="West Papua Watch">
      <div class="masthead-brand"><span>WEST PAPUA</span><span class="watch">Watch</span></div>
    </a>
    <nav class="masthead-nav" aria-label="Primary navigation">
      {NAV_ITEMS.map((item) => <a href={withLocale(item.href, locale)} aria-current={active===item.key?'page':undefined}>{item.key==='home'?<><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m3 10 9-7 9 7v11h-7v-7h-4v7H3Z"/></svg><span class="sr-only">{locale==='en'?'Home':'Beranda'}</span></>:t(item.label,locale)}</a>)}
    </nav>
    <div class="masthead-utils">
      <div class="language-switch" aria-label="Language">
        <a class:list={[locale==='en' && 'active']} href={locale==='en'?path:alternateLocalePath(path, locale)} hreflang="en">EN</a>
        <a class:list={[locale==='pmy' && 'active']} href={locale==='pmy'?path:alternateLocalePath(path, locale)} hreflang="id">ID</a>
      </div>
      <button class="ask-trigger" type="button" data-ask-open><svg class="ask-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-8 8H5l-3 2v-10a9 9 0 0 1 18 0Z"/><path d="M8 10h8m-8 4h5"/></svg><span>{locale==='en'?'Ask':'Tanya'}</span><span class="key">⌘K</span></button>
    </div>
  </div>
</header>

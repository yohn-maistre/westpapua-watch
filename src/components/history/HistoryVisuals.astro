---
import {figuresForPanel,type HistoryPanel} from '../../data/history-reading';
import {t} from '../../lib/i18n';
import type {Locale} from '../../data/types';
import HistoryArrow from './HistoryArrow.astro';
import {archivePreview} from '../../data/archive';
const {panel,locale='en'}=Astro.props as {panel:HistoryPanel;locale:Locale};
const figures=figuresForPanel(panel).slice(0,3);const en=locale==='en';
---
{figures.length>0&&<div class:list={['history-visuals',figures.length===1&&'is-single',figures.length===2&&'is-pair']} data-history-visuals>
 {figures.map(({archiveId,item},index)=>{const preview=archivePreview(archiveId);return <figure class:list={[item.mediaType==='document'&&'is-document']}>
  <button type="button" data-history-record={archiveId} aria-label={`${en?'Open':'Buka'}: ${t(item.title,locale)}`}>
   <img src={preview?.src||item.resolved.poster||item.resolved.image} srcset={preview?.srcset} sizes={index===0||figures.length===2?'(max-width:760px) calc(100vw - 50px), 30vw':'(max-width:760px) calc((100vw - 60px) / 2), 15vw'} alt={t(item.editorial.caption,locale)} loading="lazy" decoding="async" width={preview?.width||600} height={preview?.height||450}/>
   <span class:list={[item.mediaType==='film'&&'history-film-mark']} aria-hidden="true">{item.mediaType==='film'?'▶':<HistoryArrow direction="up-right"/>}</span>
  </button>
  <figcaption>{t(item.editorial.caption,locale)}</figcaption>
 </figure>})}
</div>}

---
import type {Locale} from '../data/types';
import '../styles/ask.css';
const {locale='en'}=Astro.props as {locale?:Locale};
const en=locale==='en';
const prompts=en?['What is happening in Raja Ampat?','Find resources on customary land','Explain the background to this page']:['Apa kabar terbaru dari Raja Ampat?','Cari sumber tentang tanah adat','Jelaskan latar belakang halaman ini'];
---
<dialog class="ask-dialog" data-ask-dialog data-locale={locale} aria-labelledby="ask-title" aria-describedby="ask-note">
 <header class="ask-head"><div><h2 id="ask-title">{en?'Ask Watch':'Tanya Watch'}</h2><p id="ask-note">{en?'Answers from Watch sources. Follow up in this conversation.':'Jawaban dari sumber Watch. Lanjutkan dengan pertanyaan berikutnya.'}</p></div><button type="button" data-ask-close aria-label={en?'Close':'Tutup'}>×</button></header>
 <div class="ask-scroll" data-ask-scroll>
  <div class="ask-prompts" data-ask-prompts>{prompts.map(prompt=><button class="chip" type="button" data-prompt={prompt}>{prompt}</button>)}</div>
  <div class="ask-thread" data-ask-thread role="log" aria-label={en?'Conversation':'Percakapan'} aria-live="polite" aria-relevant="additions"></div>
  <details class="ask-search" data-ask-search hidden><summary>{en?'Related pages & sources':'Halaman & sumber terkait'}</summary><p data-search-status></p><div data-ask-results></div></details>
 </div>
 <form class="ask-compose" data-ask-form>
  <label class="sr-only" for="ask-input">{en?'Your question':'Pertanyaan Anda'}</label><textarea id="ask-input" data-ask-input rows="2" maxlength="500" placeholder={en?'Ask a question or follow up…':'Tanya atau lanjutkan percakapan…'}></textarea>
  <div class="ask-compose-actions"><button type="button" data-ask-reset>{en?'New chat':'Percakapan baru'}</button><span data-ask-status role="status"></span><button type="button" data-ask-stop hidden>{en?'Stop':'Hentikan'}</button><button type="submit" class="ask-send" data-ask-submit>{en?'Send':'Kirim'} ↗</button></div>
  <small data-ask-memory>{en?'Kept in this tab for this session. The latest 6 exchanges inform follow-ups.':'Tersimpan di tab ini selama sesi. 6 percakapan terakhir menjadi konteks.'}</small>
 </form>
</dialog>
<script>import {initAsk} from '../lib/ask/client';initAsk();</script>

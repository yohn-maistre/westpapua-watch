---
import hdi from '../../../content/data/hdi.json';
import observations from '../../../content/data/watch-observations.json';
import {withLocale} from '../../lib/i18n';
import MapShell from '../map/MapShell.astro';
import otsus from '../../../content/data/otsus.json';
import apbd from '../../../content/data/apbd.json';
import sppg from '../../../content/data/sppg.json';
import '../../styles/data-dashboard.css';
const {locale='en'}=Astro.props;const en=locale==='en';
const n=(v:number,d=2)=>new Intl.NumberFormat(en?'en-GB':'id-ID',{maximumFractionDigits:d,minimumFractionDigits:d}).format(v);
const budget=otsus.rows.reduce((s,r)=>s+r.generalBudget+r.earmarkedBudget,0),actual=otsus.rows.reduce((s,r)=>s+r.generalActual+r.earmarkedActual,0);
const max=Math.max(...otsus.rows.map(r=>r.generalBudget+r.earmarkedBudget));
const maxSpend=Math.max(...apbd.baris.flatMap(r=>[r.b,r.bA]));
const sppgFeatures=[...new Map(sppg.features.map((f:any)=>[String(f.properties?.id||JSON.stringify(f.geometry)),f])).values()];
const fmtObservation=(o:any)=>`${o.qualifier?o.qualifier+' ':''}${new Intl.NumberFormat(en?'en-GB':'id-ID',{maximumFractionDigits:o.unit==='percent'?1:0}).format(o.value)}${o.unit==='percent'?'%':''}`;
---
<div class="data-spread">
<p class="data-deck">{en?'Measured change across Papua, with the public records behind every number.':'Perubahan terukur di Papua, dengan catatan publik di balik setiap angka.'}</p>
<nav class="data-chapters" aria-label={en?'On this page':'Pada halaman ini'}><a href="#measured">00 · {en?'Measured change':'Perubahan terukur'}</a><a href="#otsus">01 · Otsus</a><a href="#apbd">02 · APBD</a><a href="#mbg">03 · MBG</a><a href="#hdi">04 · IPM</a><a href="#law">05 · {en?'Law':'Hukum'}</a></nav>
<section class="data-section data-measured" id="measured" aria-labelledby="measured-title"><header class="data-section-head"><span class="eyebrow">00 / {en?'Evidence over time':'Bukti sepanjang waktu'}</span><h2 id="measured-title">{en?'What can be measured.':'Apa yang dapat diukur.'}</h2><p>{en?'Conflict, land and climate indicators are shown with their own definitions, periods and uncertainty. Different estimates are not silently combined.':'Indikator konflik, tanah, dan iklim ditampilkan dengan definisi, periode, dan ketidakpastiannya sendiri. Estimasi yang berbeda tidak digabungkan diam-diam.'}</p></header>
<div class="data-measured-grid">{observations.items.map((o:any)=><article class="data-observation"><span class="eyebrow">{o.group} · {o.place}</span><strong>{fmtObservation(o)}</strong><h3>{o.metric}</h3><p>{o.period} · {o.unit}</p><small>{o.scope}</small>{o.uncertainty&&<small>{o.uncertainty}</small>}<footer><a href={o.source.url} target="_blank" rel="noreferrer">{o.source.publisher} ↗</a>{o.relatedFollowing?.[0]&&<a href={withLocale(`/topics/${o.relatedFollowing[0]}/`,locale)}>{en?'Related record':'Catatan terkait'} →</a>}</footer></article>)}</div>
<div class="data-atlas"><div><span class="eyebrow">{en?'Same geography':'Geografi yang sama'}</span><h3>{en?'Inspect the Atlas.':'Lihat di Atlas.'}</h3><p>{en?'Use the existing environment, extraction, conflict and fire layers rather than a separate dashboard map.':'Gunakan lapisan lingkungan, ekstraksi, konflik, dan titik panas yang sama, bukan peta dashboard terpisah.'}</p></div><MapShell locale={locale} mode="context" initialView="environment" /></div>
</section>
<section class="data-feature" id="otsus" aria-labelledby="otsus-title">
<header class="data-section-head"><span class="eyebrow">01 / {en?'Special autonomy':'Otonomi khusus'} · 2026</span><h2 id="otsus-title">{en?'Follow the public money.':'Menelusuri dana publik.'}</h2><p>{en?'General and earmarked Otsus transfers, compared across six province-labelled accounts.':'Transfer Otsus umum dan yang ditentukan penggunaannya, dibandingkan pada akun enam provinsi.'}</p></header>
<div class="data-hero-number"><div><strong>Rp {n(actual/1000)}</strong><span>{en?'trillion transferred':'triliun tersalurkan'}</span></div><p>{en?'of':'dari'} Rp {n(budget/1000)} {en?'trillion allocated':'triliun pagu'}<br/><b>{n(actual/budget*100,1)}%</b> {en?'of allocation':'dari pagu'}</p></div>
<div class="data-legend"><span><i class="key-budget"></i>{en?'Allocation':'Pagu'}</span><span><i></i>{en?'Transferred':'Tersalurkan'}</span><small>{en?'Rp billion · common scale':'Rp miliar · skala sama'}</small></div>
<div class="fiscal-bars">{otsus.rows.map((r,i)=>{const b=r.generalBudget+r.earmarkedBudget,a=r.generalActual+r.earmarkedActual;return <div class="fiscal-row" style={`--tone:${i*17+190}`}><div class="fiscal-label"><span>{r.province}</span><b>{n(a)} <small>/ {n(b)}</small></b></div><div class="fiscal-track" role="img" aria-label={`${r.province}: ${n(a)} / ${n(b)} ${en?'billion rupiah transferred':'miliar rupiah tersalurkan'}`}><span class="fiscal-budget" style={`width:${b/max*100}%`}></span><span class="fiscal-actual" style={`width:${a/max*100}%`}></span></div></div>})}</div>
<details class="data-table-detail"><summary>{en?'Inspect the accounts':'Lihat rincian akun'} <span>↗</span></summary><div class="data-table-scroll" tabindex="0" role="region" aria-label={en?'Otsus accounts table':'Tabel akun Otsus'}><table><caption>{en?'2026 · Rp billion. Infrastructure transfers are shown separately.':'2026 · Rp miliar. Transfer infrastruktur ditampilkan terpisah.'}</caption><thead><tr><th scope="col">{en?'Province':'Provinsi'}</th><th scope="col">{en?'Account':'Akun'}</th><th scope="col">{en?'Allocation':'Pagu'}</th><th scope="col">{en?'Transferred':'Tersalurkan'}</th></tr></thead><tbody>{otsus.rows.flatMap(r=>[['General','Umum',r.generalBudget,r.generalActual],['Earmarked','Ditentukan penggunaannya',r.earmarkedBudget,r.earmarkedActual],['Infrastructure','Infrastruktur',r.infrastructureBudget,r.infrastructureActual]].map((a,j)=><tr><th scope="row">{r.province}</th><td>{a[en?0:1]}</td><td>{n(Number(a[2]))}</td><td>{n(Number(a[3]))}</td></tr>))}</tbody></table></div></details>
<p class="data-source"><a href={otsus.sourceUrl}>DJPK · SIKD CakLur ↗</a> · {en?'Source date':'Tanggal sumber'} {otsus.sourceAsOf}. {en?'Transfers are not expenditure. Infrastructure transfers are excluded from the headline total.':'Transfer bukan belanja. Transfer infrastruktur tidak termasuk dalam total utama.'}</p>
</section>
<section class="data-section" id="apbd" aria-labelledby="apbd-title"><header class="data-section-head"><span class="eyebrow">02 / {en?'Provincial budgets':'Anggaran provinsi'} · 2024</span><h2 id="apbd-title">{en?'Budget meets expenditure.':'Anggaran dan realisasi.'}</h2><p>{en?'Full-year provincial government spending. Each pair uses the same scale; the outline marks the budget and the solid bar marks reported expenditure.':'Belanja pemerintah provinsi setahun penuh. Setiap pasangan memakai skala yang sama; garis menunjukkan anggaran dan warna penuh menunjukkan realisasi.'}</p></header>
<div class="budget-grid">{apbd.baris.map((r,i)=><article class="budget-card" style={`--tone:${190+i*19}`}><span class="eyebrow">0{i+1}</span><h3><a href={withLocale('/data/'+r.nama.replace('Provinsi ','').toLowerCase().replaceAll(' ','-')+'/',locale)}>{r.nama.replace('Provinsi ','')} ↗</a></h3><strong>Rp {n(r.b/1e12)}<small>{en?' trillion spent':' triliun belanja'}</small></strong><div class="fiscal-track" aria-hidden="true"><span class="fiscal-budget" style={`width:${r.bA/maxSpend*100}%`}></span><span class="fiscal-actual" style={`width:${r.b/maxSpend*100}%`}></span></div><p>{n(r.b/r.bA*100,1)}% {en?'of':'dari'} Rp {n(r.bA/1e12)} {en?'trillion budget':'triliun anggaran'}</p><div class="spending-strip" aria-hidden="true"><i style={`width:${r.p/r.b*100}%`}></i><i style={`width:${r.m/r.b*100}%`}></i></div><dl><div><dt>{en?'Personnel':'Pegawai'}</dt><dd>{n(r.p/r.b*100,1)}%</dd></div><div><dt>{en?'Capital':'Modal'}</dt><dd>{n(r.m/r.b*100,1)}%</dd></div><div><dt>{en?'Other spending':'Belanja lain'}</dt><dd>{n((r.b-r.p-r.m)/r.b*100,1)}%</dd></div></dl></article>)}</div>
<p class="data-source"><a href={apbd.sourceUrl}>DJPK · APBD ↗</a> · {en?'Fiscal year 2024, period 12. Snapshot retrieved':'Tahun anggaran 2024, periode 12. Cuplikan diambil'} {apbd.diambil} · <a href={apbd.upstream}>{en?'Detak Detik snapshot':'Cuplikan Detak Detik'} ↗</a>. {en?'Budget revisions and reporting can produce expenditure above 100%. This is a different period and measure from the Otsus section.':'Perubahan anggaran dan pelaporan dapat menghasilkan realisasi di atas 100%. Periode dan ukuran ini berbeda dari bagian Otsus.'}</p></section>
<section class="data-section" id="mbg" aria-labelledby="mbg-title"><header class="data-section-head"><span class="eyebrow">03 / {en?'Public services':'Layanan publik'} · MBG</span><h2 id="mbg-title">{en?'Where services take shape.':'Di mana layanan dibangun.'}</h2><p>{en?'Recorded nutrition-service units (SPPG) in a dated public monitoring snapshot. Locations describe records, not confirmed meal delivery.':'Unit pelayanan pemenuhan gizi (SPPG) yang tercatat dalam cuplikan pemantauan publik. Lokasi menunjukkan catatan, bukan konfirmasi penyaluran makanan.'}</p></header><div class="mbg-layout mbg-layout-records"><aside class="mbg-note"><strong>{sppgFeatures.length}</strong><p>{en?'unique recorded units':'unit tercatat unik'}</p><hr/><b>0 {en?'marked operational':'berstatus beroperasi'}</b><p>{en?'All records in this snapshot are awaiting a unit head or marked not yet operating. This is not a census of current MBG coverage.':'Semua catatan dalam cuplikan ini menunggu kepala unit atau berstatus belum beroperasi. Ini bukan sensus cakupan MBG terkini.'}</p><small>{en?'Repository snapshot':'Cuplikan repositori'} · {sppg.snapshot}</small></aside></div>
<details class="data-table-detail"><summary>{en?'Browse recorded locations':'Lihat lokasi tercatat'} <span>↗</span></summary><div class="data-table-scroll mbg-list" tabindex="0" role="region" aria-label="SPPG"><table><caption>{en?'Addresses and status as recorded by the source':'Alamat dan status sesuai catatan sumber'}</caption><thead><tr><th scope="col">ID</th><th scope="col">{en?'Address':'Alamat'}</th><th scope="col">Status</th></tr></thead><tbody>{sppgFeatures.map((f:any)=><tr><th scope="row">{f.properties.id}</th><td>{f.properties.alamat}</td><td>{f.properties.status}</td></tr>)}</tbody></table></div></details><p class="data-source"><a href={sppg.source}>SismonBGN ↗</a> · <a href={sppg.upstream}>{en?'Snapshot via Detak Detik':'Cuplikan melalui Detak Detik'} ↗</a>. {en?'Third-party monitoring data; status has not been independently reverified.':'Data pemantauan pihak ketiga; status belum diverifikasi ulang secara independen.'}</p></section>
<section class="data-section" id="hdi" aria-labelledby="hdi-title"><header class="data-section-head"><span class="eyebrow">04 / {en?'Human development':'Pembangunan manusia'} · {hdi.years[0]}–{hdi.years[1]}</span><h2 id="hdi-title">{en?'Beyond the budget.':'Melampaui anggaran.'}</h2><p>{en?'BPS Human Development Index combines health, education and living-standard dimensions. Compare the same geography across the two latest years in this dataset.':'Indeks Pembangunan Manusia BPS menggabungkan dimensi kesehatan, pendidikan, dan standar hidup. Bandingkan wilayah yang sama pada dua tahun terbaru dalam data ini.'}</p></header>
<div class="hdi-chart"><div class="data-legend"><span>○ {hdi.years[0]}</span><span>● {hdi.years[1]}</span><small>{en?'Index · 0–100':'Indeks · 0–100'}</small></div>{hdi.rows.map(r=><div class="hdi-row"><span>{r.province}</span><div class="hdi-line" role="img" aria-label={`${r.province}: ${hdi.years[0]} ${r.previous}, ${hdi.years[1]} ${r.current}`}><i style={`left:${r.previous}%`} class="hdi-previous"></i><i style={`left:${r.current}%`} class="hdi-current"></i></div><b>{n(r.current)}<small> +{n(r.current-r.previous)}</small></b></div>)}<div class="hdi-axis" aria-hidden="true"><span>0</span><span>50</span><span>100</span></div></div>
<details class="data-table-detail"><summary>{en?'Compare exact values':'Bandingkan nilai lengkap'} <span>↗</span></summary><div class="data-table-scroll" tabindex="0" role="region" aria-label="IPM"><table><caption>{en?'Human Development Index · BPS':'Indeks Pembangunan Manusia · BPS'}</caption><thead><tr><th scope="col">{en?'Province':'Provinsi'}</th><th scope="col">{hdi.years[0]}</th><th scope="col">{hdi.years[1]}</th><th scope="col">{en?'Change (points)':'Perubahan (poin)'}</th></tr></thead><tbody>{hdi.rows.map(r=><tr><th scope="row">{r.province}</th><td>{n(r.previous)}</td><td>{n(r.current)}</td><td>+{n(r.current-r.previous)}</td></tr>)}</tbody></table></div></details><p class="data-source"><a href={hdi.sourceUrl}>{hdi.source} ↗</a> · {hdi.publication}. {en?'Comparable province values from the official BPS series.':'Nilai provinsi yang dapat dibandingkan dari seri resmi BPS.'}</p></section>
<section class="data-section law-spread" id="law" aria-labelledby="law-title"><div><span class="eyebrow">05 / {en?'Legal framework':'Kerangka hukum'}</span><h2 id="law-title">{en?'The rules behind the figures.':'Aturan di balik angka.'}</h2></div><article><span class="eyebrow">UU 2 / 2021</span><h3>{en?'Papua special autonomy':'Otonomi khusus Papua'}</h3><p>{en?'The 2021 law makes the second amendment to the 2001 special-autonomy law. It changes provisions concerning governance and the management of special-autonomy funding.':'Undang-undang tahun 2021 ini merupakan perubahan kedua atas UU Otonomi Khusus tahun 2001. Perubahannya mencakup pemerintahan dan pengelolaan penerimaan otonomi khusus.'}</p><dl><div><dt>{en?'Enacted':'Ditetapkan'}</dt><dd>19 July 2021</dd></div><div><dt>{en?'Amends':'Mengubah'}</dt><dd>UU 21/2001 · UU 35/2008</dd></div></dl><a href="https://peraturan.bpk.go.id/Details/172403/uu-no-2-tahun-2021">{en?'Read the law and amendment record':'Baca undang-undang dan riwayat perubahan'} · JDIH BPK ↗</a></article></section>

</div>
<script>
import points from '../../../content/data/sppg.json';
const target=document.querySelector<HTMLElement>('[data-mbg-map]');
if(target){const observer=new IntersectionObserver(async entries=>{if(!entries.some(e=>e.isIntersecting))return;observer.disconnect();try{const [{default:maplibre}]=await Promise.all([import('maplibre-gl'),import('maplibre-gl/dist/maplibre-gl.css')]);const map=new maplibre.Map({container:target,style:{version:8,sources:{terrain:{type:'raster',tiles:['https://tiles.maps.eox.at/wmts/1.0.0/terrain-light_3857/default/GoogleMapsCompatible/{z}/{y}/{x}.jpg'],tileSize:256,attribution:'Terrain © EOX · OpenStreetMap contributors · NASA / METI'}},layers:[{id:'terrain',type:'raster',source:'terrain',paint:{'raster-saturation':-.6}}]},bounds:[[129,-9.5],[141.1,0.6]],fitBoundsOptions:{padding:24},scrollZoom:false});map.addControl(new maplibre.NavigationControl({showCompass:false}),'top-right');map.on('load',()=>{target.querySelector('[data-map-loading]')?.remove();map.addSource('sppg',{type:'geojson',data:points as any});map.addLayer({id:'units',type:'circle',source:'sppg',paint:{'circle-radius':6,'circle-color':'#796697','circle-stroke-width':1.5,'circle-stroke-color':'#fff'}});map.on('click','units',e=>{const f=e.features?.[0];if(!f)return;new maplibre.Popup().setLngLat(e.lngLat).setText(`${f.properties?.alamat} · ${f.properties?.status}`).addTo(map)});});map.on('error',()=>{const p=target.querySelector('[data-map-loading]');if(p)p.textContent='Map unavailable. Recorded locations are listed below.'});}catch{const p=target.querySelector('[data-map-loading]');if(p)p.textContent='Map unavailable. Recorded locations are listed below.'}},{rootMargin:'200px'});observer.observe(target)}
</script>

---
import languages from '../../../content/data/languages-curated.json';
const {locale='en'}=Astro.props;const en=locale==='en';
---
<section class="language-spread data-section" id="languages" aria-labelledby="languages-title">
 <header class="data-section-head"><span class="eyebrow">06 / {en?'LANGUAGES':'BAHASA'}</span><h2 id="languages-title">{en?'Languages of Papua':'Bahasa-bahasa Papua'}</h2></header>
 <div class="language-field" role="list" aria-label={en?'Selected language records':'Pilihan catatan bahasa'}>
  {languages.map((language,i)=><a role="listitem" class={`language-name language-name-${i+1}`} href={`https://glottolog.org/resource/languoid/id/${language.glottocode}`} target="_blank" rel="noreferrer" aria-label={`${language.name}, Glottolog ${language.glottocode}`}><span class="language-index">{String(i+1).padStart(2,'0')}</span><strong>{language.name}</strong><span class="language-code">{language.glottocode} ↗</span></a>)}
 </div>
 <p class="data-source">{en?'A selection of Glottolog 5.3 language records, not an exhaustive list. The arrangement is editorial; it does not show where languages are spoken or define customary territories.':'Pilihan catatan bahasa dari Glottolog 5.3, bukan daftar lengkap. Susunannya bersifat editorial; ini bukan peta persebaran bahasa atau batas wilayah adat.'} <a href="https://glottolog.org/" target="_blank" rel="noreferrer">Glottolog 5.3 ↗</a></p>
</section>
<style>
.language-spread{border-top:1px solid #ffffff18}.language-field{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:10px;position:relative;margin:2.5rem 0 1.6rem;padding:clamp(12px,2vw,26px);border:1px solid #ffffff1c;border-radius:26px;background:radial-gradient(circle at 22% 9%,#93c6bb25,transparent 34%),radial-gradient(circle at 80% 67%,#baa1de26,transparent 38%),#191c25;overflow:hidden}.language-field:before{content:'';position:absolute;width:95%;aspect-ratio:1;border:1px solid #ffffff12;border-radius:50%;left:18%;top:-125%;box-shadow:0 0 0 100px #ffffff05,0 0 0 200px #ffffff03;pointer-events:none}.language-name{grid-column:span 3;min-height:165px;padding:18px 20px;border:1px solid #ffffff21;border-radius:14px;display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between;position:relative;overflow:hidden;background:linear-gradient(138deg,#ffffff0b,#ffffff03);transition:transform .25s ease,background .25s ease,border-color .25s ease}.language-name:hover,.language-name:focus-visible{transform:translateY(-4px);border-color:#e1d4fb99;background:#ffffff13}.language-name strong{font-size:clamp(1.4rem,2.7vw,3rem);letter-spacing:-.055em;line-height:1.02;font-weight:600;position:relative;overflow-wrap:anywhere}.language-index,.language-code{font-size:.66rem;letter-spacing:.1em;color:#c1b9ca}.language-code{align-self:flex-end;font-variant-numeric:tabular-nums}.language-name-1,.language-name-6{grid-column:span 4}.language-name-2,.language-name-5{grid-column:span 2}.language-name-1 strong,.language-name-6 strong{font-size:clamp(2.1rem,3.7vw,4.7rem)}.language-name:nth-child(4n+1){background:linear-gradient(140deg,#748b8a2c,#ffffff03)}.language-name:nth-child(4n+2){background:linear-gradient(140deg,#957d9e31,#ffffff03)}.language-name:nth-child(4n+3){background:linear-gradient(140deg,#8390b62c,#ffffff03)}@media(max-width:800px){.language-field{grid-template-columns:repeat(2,minmax(0,1fr))}.language-name,.language-name-1,.language-name-2,.language-name-5,.language-name-6{grid-column:span 1;min-height:145px}.language-name strong,.language-name-1 strong,.language-name-6 strong{font-size:clamp(1.5rem,5vw,2.5rem)}}@media(max-width:420px){.language-field{gap:7px;padding:8px}.language-name{min-height:135px;padding:12px}.language-name strong{font-size:1.5rem}.language-code{font-size:.55rem}}@media(prefers-reduced-motion:reduce){.language-name{transition:none}.language-name:hover{transform:none}}
</style>

---
import apbd from '../../../content/data/apbd.json';
import {withLocale} from '../../lib/i18n';
const {locale='en'}=Astro.props;const en=locale==='en';
const n=(v:number,d=2)=>new Intl.NumberFormat(en?'en-GB':'id-ID',{maximumFractionDigits:d}).format(v);
const max=Math.max(...apbd.baris.flatMap(r=>[r.b,r.bA]));
---
<div class="budget-comparison">
 <div class="budget-key"><span><i></i>{en?'Budget':'Anggaran'}</span><span><i></i>{en?'Expenditure':'Realisasi'}</span><small>Rp {en?'trillion':'triliun'}</small></div>
 {apbd.baris.map((r,i)=><details class="budget-line"><summary><span class="budget-name"><small>0{i+1}</small>{r.nama.replace('Provinsi ','')}</span><span class="budget-bars" aria-hidden="true"><i style={`width:${r.bA/max*100}%`}></i><i style={`width:${r.b/max*100}%`}></i></span><span class="budget-value">{n(r.b/1e12)} <small>/ {n(r.bA/1e12)}</small><em>{n(r.b/r.bA*100,1)}%</em></span><span class="budget-expand" aria-hidden="true">+</span><span class="sr-only">{en?'Expenditure and budget, trillion rupiah. Expand breakdown.':'Realisasi dan anggaran, triliun rupiah. Buka rincian.'}</span></summary>
 <div class="budget-breakdown"><div class="budget-composition" role="img" aria-label={`${en?'Personnel':'Pegawai'} ${n(r.p/r.b*100,1)}%, ${en?'Capital':'Modal'} ${n(r.m/r.b*100,1)}%, ${en?'Other':'Lainnya'} ${n((r.b-r.p-r.m)/r.b*100,1)}%`}><i style={`width:${r.p/r.b*100}%`}></i><i style={`width:${r.m/r.b*100}%`}></i></div><dl><div><dt>{en?'Personnel':'Pegawai'}</dt><dd>{n(r.p/r.b*100,1)}%</dd></div><div><dt>{en?'Capital':'Modal'}</dt><dd>{n(r.m/r.b*100,1)}%</dd></div><div><dt>{en?'Other spending':'Belanja lainnya'}</dt><dd>{n((r.b-r.p-r.m)/r.b*100,1)}%</dd></div></dl><a href={withLocale('/data/'+r.nama.replace('Provinsi ','').toLowerCase().replaceAll(' ','-')+'/',locale)}>{en?'Province profile':'Profil provinsi'} ↗</a></div>
 </details>)}
 <div class="budget-axis" aria-hidden="true"><span>0</span><span>{n(max/2/1e12)}</span><span>{n(max/1e12)}</span></div>
</div>
<style>
.budget-comparison{margin-top:36px}.budget-key{display:flex;gap:24px;align-items:center;font-size:.75rem;color:#bfb9cd;margin-bottom:24px}.budget-key span{display:flex;align-items:center;gap:8px}.budget-key i{display:inline-block;width:18px;height:7px;border:1px solid #abb5c4;border-radius:2px}.budget-key span:nth-child(2) i{background:#b2c8bd;border:0}.budget-key small{margin-left:auto}
.budget-line{border-top:1px solid #ffffff17}.budget-line summary{display:grid;grid-template-columns:220px minmax(0,1fr) 135px 20px;align-items:center;gap:24px;min-height:100px;cursor:pointer;list-style:none}.budget-line summary::-webkit-details-marker{display:none}.budget-name{font-size:1rem;letter-spacing:-.02em}.budget-name small{font-size:.65rem;color:#91879f;margin-right:14px}.budget-bars{position:relative;height:24px}.budget-bars i{position:absolute;left:0;top:1px;height:21px;border:1px solid #8795a166;border-radius:4px}.budget-bars i:nth-child(2){top:8px;height:7px;background:linear-gradient(90deg,#9589b1,#b5cdbd);border:0}.budget-value{text-align:right;font-size:1.35rem;font-variant-numeric:tabular-nums;letter-spacing:-.03em}.budget-value small{font-size:.8rem;color:#aba4b8}.budget-value em{display:block;font-style:normal;font-size:.7rem;color:#b9caba;margin-top:5px}.budget-expand{color:#baadd5;font-size:1.4rem}.budget-line[open] .budget-expand{transform:rotate(45deg)}.budget-line[open]{background:linear-gradient(100deg,#27233455,transparent)}.budget-breakdown{margin:0 44px 26px 244px;padding:18px 0}.budget-composition{height:7px;background:#ffffff17;border-radius:5px;overflow:hidden;display:flex}.budget-composition i:first-child{background:#b2a0c9}.budget-composition i:last-child{background:#abc3b1}.budget-breakdown dl{display:flex;justify-content:space-between;gap:20px;font-size:.75rem;margin:20px 0}.budget-breakdown dt{color:#aaa1b7}.budget-breakdown dd{margin:6px 0}.budget-breakdown a{font-size:.75rem;color:#c6b5df}.budget-axis{display:flex;justify-content:space-between;margin:12px 203px 0 244px;color:#9c92ab;font-size:.65rem}
@media(max-width:760px){.budget-line summary{grid-template-columns:1fr auto 18px;gap:12px;padding:22px 0}.budget-name{font-size:1rem}.budget-bars{grid-column:1/-1;grid-row:2}.budget-value{font-size:1.2rem}.budget-expand{grid-column:3;grid-row:1}.budget-breakdown{margin:0 0 20px;padding:10px 0}.budget-axis{margin:14px 0}.budget-key{gap:16px}.budget-name small{margin-right:8px}}
</style>

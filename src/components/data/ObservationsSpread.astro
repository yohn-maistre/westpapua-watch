---
import observations from '../../../content/data/watch-observations.json';
import ObservationNotes from './ObservationNotes.astro';
const {locale='en'}=Astro.props;const en=locale==='en';
const conflict=observations.items.filter(x=>x.group==='Conflict & displacement'),forest=observations.items.filter(x=>x.group==='Forest & land');
const ice=observations.items.find(x=>x.measure==='share')!,hotspots=observations.items.find(x=>x.measure==='detection')!;
const n=(v:number)=>new Intl.NumberFormat(en?'en-GB':'id-ID').format(v);
const maxForest=Math.max(...forest.map(x=>x.value));
---
<section id="measured" class="observations-spread" aria-label={en?'Conflict, land and climate':'Konflik, lahan dan iklim'}>
 <section class="displacement-spread"><header><h2>{en?'Conflict & displacement':'Konflik & pengungsian'}</h2><p>{en?'Reported estimates · separate geographic scopes':'Estimasi yang dilaporkan · cakupan wilayah berbeda'}</p></header>
 <div class="displacement-records">{conflict.map(o=><article><div><span class="eyebrow">{o.place}</span><strong>{o.qualifier&&<small>{en?o.qualifier:'lebih dari'}</small>}{n(o.value)}</strong><p>{o.metric}</p><time>{o.period}</time></div><ObservationNotes item={o} locale={locale}/></article>)}</div>
 </section>
 <section class="forest-spread"><header><h2>{en?'Primary forest loss':'Kehilangan hutan primer'}</h2><p>2024 · {en?'hectares':'hektare'}</p></header>
 {forest.map(o=><article class="forest-row"><div class="forest-label"><h3>{o.place}{o.place==='Merauke'&&<small> · {en?'PSN footprint':'Area PSN'}</small>}</h3><strong>{n(o.value)} <small>ha</small></strong></div><svg viewBox="0 0 800 32" preserveAspectRatio="none" role="img" aria-label={`${o.place}: ${n(o.value)} ha`}><rect x="0" y="8" width="800" height="16" rx="8" fill="#ffffff0b"/><rect x="0" y="8" width={o.value/maxForest*800} height="16" rx="8" fill={o.place==='Papua'?'#abc5b0':'#a99bc7'}/></svg><ObservationNotes item={o} locale={locale}/></article>)}
 </section>
 <div class="climate-spread"><section class="ice-panel"><div class="ice-ring"><svg viewBox="0 0 120 120" role="img" aria-label={`${ice.value}% ${ice.metric}`}><circle cx="60" cy="60" r="48" fill="none" stroke="#ffffff14" stroke-width="4"/><circle cx="60" cy="60" r="48" fill="none" stroke="#c4dcea" stroke-width="8" pathLength="100" stroke-dasharray={`${ice.value} ${100-ice.value}`} transform="rotate(-90 60 60)"/></svg><strong>{ice.value}%</strong></div><div><span class="eyebrow">{ice.place} · {ice.period}</span><h2>{en?'Remaining tropical ice':'Sisa es tropis'}</h2><p>{en?'Share of the 1988 ice area':'Persentase luas es tahun 1988'}</p><ObservationNotes item={ice} locale={locale}/></div></section>
 <section class="hotspot-panel"><span class="eyebrow">{hotspots.place}</span><strong>{n(hotspots.value)}</strong><h2>{en?'Thermal detections':'Deteksi panas'}</h2><p>{hotspots.period} · {en?'High confidence':'Keyakinan tinggi'}</p><ObservationNotes item={hotspots} locale={locale}/></section></div>
</section>
<style is:global>
.observations-spread{margin:20px 0 60px}.observations-spread h2{font-size:clamp(1.6rem,3vw,2.8rem);line-height:1.1;letter-spacing:-.045em;margin:0 0 12px}.observations-spread header>p,.observations-spread time{font-size:.8rem;color:var(--data-muted)}
.displacement-spread,.forest-spread{padding:32px 0 42px;border-top:1px solid var(--data-rule)}.displacement-records{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;margin-top:32px}.displacement-records article{display:flex;flex-direction:column;justify-content:space-between;min-width:0;border-left:1px solid var(--data-rule);padding-left:24px}.displacement-records strong{display:block;font-size:clamp(2.4rem,4.5vw,4.8rem);font-weight:500;letter-spacing:-.055em;line-height:1.15;margin:20px 0 12px}.displacement-records strong small{font-size:.72rem;letter-spacing:0;display:block;color:#b9afcc}.displacement-records p{font-size:.93rem;line-height:1.5;max-width:33ch}.observation-source{font-size:.72rem;color:#b6afc6;margin-top:20px;line-height:1.55}.observation-source>a{display:inline-block;margin-bottom:8px}.observation-source summary{cursor:pointer}.observation-source details p{font-size:.75rem;line-height:1.6;max-width:60ch}.forest-row{padding:24px 0;border-bottom:1px solid var(--data-rule)}.forest-label{display:flex;justify-content:space-between;gap:18px;align-items:baseline}.forest-label h3{font-size:1.1rem;font-weight:500}.forest-label strong{font-size:2rem;font-variant-numeric:tabular-nums;font-weight:500}.forest-label small{font-size:.75rem;color:var(--data-muted)}.forest-row>svg{width:100%;height:32px}.forest-row .observation-source{margin-top:10px}
.climate-spread{display:grid;grid-template-columns:1.5fr 1fr;gap:20px;margin:30px 0}.ice-panel,.hotspot-panel{padding:32px;border:1px solid var(--data-rule);border-radius:24px;background:radial-gradient(ellipse at 100% 0,#34445166,transparent 80%),#12151e}.ice-panel{display:flex;align-items:center;gap:28px}.ice-ring{position:relative;flex:0 0 160px}.ice-ring svg{width:100%;display:block}.ice-ring strong{position:absolute;inset:0;display:grid;place-items:center;font-size:2.8rem;font-weight:500;letter-spacing:-.06em}.climate-spread h2{font-size:1.4rem;margin-top:14px}.climate-spread p{font-size:.8rem;color:var(--data-muted)}.hotspot-panel>strong{display:block;font-size:4rem;letter-spacing:-.06em;font-weight:500;margin-top:20px}
@media(max-width:900px){.climate-spread{grid-template-columns:1fr}.displacement-records{gap:20px}.displacement-records article{padding-left:15px}}
@media(max-width:600px){.displacement-records{grid-template-columns:1fr}.displacement-records article{padding:22px 0;border-left:0;border-top:1px solid var(--data-rule);display:grid;grid-template-columns:1.4fr 1fr;gap:20px}.displacement-records strong{font-size:2.8rem}.ice-panel{padding:24px;gap:20px}.ice-ring{flex-basis:110px}.ice-ring strong{font-size:2.1rem}.forest-label strong{font-size:1.65rem}}
.displacement-records{gap:0;border:1px solid #ffffff1b;border-radius:24px;overflow:hidden;background:#151820}.displacement-records article{isolation:isolate;position:relative;padding:clamp(20px,2.6vw,36px);border-left:1px solid #ffffff1b;min-height:330px;background:radial-gradient(circle at 90% 20%,#b5a5d42a,transparent 50%),linear-gradient(145deg,#202432,#12151e)}.displacement-records article:first-child{border-left:0}.displacement-records article:nth-child(2){background:radial-gradient(circle at 80% 12%,#a7bdc922,transparent 48%),linear-gradient(155deg,#222833,#12151d)}.displacement-records article:nth-child(3){background:radial-gradient(circle at 85% 15%,#b3aba82b,transparent 47%),linear-gradient(150deg,#242128,#12151d)}.displacement-records article::before{content:'';position:absolute;inset:0;z-index:-1;opacity:.32;pointer-events:none;background:repeating-radial-gradient(ellipse at 125% 5%,transparent 0 38px,#bbb4cc32 39px 40px,transparent 41px 75px)}.displacement-records strong{font-variant-numeric:tabular-nums}.displacement-records time{display:block;margin-bottom:12px}.forest-row>svg rect:nth-child(2){filter:drop-shadow(0 0 8px #a9cfbc66)}
@media(max-width:600px){.displacement-records article{min-height:0;border-left:0;border-top:1px solid #ffffff1b;display:block;padding:25px}.displacement-records article:first-child{border-top:0}.displacement-records strong{margin:8px 0}.displacement-records p{margin:0 0 8px}.displacement-records time{margin:0}}
</style>

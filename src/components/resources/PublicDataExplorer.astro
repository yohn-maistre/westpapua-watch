ong{font-variant-numeric:tabular-nums}.finance-row strong small{color:#aaa9b7;font-weight:400}.finance-track{position:relative;height:18px}.finance-track i{position:absolute;left:0;border-radius:4px;transition:width .5s cubic-bezier(.2,.8,.2,1)}.finance-budget{top:0;height:18px;width:var(--budget);border:1px solid #a9afc55c;background:#ffffff03}.finance-actual{top:5px;height:8px;width:var(--actual);background:linear-gradient(90deg,#9e8bbd,#b9d1c2)}.data-big-number{font-size:clamp(4rem,9vw,8rem);line-height:.8;letter-spacing:-.08em;font-weight:500}.service-layout{display:grid;grid-template-columns:1.15fr .85fr;gap:2rem}.service-provinces>div{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-top:1px solid #ffffff14}.service-provinces strong{font-size:1.4rem}.service-layout aside{padding:1.4rem;border-left:1px solid #ffffff18}.service-layout aside>strong{display:block;font-size:4.5rem;letter-spacing:-.07em;line-height:1}.service-layout aside>span{display:block;margin:.4rem 0 1.2rem;color:#c9c5d2}.service-layout aside p{font-size:.82rem;line-height:1.6;color:#aaa9b7}.environment-grid{display:grid;grid-template-columns:1.2fr .8fr .8fr;gap:1rem}.forest-mini{padding:1rem 1.2rem;border:1px solid #ffffff16;border-radius:18px;background:#0b0e1438}.forest-mini>div{padding:.9rem 0;border-top:1px solid #ffffff12}.forest-mini>div:first-child{border-top:0}.forest-mini>div>div{display:flex;justify-content:space-between;gap:1rem;align-items:baseline}.forest-mini strong small{font-size:.65rem;color:#aaa9b7}.forest-mini i{display:block;height:8px;background:#ffffff0d;border-radius:99px;margin-top:.7rem;overflow:hidden}.forest-mini b{display:block;height:100%;background:linear-gradient(90deg,#8da998,#b7cdbc);border-radius:99px}.environment-stat{display:flex;flex-direction:column;justify-content:flex-end;min-height:230px;padding:1.2rem;border:1px solid #ffffff16;border-radius:18px;background:linear-gradient(145deg,#ffffff08,#ffffff02)}.environment-stat small{colo
---
import hdi from '../../../content/data/hdi.json';
import poverty from '../../../content/data/poverty-2025.json';
import otsus from '../../../content/data/otsus.json';
import apbd from '../../../content/data/apbd.json';
import sppg from '../../../content/data/sppg.json';
import observations from '../../../content/data/watch-observations.json';
import languages from '../../../content/data/languages-curated.json';
import {withLocale} from '../../lib/i18n';
const {locale='en'}=Astro.props;const en=locale==='en';
const nf=(value:number,d=1)=>new Intl.NumberFormat(en?'en-GB':'id-ID',{maximumFractionDigits:d,minimumFractionDigits:d}).format(value);
const int=(value:number)=>new Intl.NumberFormat(en?'en-GB':'id-ID').format(value);
const povertyByProvince=Object.fromEntries(poverty.rows.map(row=>[row.province,row.value]));
const otsusRows=otsus.rows.map(row=>({province:row.province,budget:row.generalBudget+row.earmarkedBudget,actual:row.generalActual+row.earmarkedActual}));
const otsusMax=Math.max(...otsusRows.map(row=>row.budget));
const apbdRows=apbd.baris.map(row=>({province:row.nama.replace('Provinsi ',''),budget:row.bA/1e12,actual:row.b/1e12}));
const apbdMax=Math.max(...apbdRows.map(row=>Math.max(row.budget,row.actual)));
const uniqueSppg=[...new Map(sppg.features.map((f:any)=>[String(f.properties?.id||JSON.stringify(f.geometry)),f])).values()] as any[];
const provinceNames=['PAPUA BARAT DAYA','PAPUA PEGUNUNGAN','PAPUA TENGAH','PAPUA SELATAN','PAPUA BARAT','PAPUA'];
const displayProvince=(name:string)=>name.toLowerCase().replace(/(^|\s)\S/g,m=>m.toUpperCase());
const sppgByProvince=provinceNames.map(name=>({name:displayProvince(name),count:uniqueSppg.filter((f:any)=>String(f.properties?.alamat||'').toUpperCase().includes(name)).length})).filter(x=>x.count>0);
const forest=observations.items.filter(x=>x.group==='Forest & land');
const maxForest=Math.max(...forest.map(x=>x.value));
const ice=observations.items.find(x=>x.measure==='share');
const hotspots=observations.items.find(x=>x.measure==='detection');
const panels=[
 {id:'people',index:'01',en:'People',idLabel:'Penduduk'},
 {id:'finance',index:'02',en:'Public finance',idLabel:'Keuangan publik'},
 {id:'services',index:'03',en:'Services',idLabel:'Layanan publik'},
 {id:'environment',index:'04',en:'Environment',idLabel:'Lingkungan'},
 {id:'languages',index:'05',en:'Languages',idLabel:'Bahasa'},
 {id:'law',index:'06',en:'Law',idLabel:'Hukum'}
];
---
<section class="public-data" id="public-data" data-public-data data-locale={locale} aria-labelledby="public-data-title">
  <header class="public-data-head">
    <div><span class="eyebrow">{en?'REFERENCE DATA':'DATA RUJUKAN'}</span><h2 id="public-data-title">{en?'Public data.':'Data publik.'}</h2></div>
    <p>{en?'A compact view of selected public records used across Watch. Sources, dates and scope stay attached to every measure.':'Ringkasan data publik terpilih yang digunakan di Watch. Sumber, tanggal, dan cakupan tetap melekat pada setiap ukuran.'}</p>
  </header>

  <div class="public-data-shell">
    <nav class="public-data-spine" aria-label={en?'Data views':'Tampilan data'}>
      {panels.map((panel,i)=><button type="button" data-data-view={panel.id} aria-pressed={i===0?'true':'false'}><small>{panel.index}</small><span>{en?panel.en:panel.idLabel}</span></button>)}
    </nav>

    <div class="public-data-stage" data-data-stage>
      <div class="public-data-stage-meta"><span data-data-kicker>{en?'People':'Penduduk'}</span><span data-data-position>01 / 06</span></div>

      <section class="public-data-panel is-active" data-data-panel="people" aria-label={en?'People data':'Data penduduk'}>
        <div class="data-panel-title"><div><small>BPS · 2024–2025</small><h3>{en?'Living conditions by province':'Kondisi hidup menurut provinsi'}</h3></div><div class="data-segmented" data-segmented="people"><button type="button" data-metric="hdi" aria-pressed="true">IPM</button><button type="button" data-metric="poverty" aria-pressed="false">{en?'Poverty':'Kemiskinan'}</button></div></div>
        <div class="province-comparison" data-people-chart>
          {hdi.rows.map((row)=><div class="province-comparison-row" data-hdi={row.current} data-poverty={povertyByProvince[row.province]??0}>
            <span>{row.province}</span><div class="comparison-track"><i style={`--value:${row.current}%`}></i></div><strong data-value>{nf(row.current,2)}</strong>
          </div>)}
        </div>
        <footer><span data-people-unit>{en?'Human Development Index · 0–100':'Indeks Pembangunan Manusia · 0–100'}</span><a href={hdi.sourceUrl} target="_blank" rel="noreferrer">BPS ↗</a></footer>
      </section>

      <section class="public-data-panel" data-data-panel="finance" hidden aria-label={en?'Public finance data':'Data keuangan publik'}>
        <div class="data-panel-title"><div><small>DJPK · 2024 / 2026</small><h3>{en?'Provincial public finance':'Keuangan publik provinsi'}</h3></div><div class="data-segmented" data-segmented="finance"><button type="button" data-metric="otsus" aria-pressed="true">Otsus</button><button type="button" data-metric="apbd" aria-pressed="false">APBD</button></div></div>
        <div class="finance-comparison" data-finance-chart>
          {otsusRows.map(row=><div class="finance-row" data-province={row.province} data-otsus-budget={row.budget} data-otsus-actual={row.actual} data-apbd-budget={apbdRows.find(x=>x.province===row.province)?.budget??0} data-apbd-actual={apbdRows.find(x=>x.province===row.province)?.actual??0}>
            <div><span>{row.province}</span><strong data-finance-value>{nf(row.actual/1000,2)} <small>/ {nf(row.budget/1000,2)}</small></strong></div>
            <div class="finance-track"><i class="finance-budget" style={`--budget:${row.budget/otsusMax*100}%`}></i><i class="finance-actual" style={`--actual:${row.actual/otsusMax*100}%`}></i></div>
          </div>)}
        </div>
        <footer><span data-finance-unit>{en?'Rp trillion · transferred / allocation':'Rp triliun · tersalurkan / pagu'}</span><a href={otsus.sourceUrl} target="_blank" rel="noreferrer">DJPK ↗</a></footer>
      </section>

      <section class="public-data-panel" data-data-panel="services" hidden aria-label={en?'Public services data':'Data layanan publik'}>
        <div class="data-panel-title"><div><small>MBG · {sppg.snapshot}</small><h3>{en?'Recorded nutrition-service units':'Unit layanan gizi yang tercatat'}</h3></div><strong class="data-big-number">{uniqueSppg.length}</strong></div>
        <div class="service-layout">
          <div class="service-provinces">{sppgByProvince.map(row=><div><span>{row.name}</span><strong>{row.count}</strong></div>)}</div>
          <aside><strong>0</strong><span>{en?'marked operational in this snapshot':'berstatus beroperasi dalam cuplikan ini'}</span><p>{en?'Records describe listed units and status fields, not confirmed meal delivery or complete present-day coverage.':'Catatan menunjukkan unit dan status yang tercantum, bukan konfirmasi penyaluran makanan atau cakupan terkini yang lengkap.'}</p></aside>
        </div>
        <footer><span>{en?'Dated third-party monitoring snapshot':'Cuplikan pemantauan pihak ketiga bertanggal'}</span><a href={sppg.source} target="_blank" rel="noreferrer">SismonBGN ↗</a></footer>
      </section>

      <section class="public-data-panel" data-data-panel="environment" hidden aria-label={en?'Environment data':'Data lingkungan'}>
        <div class="data-panel-title"><div><small>{en?'SELECTED OBSERVATIONS':'PENGAMATAN TERPILIH'}</small><h3>{en?'Forest & climate signals':'Sinyal hutan & iklim'}</h3></div></div>
        <div class="environment-grid">
          <div class="forest-mini">{forest.map(row=><div><div><span>{row.place}</span><strong>{int(row.value)} <small>ha</small></strong></div><i><b style={`width:${row.value/maxForest*100}%`}></b></i></div>)}</div>
          <article class="environment-stat"><small>{ice?.place} · {ice?.period}</small><strong>{ice?.value}%</strong><span>{en?'of 1988 tropical-ice area remaining':'dari luas es tropis tahun 1988 yang tersisa'}</span></article>
          <article class="environment-stat"><small>{hotspots?.place}</small><strong>{int(hotspots?.value||0)}</strong><span>{en?'high-confidence thermal detections':'deteksi panas berkeyakinan tinggi'}</span></article>
        </div>
        <footer><span>{en?'Each measure has a different scope; values are not additive.':'Setiap ukuran memiliki cakupan berbeda; nilainya tidak dapat dijumlahkan.'}</span><a href={withLocale('/data/',locale)}>{en?'Methods & downloads':'Metode & unduhan'} ↗</a></footer>
      </section>

      <section class="public-data-panel" data-data-panel="languages" hidden aria-label={en?'Language reference data':'Data rujukan bahasa'}>
        <div class="data-panel-title"><div><small>Glottolog 5.3</small><h3>{en?'Languages of Papua':'Bahasa-bahasa Papua'}</h3></div><a class="data-primary-link" href={withLocale('/?view=language&map=explore',locale)}>{en?'Explore in Atlas':'Jelajahi di Atlas'} ↗</a></div>
        <div class="language-data-mosaic">{languages.map((language,i)=><a href={`https://glottolog.org/resource/languoid/id/${language.glottocode}`} target="_blank" rel="noreferrer" style={`--i:${i}`}><small>{String(i+1).padStart(2,'0')}</small><strong>{language.name}</strong><span>{language.family} · {language.glottocode} ↗</span></a>)}</div>
        <footer><span>{en?'Selected records, not an exhaustive list or language-boundary map.':'Catatan terpilih, bukan daftar lengkap atau peta batas bahasa.'}</span><a href="https://glottolog.org/" target="_blank" rel="noreferrer">Glottolog ↗</a></footer>
      </section>

      <section class="public-data-panel" data-data-panel="law" hidden aria-label={en?'Legal reference data':'Data rujukan hukum'}>
        <div class="data-panel-title"><div><small>UU 2 / 2021</small><h3>{en?'Papua special autonomy':'Otonomi khusus Papua'}</h3></div></div>
        <div class="law-reference"><p>{en?'The 2021 law is the second amendment to the 2001 special-autonomy law and changes provisions concerning governance and special-autonomy funding.':'Undang-undang tahun 2021 merupakan perubahan kedua atas UU Otonomi Khusus tahun 2001 dan mengubah ketentuan mengenai pemerintahan serta pendanaan otonomi khusus.'}</p><dl><div><dt>{en?'Enacted':'Ditetapkan'}</dt><dd>19 July 2021</dd></div><div><dt>{en?'Amends':'Mengubah'}</dt><dd>UU 21/2001 · UU 35/2008</dd></div></dl></div>
        <footer><span>{en?'Official legal record':'Catatan hukum resmi'}</span><a href="https://peraturan.bpk.go.id/Details/172403/uu-no-2-tahun-2021" target="_blank" rel="noreferrer">JDIH BPK ↗</a></footer>
      </section>
    </div>
  </div>
  <noscript><p class="public-data-noscript"><a href={withLocale('/data/',locale)}>{en?'Open the full data reference':'Buka referensi data lengkap'} ↗</a></p></noscript>
</section>

<script>
const root=document.querySelector<HTMLElement>('[data-public-data]');
if(root){
 const reduce=matchMedia('(prefers-reduced-motion: reduce)');
 const buttons=[...root.querySelectorAll<HTMLButtonElement>('[data-data-view]')],panels=[...root.querySelectorAll<HTMLElement>('[data-data-panel]')];
 const kicker=root.querySelector<HTMLElement>('[data-data-kicker]'),position=root.querySelector<HTMLElement>('[data-data-position]');
 const activate=(id:string)=>{const next=panels.find(p=>p.dataset.dataPanel===id),current=panels.find(p=>!p.hidden);if(!next||next===current)return;const button=buttons.find(b=>b.dataset.dataView===id),index=Math.max(0,buttons.indexOf(button!));
   buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));if(kicker&&button)kicker.textContent=button.querySelector('span')?.textContent||'';if(position)position.textContent=`${String(index+1).padStart(2,'0')} / ${String(buttons.length).padStart(2,'0')}`;
   const show=()=>{if(current)current.hidden=true;next.hidden=false;next.classList.add('is-active');if(!reduce.matches)next.animate([{opacity:0,transform:'translateY(10px)'},{opacity:1,transform:'none'}],{duration:420,easing:'cubic-bezier(.2,.8,.2,1)'});};
   if(current&&!reduce.matches){const a=current.animate([{opacity:1,transform:'none'},{opacity:0,transform:'translateY(-6px)'}],{duration:180,easing:'ease-in'});a.finished.then(show).catch(show)}else show();
 };
 buttons.forEach(button=>button.addEventListener('click',()=>activate(button.dataset.dataView||'')));
 const peopleRows=[...root.querySelectorAll<HTMLElement>('[data-people-chart] .province-comparison-row')],peopleUnit=root.querySelector<HTMLElement>('[data-people-unit]');
 root.querySelectorAll<HTMLButtonElement>('[data-segmented="people"] button').forEach(button=>button.addEventListener('click',()=>{const mode=button.dataset.metric||'hdi';root.querySelectorAll<HTMLButtonElement>('[data-segmented="people"] button').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));peopleRows.forEach(row=>{const value=Number(mode==='poverty'?row.dataset.poverty:row.dataset.hdi)||0,max=mode==='poverty'?30:100;const bar=row.querySelector<HTMLElement>('.comparison-track i'),label=row.querySelector<HTMLElement>('[data-value]');if(bar)bar.style.setProperty('--value',`${value/max*100}%`);if(label)label.textContent=mode==='poverty'?`${value.toLocaleString(document.documentElement.lang==='id'?'id-ID':'en-GB',{minimumFractionDigits:2,maximumFractionDigits:2})}%`:value.toLocaleString(document.documentElement.lang==='id'?'id-ID':'en-GB',{minimumFractionDigits:2,maximumFractionDigits:2})});if(peopleUnit)peopleUnit.textContent=mode==='poverty'?(document.documentElement.lang==='id'?'Penduduk di bawah garis kemiskinan BPS · %':'Residents below the BPS poverty line · %'):(document.documentElement.lang==='id'?'Indeks Pembangunan Manusia · 0–100':'Human Development Index · 0–100')})}));
 const financeRows=[...root.querySelectorAll<HTMLElement>('[data-finance-chart] .finance-row')],financeUnit=root.querySelector<HTMLElement>('[data-finance-unit]');
 root.querySelectorAll<HTMLButtonElement>('[data-segmented="finance"] button').forEach(button=>button.addEventListener('click',()=>{const mode=button.dataset.metric||'otsus';root.querySelectorAll<HTMLButtonElement>('[data-segmented="finance"] button').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));const max=mode==='otsus'?Math.max(...financeRows.map(r=>Number(r.dataset.otsusBudget)||0)):Math.max(...financeRows.map(r=>Number(r.dataset.apbdBudget)||0));financeRows.forEach(row=>{const budget=Number(mode==='otsus'?row.dataset.otsusBudget:row.dataset.apbdBudget)||0,actual=Number(mode==='otsus'?row.dataset.otsusActual:row.dataset.apbdActual)||0;row.querySelector<HTMLElement>('.finance-budget')?.style.setProperty('--budget',`${budget/max*100}%`);row.querySelector<HTMLElement>('.finance-actual')?.style.setProperty('--actual',`${actual/max*100}%`);const label=row.querySelector<HTMLElement>('[data-finance-value]');if(label){const scale=mode==='otsus'?1000:1;label.innerHTML=`${(actual/scale).toLocaleString(document.documentElement.lang==='id'?'id-ID':'en-GB',{maximumFractionDigits:2})} <small>/ ${(budget/scale).toLocaleString(document.documentElement.lang==='id'?'id-ID':'en-GB',{maximumFractionDigits:2})}</small>`}});if(financeUnit)financeUnit.textContent=mode==='otsus'?(document.documentElement.lang==='id'?'Rp triliun · tersalurkan / pagu':'Rp trillion · transferred / allocation'):(document.documentElement.lang==='id'?'Rp triliun · realisasi / anggaran':'Rp trillion · expenditure / budget') }));
}
</script>

<style>
.public-data{scroll-margin-top:120px;margin-top:clamp(5rem,9vw,9rem)}.public-data-head{display:grid;grid-template-columns:1.1fr .9fr;gap:3rem;align-items:end;margin-bottom:2rem}.public-data-head h2{font-size:clamp(3rem,6vw,6.2rem);line-height:.9;letter-spacing:-.065em;margin:.7rem 0 0}.public-data-head>p{max-width:48ch;color:var(--muted);line-height:1.6;margin:0 0 .4rem}.public-data-shell{display:grid;grid-template-columns:minmax(165px,.28fr) minmax(0,1fr);gap:clamp(1rem,2.7vw,2.6rem);align-items:start}.public-data-spine{position:sticky;top:calc(var(--compact-nav-actual-height,72px) + 20px);display:grid;border-top:1px solid var(--line)}.public-data-spine button{appearance:none;background:transparent;color:var(--muted);border:0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:32px 1fr;gap:.55rem;text-align:left;padding:1rem 0;font:inherit;cursor:pointer;transition:color .2s,transform .2s}.public-data-spine button small{font-size:.62rem;letter-spacing:.1em;color:var(--muted-2)}.public-data-spine button span{font-size:.92rem}.public-data-spine button[aria-pressed=true]{color:var(--ink);transform:translateX(4px)}.public-data-stage{--field-a:#242b3a;--field-b:#1a202b;position:relative;min-height:620px;border:1px solid #ffffff18;border-radius:28px;overflow:hidden;padding:clamp(1.25rem,3vw,2.8rem);background:radial-gradient(ellipse at 92% 8%,#a794c62b,transparent 45%),radial-gradient(ellipse at 12% 88%,#7daea222,transparent 48%),linear-gradient(145deg,var(--field-a),var(--field-b));box-shadow:0 28px 80px #0002;isolation:isolate}.public-data-stage:before{content:'';position:absolute;z-index:-1;width:70%;aspect-ratio:1;border:1px solid #ffffff12;border-radius:50%;right:-25%;top:-35%;box-shadow:0 0 0 70px #ffffff04,0 0 0 140px #ffffff025}.public-data-stage-meta{display:flex;justify-content:space-between;gap:1rem;border-bottom:1px solid #ffffff16;padding-bottom:1rem;font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;color:#b7b5c2}.public-data-
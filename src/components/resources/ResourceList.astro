---
import {libraryGroup,LIBRARY_GROUPS,libraryVisualTone} from '../../../shared/library';
import type {LibraryItem} from '../../../shared/library';
import '../../styles/library-list.css';
const {items,locale='en',topic}=Astro.props as {items:LibraryItem[];locale?:string;topic?:string};
const label=(type:any)=>LIBRARY_GROUPS.find(g=>g[0]===libraryGroup(type))?.[locale==='pmy'?2:1]||type;
---
<div class="resource-table library-list" data-resource-table data-locale={locale} data-library-topic={topic||''}>{items.map(r=><a class="resource-row library-entry" data-resource-row data-resource-id={r.id} data-resource-type={libraryGroup(r.itemType)} data-resource-format={r.format} data-resource-broad={r.topics.join(' ')} data-resource-following={r.following.join(' ')} data-resource-places={JSON.stringify(r.places)} data-resource-languages={r.languages.join(' ')} data-resource-search={[r.title,r.publisher,...r.authors,r.description,r.abstract,r.doi,r.isbn,...r.tags].join(' ').toLowerCase()} href={r.url} target="_blank" rel="noreferrer">
 <span class:list={['library-media',`tone-${libraryVisualTone(r)}`]} aria-hidden="true">{r.visual&&<img src={r.visual.url} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" title={r.visual.credit}/>}</span>
 <div class="library-entry-body"><small class="library-entry-meta">{label(r.itemType)} · {r.year}{r.languages.length>0&&` · ${r.languages.join(' / ').toUpperCase()}`}</small><h2>{r.title}</h2><p class="library-byline">{r.authors.length?r.authors.join(', '):r.publisher}</p>{r.authors.length>0&&<p class="library-publisher">{r.publisher}</p>}{r.description&&<p class="library-description">{r.description}</p>}</div><span class="library-open" aria-hidden="true">↗</span>
</a>)}</div>
<script>
import {normalizeLibraryItem,libraryGroup,LIBRARY_GROUPS,canonicalItemUrl,libraryVisualTone} from '../../../shared/library';
import {followingSlugs} from '../../data/topic-collections';
import {fetchJSON} from '../../lib/http';
document.querySelectorAll<HTMLElement>('[data-resource-table]').forEach(table=>{
 const topic=table.dataset.libraryTopic||'',locale=table.dataset.locale;
 const bindImages=()=>table.querySelectorAll<HTMLImageElement>('.library-media img').forEach(img=>{img.addEventListener('error',()=>img.remove(),{once:true});if(img.complete&&!img.naturalWidth)img.remove()});bindImages();
 fetchJSON('/api/resources'+(topic?'?topic='+encodeURIComponent(topic):'')).then(data=>{
 const existing=new Map([...table.querySelectorAll<HTMLAnchorElement>('a.resource-row')].map(x=>[x.dataset.resourceId||canonicalItemUrl(x.href),x]));
 for(const raw of data?.items||[]){const item=normalizeLibraryItem(raw);if(topic&&!item.topics.includes(topic))continue;try{if(!['http:','https:'].includes(new URL(item.url).protocol))continue}catch{continue}
 const row=document.createElement('a');row.className='resource-row library-entry';row.dataset.resourceRow='';row.dataset.resourceId=item.id;row.dataset.resourceType=libraryGroup(item.itemType);row.dataset.resourceFormat=item.format;row.dataset.resourceBroad=item.topics.join(' ');row.dataset.resourceFollowing=[...new Set([...item.following,...item.topics.filter(t=>(followingSlugs as readonly string[]).includes(t))])].join(' ');row.dataset.resourceLanguages=item.languages.join(' ');row.dataset.resourcePlaces=JSON.stringify(item.places);row.dataset.resourceSearch=[item.title,item.publisher,...item.authors,item.description,item.abstract,item.doi,item.isbn,...item.tags].join(' ').toLowerCase();row.href=item.url;row.target='_blank';row.rel='noreferrer';
 const media=document.createElement('span');media.className='library-media tone-'+libraryVisualTone(item);media.setAttribute('aria-hidden','true');if(item.visual){const img=document.createElement('img');img.src=item.visual.url;img.alt='';img.loading='lazy';img.decoding='async';img.referrerPolicy='no-referrer';img.title=item.visual.credit;media.append(img)}
 const main=document.createElement('div');main.className='library-entry-body';const meta=document.createElement('small');meta.className='library-entry-meta';meta.textContent=[LIBRARY_GROUPS.find(g=>g[0]===libraryGroup(item.itemType))?.[locale==='pmy'?2:1]||item.itemType,item.year,item.languages.join(' / ').toUpperCase()].filter(Boolean).join(' · ');const title=document.createElement('h2');title.textContent=item.title;const publisher=document.createElement('p');publisher.className='library-byline';publisher.textContent=item.authors.length?item.authors.join(', '):item.publisher;main.append(meta,title,publisher);if(item.authors.length){const p=document.createElement('p');p.className='library-publisher';p.textContent=item.publisher;main.append(p)}if(item.description){const p=document.createElement('p');p.className='library-description';p.textContent=item.description;main.append(p)}const arrow=document.createElement('span');arrow.className='library-open';arrow.setAttribute('aria-hidden','true');arrow.textContent='↗';row.append(media,main,arrow);const previous=existing.get(item.id);if(previous)previous.replaceWith(row);else table.append(row);existing.set(item.id,row);
 }
 bindImages();document.dispatchEvent(new Event('watch:library-loaded'));
 }).catch(()=>{table.dataset.liveUnavailable='true';document.dispatchEvent(new Event('watch:library-loaded'))});
});
</script>

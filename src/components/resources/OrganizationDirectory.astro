---
import {organizations,organizationIdsFor} from '../../../shared/organizations';
import {libraryItems} from '../../data/library';
import {withLocale} from '../../lib/i18n';
const {locale='en'}=Astro.props;const en=locale==='en';
const categories=[['reporting','News & reporting','Berita & jurnalisme','150'],['community','Community & advocacy','Komunitas & advokasi','270'],['research','Research & archives','Riset & arsip','205'],['culture','Arts & culture','Seni & budaya','30']];
const counts=Object.fromEntries(organizations.map(o=>[o.id,libraryItems.filter(r=>organizationIdsFor(r).includes(o.id)).length]));
---
<section id="sites" class="organizations" aria-labelledby="organizations-title">
 <div class="section-head"><h2 id="organizations-title">{en?'Sites & organizations.':'Situs & organisasi.'}</h2><span class="directory-total">{organizations.length} {en?'sites':'situs'}</span></div>
 <input class="resource-search" type="search" placeholder={en?'Find a site or organization':'Cari situs atau organisasi'} aria-label={en?'Find a site or organization':'Cari situs atau organisasi'} data-organization-search/>
 <div class="directory-sections">{categories.map(([id,label,labelId,hue],i)=>{
 const entries=organizations.filter(o=>(o.category||'community')===id);
 return <details class="directory-section" style={`--tile-hue:${hue}`} data-directory-section>
  <summary><span class="directory-number">0{i+1}</span><span class="directory-label">{en?label:labelId}</span><span class="directory-size">{entries.length}</span><span class="directory-plus" aria-hidden="true">+</span></summary>
  <div class="directory-entries">{entries.map(o=><article class="organization-entry" data-organization-text={`${o.name} ${o.role} ${o.description}`.toLowerCase()}>
   <h3><a href={o.url} target="_blank" rel="noreferrer">{o.name} <span aria-hidden="true">↗</span></a></h3><small class="organization-role">{o.role}</small><p>{o.description}</p>
   <a class="organization-count" hidden={!counts[o.id]} data-organization-count={o.id} data-count-locale={locale} href={`${withLocale('/resources/',locale)}?organization=${o.id}#catalogue`}>{counts[o.id]} {en?'items in Library':'item di Pustaka'} →</a>
  </article>)}</div>
 </details>})}</div>
 <p class="directory-empty" data-directory-empty hidden role="status">{en?'No matching sites. Try another name or subject.':'Tidak ada situs yang cocok. Coba nama atau topik lain.'}</p>
</section>
<script>
const directory=document.querySelector<HTMLElement>('#sites');
if(directory){
 const search=directory.querySelector<HTMLInputElement>('[data-organization-search]')!;
 const sections=[...directory.querySelectorAll<HTMLDetailsElement>('[data-directory-section]')];
 let savedOpen:boolean[]|null=null;
 search.addEventListener('input',()=>{
  const q=search.value.trim().toLowerCase();let total=0;
  if(q&&!savedOpen)savedOpen=sections.map(s=>s.open);
  sections.forEach((section,i)=>{
   let count=0;section.querySelectorAll<HTMLElement>('[data-organization-text]').forEach(row=>{row.hidden=!row.dataset.organizationText?.includes(q);if(!row.hidden)count++});
   section.hidden=!count;total+=count;
   if(q)section.open=!!count;else if(savedOpen)section.open=savedOpen[i];
  });
  if(!q)savedOpen=null;
  (directory.querySelector('[data-directory-empty]') as HTMLElement).hidden=total>0;
 });
 // Keep browsing compact; search may intentionally open more than one category.
 sections.forEach(section=>section.addEventListener('toggle',()=>{if(section.open&&!search.value.trim())sections.forEach(other=>{if(other!==section)other.open=false})}));
}
document.addEventListener('watch:library-loaded',()=>{const rows=[...document.querySelectorAll<HTMLElement>('[data-resource-row]')];if(!rows.length)return;document.querySelectorAll<HTMLElement>('[data-organization-count]').forEach(link=>{const count=rows.filter(row=>row.dataset.resourceOrganizations?.split(' ').includes(link.dataset.organizationCount!)).length;link.hidden=!count;link.textContent=`${count} ${link.dataset.countLocale==='en'?'items in Library':'item di Pustaka'} →`})});
</script>
<style is:global>
.organizations{margin:3rem 0 5rem;scroll-margin-top:110px}
.directory-total{color:#a4a1af;font-size:.8rem;white-space:nowrap}
.organizations>.resource-search{width:min(100%,460px);margin:0 0 22px}
.directory-sections{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;align-items:start}
.directory-section{min-width:0;border:1px solid #ffffff14;border-radius:18px;overflow:hidden;background:#11141c}
.directory-section[open]{grid-column:1/-1}
.directory-section summary{position:relative;isolation:isolate;overflow:hidden;display:grid;grid-template-columns:auto 1fr auto auto;align-items:center;gap:18px;min-height:116px;padding:24px;cursor:pointer;list-style:none;background:radial-gradient(ellipse at 100% 0,hsl(var(--tile-hue) 24% 34%),transparent 100%),#181b24}
.directory-section summary::-webkit-details-marker{display:none}
.directory-section summary::before{content:'';position:absolute;z-index:-1;width:330px;height:330px;right:-70px;top:-180px;border:1px solid #ffffff0e;border-radius:50%;box-shadow:0 0 0 28px #ffffff03,0 0 0 56px #ffffff03,0 0 0 84px #ffffff03;pointer-events:none}
.directory-number,.directory-size{font-size:.75rem;color:#d1ccd9;font-variant-numeric:tabular-nums}
.directory-label{font-size:clamp(1.15rem,2vw,1.65rem);font-weight:650;letter-spacing:-.035em;line-height:1.15}
.directory-plus{font-size:1.6rem;font-weight:300;transition:transform .2s}
.directory-section[open] .directory-plus{transform:rotate(45deg)}
.directory-entries{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 32px;padding:8px 26px 20px}
.organization-entry{min-width:0;padding:24px 0;border-bottom:1px solid #ffffff12}
.organization-entry h3{font-size:1.3rem;letter-spacing:-.035em;line-height:1.25;margin:0 0 8px;overflow-wrap:anywhere}
.organization-entry h3 a{display:flex;justify-content:space-between;gap:12px}
.organization-entry h3 span{color:#aca5bf;flex-shrink:0;font-weight:400}
.organization-role{display:block;font-size:.72rem;color:#b6adc5;line-height:1.5}
.organization-entry p{color:#aaa8b4;font-size:.88rem;line-height:1.55;margin:12px 0;max-width:55ch}
.organization-count{display:inline-block;font-size:.76rem;color:#ddd5ee;padding:8px 0}
.directory-section summary:focus-visible,.organization-entry a:focus-visible{outline:2px solid #d3c4ef;outline-offset:-3px}
.directory-empty{color:#b7b1c3}
.organization-entry[hidden],.organization-count[hidden],.directory-section[hidden],.directory-empty[hidden]{display:none!important}
@media(max-width:650px){.directory-sections{grid-template-columns:1fr;gap:10px}.directory-section summary{min-height:92px;padding:20px;gap:14px}.directory-label{font-size:1.25rem}.directory-entries{grid-template-columns:1fr;padding-inline:20px}.organizations{margin-bottom:3rem}.directory-total{display:none}}
@media(prefers-reduced-motion:reduce){.directory-plus{transition:none}}
</style>

---
import {organizations,organizationIdsFor} from '../../../shared/organizations';
import {libraryItems} from '../../data/library';
import {withLocale} from '../../lib/i18n';
const {locale='en',expanded=false}=Astro.props;
const category=(o:any)=>o.category||'community';
const categories=[['all','All','Semua'],['reporting','Reporting','Jurnalisme'],['community','Community & advocacy','Komunitas & advokasi'],['research','Research & archives','Riset & arsip'],['culture','Arts & culture','Seni & budaya']];
const counts=Object.fromEntries(organizations.map(o=>[o.id,libraryItems.filter(r=>organizationIdsFor(r).includes(o.id)).length]));
---
<section id="sites" class="organizations" aria-labelledby="organizations-title"><div class="section-head"><h2 id="organizations-title">{locale==='en'?'Sites & organizations.':'Situs & organisasi.'}</h2>{!expanded&&<a href={withLocale('/organizations/',locale)}>{locale==='en'?'Browse all':'Lihat semua'} ↗</a>}</div>
{expanded&&<input class="resource-search" type="search" placeholder={locale==='en'?'Find an organization':'Cari organisasi'} aria-label={locale==='en'?'Find an organization':'Cari organisasi'} data-organization-search/>}
<div class="organization-categories" role="group" aria-label="Category">{categories.map(([id,en,idLabel])=><button class="chip" data-organization-category={id} aria-pressed={id==='all'}>{locale==='en'?en:idLabel}</button>)}</div><div class="organization-grid">{(expanded?organizations:organizations.slice(0,6)).map((o,i)=><article class="organization-tile" style={`--tile-hue:${[150,210,270,30,185,330][i%6]}`} data-directory-category={category(o)} data-organization-text={`${o.name} ${o.role} ${o.description}`.toLowerCase()}><div class="eyebrow">{o.role}</div><h3><a href={o.url} target="_blank" rel="noreferrer">{o.name} ↗</a></h3><p>{o.description}</p><a class="organization-count" hidden={!counts[o.id]} data-organization-count={o.id} data-count-locale={locale} href={`${withLocale('/resources/',locale)}?organization=${o.id}#catalogue`}>{counts[o.id]?`${counts[o.id]} ${locale==='en'?'resources in Watch':'sumber di Watch'} →`:locale==='en'?'Explore in Watch →':'Jelajahi di Watch →'}</a></article>)}</div></section>
<script>
const search=document.querySelector<HTMLInputElement>('[data-organization-search]');let active='all';const apply=()=>{const q=search?.value.trim().toLowerCase()||'';document.querySelectorAll<HTMLElement>('[data-organization-text]').forEach(tile=>tile.hidden=!(tile.dataset.organizationText?.includes(q)&&(active==='all'||tile.dataset.directoryCategory===active)));document.querySelectorAll<HTMLElement>('[data-organization-category]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.organizationCategory===active)))};search?.addEventListener('input',apply);document.querySelectorAll<HTMLElement>('[data-organization-category]').forEach(button=>button.addEventListener('click',()=>{active=button.dataset.organizationCategory||'all';apply()}));
document.addEventListener('watch:library-loaded',()=>{const rows=[...document.querySelectorAll<HTMLElement>('[data-resource-row]')];if(!rows.length)return;document.querySelectorAll<HTMLElement>('[data-organization-count]').forEach(link=>{const count=rows.filter(row=>row.dataset.resourceOrganizations?.split(' ').includes(link.dataset.organizationCount!)).length;link.hidden=!count;link.textContent=count?`${count} ${link.dataset.countLocale==='en'?'items in Library':'item di Pustaka'} →`:link.dataset.countLocale==='en'?'Explore in Library →':'Jelajahi Pustaka →'})});
</script>
<style is:global>.organizations{margin:3rem 0}.organization-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:1.5rem}.organization-tile{display:flex;flex-direction:column;min-height:230px;padding:26px;border-radius:18px;background:radial-gradient(ellipse at 100% 0,hsl(var(--tile-hue) 20% 35% / .8),transparent 75%),#14171e;border:1px solid #ffffff12}.organization-tile h3{font-size:1.5rem;line-height:1.1;margin:24px 0 14px}.organization-tile p{font-size:.9rem;color:#cbcbd2;line-height:1.5}.organization-count{margin-top:auto;padding-top:26px;font-size:.8rem}.organization-tile[hidden],.organization-count[hidden]{display:none!important}@media(max-width:760px){.organization-grid{grid-template-columns:1fr 1fr}.organization-tile{padding:20px;min-height:250px}}@media(max-width:460px){.organization-grid{grid-template-columns:1fr}.organization-tile{min-height:190px}}</style>

<style is:global>
.organizations{scroll-margin-top:140px}.organization-categories{display:flex;flex-wrap:wrap;gap:.5rem;margin:1.2rem 0}.organization-categories [aria-pressed=true]{background:#e9e4f5;color:#181620}.organization-grid{grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}.organization-tile{grid-column:span 2;position:relative;overflow:hidden;isolation:isolate;min-height:240px;background:radial-gradient(ellipse at 100% 0,hsl(var(--tile-hue) 24% 40% / .9),transparent 90%),#161b24}.organization-tile:nth-child(7n+1),.organization-tile:nth-child(7n+2){grid-column:span 3;min-height:280px}.organization-tile::before,.organization-tile::after{content:'';position:absolute;z-index:-1;pointer-events:none;inset:-25% -15% 10% 20%;border:1px solid #ffffff0c;border-radius:48%;transform:rotate(-25deg);box-shadow:0 0 0 30px #ffffff03,0 0 0 60px #ffffff03,0 0 0 90px #ffffff03}.organization-tile::after{inset:0;background:linear-gradient(0deg,#090c1466,transparent);border:0;box-shadow:none;border-radius:0}.organization-tile h3{font-size:clamp(1.5rem,2.5vw,2.4rem);letter-spacing:-.045em;max-width:90%}.organization-tile:focus-within{outline:2px solid #e4dbff;outline-offset:3px}.organization-tile p{max-width:44ch}.organization-tile .eyebrow{color:#d1d1db}.organization-tile[hidden],.organization-count[hidden]{display:none!important}@media(max-width:650px){.organization-grid{grid-template-columns:1fr 1fr}.organization-tile,.organization-tile:nth-child(7n+1),.organization-tile:nth-child(7n+2){grid-column:auto;min-height:230px;padding:22px}.organization-tile:first-child{grid-column:1/-1}.organization-tile h3{font-size:1.55rem}}@media(max-width:380px){.organization-grid{grid-template-columns:1fr}.organization-tile{min-height:180px}}
</style>
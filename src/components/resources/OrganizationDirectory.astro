---
import {organizations,organizationIdsFor} from '../../../shared/organizations';
import {libraryItems} from '../../data/library';
import {withLocale} from '../../lib/i18n';
const {locale='en',expanded=false}=Astro.props;
const counts=Object.fromEntries(organizations.map(o=>[o.id,libraryItems.filter(r=>organizationIdsFor(r).includes(o.id)).length]));
---
<section class="organizations" aria-labelledby="organizations-title"><div class="section-head"><h2 id="organizations-title">{locale==='en'?'Organizations & collections.':'Organisasi & koleksi.'}</h2>{!expanded&&<a href={withLocale('/organizations/',locale)}>{locale==='en'?'Browse all':'Lihat semua'} ↗</a>}</div>
{expanded&&<input class="resource-search" type="search" placeholder={locale==='en'?'Find an organization':'Cari organisasi'} aria-label={locale==='en'?'Find an organization':'Cari organisasi'} data-organization-search/>}
<div class="organization-grid">{(expanded?organizations:organizations.slice(0,6)).map((o,i)=><article class="organization-tile" style={`--tile-hue:${[150,210,270,30,185,330][i%6]}`} data-organization-text={`${o.name} ${o.role} ${o.description}`.toLowerCase()}><div class="eyebrow">{o.role}</div><h3><a href={o.url} target="_blank" rel="noreferrer">{o.name} ↗</a></h3><p>{o.description}</p><a class="organization-count" data-organization-count={o.id} data-count-locale={locale} href={`${withLocale('/resources/',locale)}?organization=${o.id}#catalogue`}>{counts[o.id]?`${counts[o.id]} ${locale==='en'?'resources in Watch':'sumber di Watch'} →`:locale==='en'?'Explore in Watch →':'Jelajahi di Watch →'}</a></article>)}</div></section>
<script>document.querySelector<HTMLInputElement>('[data-organization-search]')?.addEventListener('input',e=>{const q=(e.target as HTMLInputElement).value.toLowerCase();document.querySelectorAll<HTMLElement>('[data-organization-text]').forEach(el=>el.hidden=!el.dataset.organizationText?.includes(q))});
const refreshOrganizationCounts=()=>{const rows=[...document.querySelectorAll<HTMLElement>('[data-resource-row]')];if(!rows.length)return;document.querySelectorAll<HTMLElement>('[data-organization-count]').forEach(link=>{const count=rows.filter(row=>row.dataset.resourceOrganizations?.split(' ').includes(link.dataset.organizationCount!)).length;const en=link.dataset.countLocale==='en';link.textContent=count?`${count} ${en?'resources in Watch':'sumber di Watch'} →`:en?'Explore in Watch →':'Jelajahi di Watch →'})};document.addEventListener('watch:library-loaded',refreshOrganizationCounts);
</script>
<style is:global>.organizations{margin:3rem 0}.organization-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:1.5rem}.organization-tile{display:flex;flex-direction:column;min-height:230px;padding:26px;border-radius:18px;background:radial-gradient(ellipse at 100% 0,hsl(var(--tile-hue) 20% 35% / .8),transparent 75%),#14171e;border:1px solid #ffffff12}.organization-tile h3{font-size:1.5rem;line-height:1.1;margin:24px 0 14px}.organization-tile p{font-size:.9rem;color:#cbcbd2;line-height:1.5}.organization-count{margin-top:auto;padding-top:26px;font-size:.8rem}.organization-tile[hidden]{display:none}@media(max-width:760px){.organization-grid{grid-template-columns:1fr 1fr}.organization-tile{padding:20px;min-height:250px}}@media(max-width:460px){.organization-grid{grid-template-columns:1fr}.organization-tile{min-height:190px}}</style>

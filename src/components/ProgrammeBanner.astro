---
import '../styles/polish-01.css';
import '../styles/polish-02.css';
import '../styles/polish-03.css';
import { BANNER } from '../data/site';
import { t, withLocale } from '../lib/i18n';
import type { Locale } from '../data/types';
const { locale='en' } = Astro.props as { locale?: Locale };
---
<a class="programme-banner" href={withLocale(BANNER.href, locale)}>
  <div class="programme-inner">
    <span class="programme-main">{t(BANNER.kicker, locale)}</span>
    <span class="programme-detail">{t(BANNER.title, locale)}</span>
    <span class="programme-count">{locale==='en'?'Follow issue':'Ikuti isu'}</span>
    <span class="programme-arrow" aria-hidden="true">→</span>
  </div>
</a>

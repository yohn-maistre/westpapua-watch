---
import {CONFLICT_PERIODS} from '../../lib/map/conflict';
import 'maplibre-gl/dist/maplibre-gl.css';
import '../../styles/map.css';
import {MAP_BASES,MAP_FAMILIES,MAP_LAYERS,MAP_VIEWS} from '../../lib/map/registry';
import type {MapViewId} from '../../lib/map/registry';
import type {Locale} from '../../data/types';
const {
  locale='en',mode='home',title='',eyebrow='',context='',contextValue='',initialView='current'
}=Astro.props as {
  locale?:Locale;mode?:'home'|'context';title?:string;eyebrow?:string;
  context?:'issue'|'development'|'';contextValue?:string;initialView?:MapViewId;
};
const labels=locale==='pmy'
  ?{base:'Dasar',layers:'Lapisan',expand:'Perlebar',close:'Tutup',return:'Kembali ke tampilan halaman',search:'Cari tempat',source:'Sumber',view:'Tampilan'}
  :{base:'Base',layers:'Layers',expand:'Expand',close:'Close',return:'Return to page view',search:'Search places',source:'Source',view:'View'};
const labelFor=(layer:any)=>locale==='pmy'?layer.titleId:layer.title;
const noteFor=(layer:any)=>locale==='pmy'?(layer.coverageNotesId||layer.descriptionId||layer.coverage):(layer.coverageNotes||layer.description||layer.coverage);
const familyFor=(family:any)=>locale==='pmy'?family.titleId:family.title;
const viewFor=(view:any)=>locale==='pmy'?view.titleId:view.title;
const baseFor=(base:any)=>locale==='pmy'?base.titleId:base.title;
---
<section class:list={['watch-map',mode==='context'&&'watch-map-context']} data-watch-map data-map-mode={mode} data-locale={locale} data-context={context} data-context-value={contextValue} data-initial-view={initialView} data-explore="false" aria-label={locale==='pmy'?'Peta Papua Barat':'West Papua map'}>
  <div class="watch-map-frame">
    <div class="watch-map-canvas" data-map-canvas></div>
    <div class="watch-map-fallback" data-map-fallback hidden>
      <div>
        <strong>{locale==='pmy'?'Peta tidak tersedia.':'Map unavailable.'}</strong>
        <p>{locale==='pmy'?'Isu, berita, dan sumber data tetap tersedia.':'Browse issues, news and dataset sources below.'}</p>
        <nav><a href={locale==='pmy'?'/id/topics/':'/topics/'}>{locale==='pmy'?'Isu':'Issues'}</a><a href={locale==='pmy'?'/id/news/':'/news/'}>{locale==='pmy'?'Berita':'News'}</a></nav>
      </div>
    </div>

    <div class="watch-map-state" data-map-state></div>

    <div class="watch-map-basebar" aria-label={labels.base}>
      <span>{labels.base}</span>
      <div>{MAP_BASES.map(base=><button type="button" data-map-base={base.id}>{baseFor(base)}</button>)}</div>
    </div>

    <details class="watch-map-viewbar" data-map-presets>
      <summary><span data-map-preset-label>{viewFor(MAP_VIEWS.find(v=>v.id===initialView)||MAP_VIEWS[0])}</span><span aria-hidden="true"> ↑</span></summary>
      <div>{MAP_VIEWS.map(view=><button type="button" data-map-view={view.id}>{viewFor(view)}</button>)}</div>
    </details>

    <div class="watch-map-time" data-map-time hidden>
      <label><span>{locale==='pmy'?'Periode laporan':'Reporting period'}</span><output data-map-period-label></output><input type="range" min="0" max={CONFLICT_PERIODS.length-1} step="1" value="2" data-map-period aria-label={locale==='pmy'?'Periode laporan konflik':'Conflict reporting period'}/></label>
      <div class="watch-map-time-key"><span class="conflict-dot">{locale==='pmy'?'Konflik':'Conflict'}</span><span class="displacement-dot">{locale==='pmy'?'Pengungsian':'Displacement'}</span><span class="deployment-dot">{locale==='pmy'?'Militer':'Military'}</span></div>
      <details><summary>{locale==='pmy'?'Laporan dalam periode ini':'Reports in this period'} <span data-map-period-count></span></summary><div data-map-period-list></div><p>{locale==='pmy'?'Titik referensi wilayah. Cakupan terbatas; bukan peta posisi langsung.':'Regional reference points. Partial coverage; not live positions.'}</p></details>
    </div>
    <div class="watch-map-controls" aria-label="Map controls">
      <button type="button" data-map-layers-open aria-expanded="false" aria-label={labels.layers} title={labels.layers}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 8 9-5 9 5-9 5-9-5Zm0 4 9 5 9-5M3 16l9 5 9-5"/></svg><span>{labels.layers}</span></button>
      <button type="button" data-map-expand aria-label={labels.expand} title={labels.expand}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg><span>{labels.expand}</span></button>
      <button type="button" data-map-close-expanded hidden aria-label={labels.close} title={labels.close}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg><span>{labels.close}</span></button>
    </div>

    <button class="watch-map-panel-backdrop" type="button" data-map-panel-backdrop hidden aria-label={labels.close}></button>
    <aside class="watch-map-layer-panel" data-map-layers-panel tabindex="-1" hidden aria-label={labels.layers}>
      <header><strong>{labels.layers}</strong><button type="button" data-map-layers-close aria-label={labels.close}>×</button></header>
      <label class="watch-map-search"><span>{labels.search}</span><input data-map-place-search type="search" autocomplete="off" /></label>
      <div class="watch-map-place-results" data-map-place-results></div>
      {MAP_FAMILIES.map(f=><section><h3>{familyFor(f)}</h3>{MAP_LAYERS.filter(x=>x.family===f.id).map(layer=><button type="button" data-map-layer={layer.id}><span><strong>{labelFor(layer)}</strong><small>{noteFor(layer)}</small></span><i></i></button>)}</section>)}
      <button class="watch-map-return" type="button" data-map-return>{labels.return}</button>
    </aside>

    <aside class="watch-map-feature" data-map-feature hidden>
      <button type="button" data-map-feature-close aria-label={labels.close}>×</button>
      <small data-map-feature-kicker></small><h3 data-map-feature-title></h3>
      <div data-map-feature-rows></div>
      <a data-map-feature-related hidden></a>
      <a data-map-feature-profile hidden></a>
      <a data-map-feature-source target="_blank" rel="noreferrer"></a>
    </aside>

    <div class="watch-map-debug" data-map-debug hidden></div>
    <div class="watch-map-credit"><span data-map-credit>BIG · Bappenas · ESDM · NASA FIRMS · {labels.source}: layer metadata</span></div>
  </div>
  <details class="map-datasets"><summary>{locale==='pmy'?'Sumber & keterangan peta':'Map sources & notes'}</summary>
    <nav class="map-climate-links" aria-label={locale==='pmy'?'Konteks iklim':'Climate context'}><a href="https://www.cpc.ncep.noaa.gov/products/analysis_monitoring/enso_advisory/ensodisc.shtml" target="_blank" rel="noreferrer">NOAA · El Niño / La Niña ↗</a><a href="https://worldview.earthdata.nasa.gov/" target="_blank" rel="noreferrer">NASA · {locale==='pmy'?'Citra harian':'Daily imagery'} ↗</a><a href="https://coralreefwatch.noaa.gov/product/5km/" target="_blank" rel="noreferrer">NOAA · {locale==='pmy'?'Stres panas karang':'Coral heat stress'} ↗</a></nav>
    <div class="map-dataset-grid">{MAP_LAYERS.map(layer=><article data-map-dataset={layer.id}><strong>{labelFor(layer)}</strong><p>{noteFor(layer)}</p><small data-map-dataset-status>{locale==='pmy'?'Periode: lihat sumber':'Period: see source'}</small><a href={layer.sourceUrl} target="_blank" rel="noreferrer">{layer.attribution} ↗</a></article>)}</div>
  </details>
</section>
<script>
  import {initWatchMaps} from '../../lib/map/runtime';
  initWatchMaps();
</script>

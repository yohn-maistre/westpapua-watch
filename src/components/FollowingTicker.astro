---
import '../styles/following.css';
import cases from '../../content/following.json';
import {followingEntries} from '../../shared/following-state';
const entries=followingEntries(cases);
import {withLocale} from '../lib/i18n';
const {locale='en'}=Astro.props;const en=locale==='en';
const names:Record<string,[string,string]>={'south-papua-food-energy-estate':['South Papua','Papua Selatan'],'papuan-civic-space':['Civic space','Ruang sipil'],'nduga-displacement':['Nduga','Nduga'],'mining-raja-ampat':['Raja Ampat','Raja Ampat'],'kiwirok-conflict':['Kiwirok','Kiwirok'],'freeport-mimika':['Mimika','Mimika'],'puncak-displacement':['Puncak','Puncak'],'intan-jaya-displacement':['Intan Jaya','Intan Jaya'],'awyu-customary-forests':['Awyu','Awyu']};
---
<aside class="following-ticker" data-following-ticker data-locale={locale} aria-label={en?'Following updates':'Kabar dalam pantauan'}>
 <div class="following-wash" aria-hidden="true"><i></i><i></i><i></i></div>
 <div class="following-introduction" data-following-intro hidden aria-hidden="true"><i></i><i></i><i></i><span>{en?'Following':'Pantauan'}</span></div>
 <div class="following-ticker-inner" data-following-viewport tabindex="0" aria-label={en?'Issues we follow. Focus to pause.':'Isu pantauan. Fokus untuk menjeda.'}>
  <div class="following-track" data-following-track><div class="following-segment">{entries.map(c=><a class="following-update" href={withLocale(c.update.href,locale)}><span>{names[c.slug]?.[en?0:1]||c.title[locale]}</span><i class="following-topic-rule" aria-hidden="true"></i><strong>{c.update.title[locale]}</strong><time datetime={c.update.date}>{new Date(c.update.date).toLocaleDateString(en?'en-GB':'id-ID',{day:'numeric',month:'short',year:'numeric',timeZone:'Asia/Jayapura'})}</time><b aria-hidden="true">✦</b></a>)}</div></div>
 </div>
<script type="application/json" data-following-seeds set:html={JSON.stringify(entries).replace(/</g,'\\u003c')}></script>
</aside>
<script>
import {fetchJSON} from '../lib/http';
const root=document.querySelector<HTMLElement>('[data-following-ticker]');
if(root){
 const en=root.dataset.locale!=='pmy',reduce=matchMedia('(prefers-reduced-motion: reduce)'),viewport=root.querySelector<HTMLElement>('[data-following-viewport]')!,track=root.querySelector<HTMLElement>('[data-following-track]')!;
  const shortNames:Record<string,[string,string]>={'south-papua-food-energy-estate':['South Papua','Papua Selatan'],'papuan-civic-space':['Civic space','Ruang sipil'],'nduga-displacement':['Nduga','Nduga'],'mining-raja-ampat':['Raja Ampat','Raja Ampat'],'kiwirok-conflict':['Kiwirok','Kiwirok'],'freeport-mimika':['Mimika','Mimika'],'puncak-displacement':['Puncak','Puncak'],'intan-jaya-displacement':['Intan Jaya','Intan Jaya'],'awyu-customary-forests':['Awyu','Awyu']};
  const accents:Record<string,string>={'south-papua-food-energy-estate':'#a9b89a','papuan-civic-space':'#a4add0','nduga-displacement':'#b6a1bb','mining-raja-ampat':'#8eb9bd','freeport-mimika':'#c1a58f','awyu-customary-forests':'#a0b89e','puncak-displacement':'#aa9dbf','intan-jaya-displacement':'#a89fb4'};
 let visible=true;new IntersectionObserver(rows=>{visible=rows[0]?.isIntersecting!==false}).observe(root);
 let paused=false,resumeTimer=0,last=performance.now(),lastTintCheck=0,activeTint='',dragging=false,startX=0,startScroll=0,moved=false;
 const pause=(ms=1200)=>{paused=true;window.clearTimeout(resumeTimer);if(ms>0)resumeTimer=window.setTimeout(()=>paused=false,ms)};
 const linkFor=(entry:any)=>{const state=entry.state,update=entry.update||{title:state.change,date:state.asOf,href:`/topics/${entry.slug}/#overview`},a=document.createElement('a');a.className='following-update';a.href=`${en?'':'/id'}${update.href}`;a.dataset.topicTint=accents[entry.slug]||'#aeb0ce';a.style.setProperty('--ticker-accent',a.dataset.topicTint);const topic=document.createElement('span');topic.textContent=shortNames[entry.slug]?.[en?0:1]||(en?entry.title.en:entry.title.pmy||entry.title.id);const rule=document.createElement('i');rule.className='following-topic-rule';rule.setAttribute('aria-hidden','true');const star=document.createElement('b');star.setAttribute('aria-hidden','true');star.textContent='✦';const title=document.createElement('strong');title.textContent=en?update.title.en:update.title.pmy;const time=document.createElement('time');time.dateTime=update.date;time.textContent=new Date(update.date).toLocaleDateString(en?'en-GB':'id-ID',{day:'numeric',month:'short',year:'numeric',timeZone:'Asia/Jayapura'});a.append(topic,rule,title,time,star);return a};
 const render=(items:any[])=>{track.replaceChildren();const segment=document.createElement('div');segment.className='following-segment';items.forEach(item=>segment.append(linkFor(item)));track.append(segment);if(!reduce.matches&&items.length>1){const clone=segment.cloneNode(true) as HTMLElement;clone.setAttribute('aria-hidden','true');clone.querySelectorAll('a').forEach(a=>a.tabIndex=-1);track.append(clone)}};
 const tick=(now:number)=>{const dt=Math.min(60,now-last);last=now;if(!reduce.matches&&!paused&&visible&&!document.hidden&&track.scrollWidth>viewport.clientWidth){viewport.scrollLeft+=dt*.028;const half=track.scrollWidth/2;if(half&&viewport.scrollLeft>=half)viewport.scrollLeft-=half}if(visible&&now-lastTintCheck>450&&!document.hidden){lastTintCheck=now;const box=viewport.getBoundingClientRect(),center=box.left+box.width/2;let best=Infinity,tint='';track.querySelectorAll<HTMLElement>('[data-topic-tint]').forEach(item=>{const rect=item.getBoundingClientRect(),distance=Math.abs((rect.left+rect.right)/2-center);if(distance<best){best=distance;tint=item.dataset.topicTint||''}});if(tint&&tint!==activeTint){activeTint=tint;root.style.setProperty('--topic-tint',tint)}}requestAnimationFrame(tick)};
 viewport.addEventListener('wheel',event=>{const horizontal=Math.abs(event.deltaX)>Math.abs(event.deltaY)*1.15;if(event.shiftKey||horizontal){event.preventDefault();viewport.scrollLeft+=event.shiftKey?event.deltaY:event.deltaX;pause()}},{passive:false});
 viewport.addEventListener('pointerdown',event=>{if(event.pointerType!=='mouse')return;dragging=true;moved=false;startX=event.clientX;startScroll=viewport.scrollLeft;viewport.setPointerCapture(event.pointerId);root.classList.add('is-holding');pause(0)});
 viewport.addEventListener('pointermove',event=>{if(!dragging)return;const dx=event.clientX-startX;if(Math.abs(dx)>3)moved=true;viewport.scrollLeft=startScroll-dx});
 viewport.addEventListener('pointerup',event=>{if(!dragging)return;dragging=false;root.classList.remove('is-holding');viewport.releasePointerCapture(event.pointerId);pause()});viewport.addEventListener('pointercancel',()=>{dragging=false;root.classList.remove('is-holding');pause()});viewport.addEventListener('click',event=>{if(moved){event.preventDefault();moved=false}},true);
 viewport.addEventListener('touchstart',()=>pause(0),{passive:true});viewport.addEventListener('touchend',()=>pause(),{passive:true});root.addEventListener('mouseenter',()=>pause(0));root.addEventListener('mouseleave',()=>pause());root.addEventListener('focusin',()=>pause(0));root.addEventListener('focusout',()=>pause());document.addEventListener('visibilitychange',()=>{paused=document.hidden});reduce.addEventListener('change',()=>location.reload());
 const valid=(x:any)=>/^[a-z0-9-]+$/.test(x.slug)&&x.state?.change?.en&&x.state?.change?.pmy&&Number.isFinite(Date.parse(x.state.asOf));
 const seeded=JSON.parse(root.querySelector('[data-following-seeds]')!.textContent||'[]');render(seeded.filter(valid));
 fetchJSON('/api/following').then(data=>{const items=(data?.items||[]).filter(valid);if(items.length)render(items)}).catch(()=>{});
 const intro=root.querySelector<HTMLElement>('[data-following-intro]')!;let first=true;try{first=!sessionStorage.getItem('wpw:following-intro');sessionStorage.setItem('wpw:following-intro','seen')}catch{}
 if(first){intro.hidden=false;requestAnimationFrame(()=>requestAnimationFrame(()=>intro.classList.add('is-arriving')));setTimeout(()=>{intro.classList.add('is-leaving');setTimeout(()=>{intro.hidden=true},reduce.matches?0:850)},reduce.matches?650:1750)}
 requestAnimationFrame(tick);
}
</script>

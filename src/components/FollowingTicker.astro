---
import '../styles/following.css';
import {withLocale} from '../lib/i18n';
const {locale='en'}=Astro.props;const en=locale==='en';
---
<aside class="following-ticker" data-following-ticker data-locale={locale} aria-label={en?'Following updates':'Kabar dalam pantauan'}>
 <div class="following-wash" aria-hidden="true"><i></i><i></i><i></i></div>
 <div class="following-ticker-inner" data-following-viewport tabindex="0">
  <div class="following-track" data-following-track><a class="following-update" href={withLocale('/topics/',locale)}><span>{en?'Following':'Dalam pantauan'}</span><b aria-hidden="true">✦</b><strong>{en?'Explore the stories we’re following':'Jelajahi isu yang kami pantau'}</strong></a></div>
 </div>
</aside>
<script>
import {fetchJSON} from '../lib/http';
const root=document.querySelector<HTMLElement>('[data-following-ticker]');
if(root){
 const en=root.dataset.locale!=='pmy',reduce=matchMedia('(prefers-reduced-motion: reduce)'),viewport=root.querySelector<HTMLElement>('[data-following-viewport]')!,track=root.querySelector<HTMLElement>('[data-following-track]')!;
 const shortNames:Record<string,[string,string]>={'south-papua-food-energy-estate':['South Papua','Papua Selatan'],'papuan-civic-space':['Civic space','Ruang sipil'],'nduga-displacement':['Nduga','Nduga'],'mining-raja-ampat':['Raja Ampat','Raja Ampat'],'freeport-mimika':['Mimika','Mimika']};
 let paused=false,resumeTimer=0,last=performance.now(),dragging=false,startX=0,startScroll=0,moved=false;
 const pause=(ms=1200)=>{paused=true;window.clearTimeout(resumeTimer);if(ms>0)resumeTimer=window.setTimeout(()=>paused=false,ms)};
 const linkFor=(entry:any)=>{const d=entry.development,a=document.createElement('a');a.className='following-update';a.href=`${en?'':'/id'}${d.story_url}`;const topic=document.createElement('span');topic.textContent=shortNames[entry.slug]?.[en?0:1]||(en?entry.title.en:entry.title.id||entry.title.en);const star=document.createElement('b');star.setAttribute('aria-hidden','true');star.textContent='✦';const title=document.createElement('strong');title.textContent=en?d.title_en:d.title_id||d.title_en;const time=document.createElement('time');time.dateTime=d.latest_report_at;time.textContent=new Date(d.latest_report_at).toLocaleDateString(en?'en-GB':'id-ID',{day:'numeric',month:'short'});a.append(topic,star,title,time);return a};
 const render=(items:any[])=>{track.replaceChildren();const segment=document.createElement('div');segment.className='following-segment';items.forEach(item=>segment.append(linkFor(item)));track.append(segment);if(!reduce.matches){const clone=segment.cloneNode(true) as HTMLElement;clone.setAttribute('aria-hidden','true');clone.querySelectorAll('a').forEach(a=>a.tabIndex=-1);track.append(clone)}};
 const tick=(now:number)=>{const dt=Math.min(60,now-last);last=now;if(!reduce.matches&&!paused&&!document.hidden&&track.scrollWidth>viewport.clientWidth){viewport.scrollLeft+=dt*.028;const half=track.scrollWidth/2;if(half&&viewport.scrollLeft>=half)viewport.scrollLeft-=half}requestAnimationFrame(tick)};
 viewport.addEventListener('wheel',event=>{const horizontal=Math.abs(event.deltaX)>Math.abs(event.deltaY)*1.15;if(event.shiftKey||horizontal){event.preventDefault();viewport.scrollLeft+=event.shiftKey?event.deltaY:event.deltaX;pause()}},{passive:false});
 viewport.addEventListener('pointerdown',event=>{if(event.pointerType!=='mouse')return;dragging=true;moved=false;startX=event.clientX;startScroll=viewport.scrollLeft;viewport.setPointerCapture(event.pointerId);root.classList.add('is-holding');pause(0)});
 viewport.addEventListener('pointermove',event=>{if(!dragging)return;const dx=event.clientX-startX;if(Math.abs(dx)>3)moved=true;viewport.scrollLeft=startScroll-dx});
 viewport.addEventListener('pointerup',event=>{if(!dragging)return;dragging=false;root.classList.remove('is-holding');viewport.releasePointerCapture(event.pointerId);pause()});viewport.addEventListener('pointercancel',()=>{dragging=false;root.classList.remove('is-holding');pause()});viewport.addEventListener('click',event=>{if(moved){event.preventDefault();moved=false}},true);
 viewport.addEventListener('touchstart',()=>pause(0),{passive:true});viewport.addEventListener('touchend',()=>pause(),{passive:true});root.addEventListener('mouseenter',()=>pause(0));root.addEventListener('mouseleave',()=>pause());root.addEventListener('focusin',()=>pause(0));root.addEventListener('focusout',()=>pause());document.addEventListener('visibilitychange',()=>{paused=document.hidden});reduce.addEventListener('change',()=>location.reload());
 fetchJSON('/api/following').then(data=>{const seen=new Set();const items=(data?.items||[]).filter((x:any)=>{const d=x.development;if(!d?.title_en||!/^\/story\/\?id=\d+$/.test(d.story_url)||!Number.isFinite(Date.parse(d.latest_report_at))||seen.has(d.id))return false;seen.add(d.id);return true}).sort((a:any,b:any)=>Date.parse(b.development.latest_report_at)-Date.parse(a.development.latest_report_at));if(items.length)render(items)}).catch(()=>{});requestAnimationFrame(tick);
}
</script>

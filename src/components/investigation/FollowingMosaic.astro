---
import {caseIndex,followedCaseIds} from '../../data/case-presentation';
import {investigativeRecord} from '../../data/investigative-record';
import {followingCaseBySlug} from '../../data/following-cases';
import {t,withLocale} from '../../lib/i18n';
import type {Locale} from '../../data/types';
const {locale='en',compact=false}=Astro.props as {locale?:Locale;compact?:boolean};
const cards=(compact?['awyu','communications','kiwirok','puncak']:followedCaseIds).map(id=>{const item=caseIndex.find(c=>c.id===id)!;const record=investigativeRecord.cases.find(c=>c.id===id);const slug=item.href.split('/')[2],note=followingCaseBySlug[slug];return {...item,deck:record?.deck||note?.summary,period:record?.period||'',count:record?.claimIds.length||0};});
---
<div class:list={['following-mosaic',compact&&'following-mosaic-compact']}>
 {cards.map((c,i)=><a class:list={['following-feature',`following-feature-${i}`,c.cover?.document&&'is-document']} href={withLocale(c.href,locale)} data-following-card={c.id}>
  {c.cover&&<div class="following-feature-image"><img src={c.cover.src} width={c.cover.width} height={c.cover.height} style={`object-position:${c.cover.position}`} loading="lazy" alt={t(c.cover.caption,locale)}/><span class="following-feature-credit">{c.cover.credit}</span></div>}
  <div class="following-feature-copy"><h3>{t(c.title,locale)}</h3>{c.deck&&<p>{t(c.deck,locale)}</p>}<footer><span>{c.period}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></footer></div>
 </a>)}
</div>

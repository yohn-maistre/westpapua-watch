---
import type { Locale } from '../data/types';
const { locale='en' } = Astro.props as { locale?: Locale };
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <div class="footer-brand">West Papua <em>Watch</em></div>
      <p class="footer-note">{locale==='en'?'Current developments, long-running issues, history, events, exhibitions and sources on West Papua.':'Perkembangan terbaru, isu yang jalan lama, sejarah, acara, pameran, deng sumber soal Papua Barat.'}</p>
    </div>
    <nav class="footer-links" aria-label="Public data and feeds">
      <a href="/feed.xml">RSS feed</a>
      <a href="/search.json">Search data</a>
      <a href="/llms.txt">llms.txt</a>
    </nav>
  </div>
</footer>

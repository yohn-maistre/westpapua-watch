---
import type { Locale } from '../data/types';import ui from '../../content/ui.json';
const { locale='en' } = Astro.props as { locale?: Locale };
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <div class="footer-brand">West Papua <em>Watch</em></div>
      <p class="footer-note">{ui.footer.note[locale]}</p>
    </div>
    <nav class="footer-links" aria-label="Public data and feeds">
      <a href="/feed.xml">RSS feed</a>
      <a href="/search.json">Search data</a>
      <a href="/llms.txt">llms.txt</a>
    </nav>
  </div>
</footer>

---
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import '../styles/polish-05.css';
import '../styles/polish-10-5.css';
import '../styles/polish-10-6.css';
import '../styles/polish-10-7.css';
import '../styles/polish-10-8.css';
import { SITE } from '../data/site';
import type { Locale } from '../data/types';
import ProgrammeBanner from '../components/ProgrammeBanner.astro';
import Masthead from '../components/Masthead.astro';
import CompactNav from '../components/CompactNav.astro';
import AskDialog from '../components/AskDialog.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { alternateLocalePath, t } from '../lib/i18n';

const { title, description, locale='en', active='now', immersive=false, noFooter=false } = Astro.props as { title?:string; description?:string; locale?:Locale; active?:string; immersive?:boolean; noFooter?:boolean };
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const desc = description || t(SITE.description, locale);
const canonical = new URL(Astro.url.pathname, SITE.url);
const alternate = new URL(alternateLocalePath(Astro.url.pathname, locale), SITE.url);
const lang = locale==='pmy'?'id':'en';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#080a10" />
  <meta name="description" content={desc} />
  <meta name="color-scheme" content="dark" />
  <meta property="og:title" content={pageTitle} /><meta property="og:description" content={desc} /><meta property="og:type" content="website" />
  <meta property="og:url" content={canonical.toString()} /><meta property="og:site_name" content={SITE.name} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={canonical.toString()} />
  <link rel="alternate" hreflang={locale==='en'?'id':'en'} href={alternate.toString()} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href="/site.webmanifest" />
  <title>{pageTitle}</title>
</head>
<body class:list={[immersive && 'exhibition-view-body']}>
  {!immersive && <ProgrammeBanner locale={locale} />}
  {!immersive && <Masthead locale={locale} active={active} path={Astro.url.pathname} />}
  {!immersive && <div class="nav-sentinel" data-nav-sentinel aria-hidden="true"></div>}
  {!immersive && <CompactNav locale={locale} active={active} path={Astro.url.pathname} />}
  <a class="skip-link" href="#main">{locale==='en'?'Skip to content':'Langsung ke konten'}</a><main id="main" tabindex="-1"><slot /></main>
  {!immersive && !noFooter && <SiteFooter locale={locale} />}
  {!immersive && <AskDialog locale={locale} />}
  <script>
    const q=(s,root=document)=>root?.querySelector(s); const qa=(s,root=document)=>[...(root?.querySelectorAll(s)||[])];
    document.querySelectorAll('a[hreflang]').forEach(link=>{const url=new URL(link.href);url.search=location.search;url.hash=location.hash;link.href=url.href});
    const navSentinel=q('[data-nav-sentinel]');
    if(navSentinel){const io=new IntersectionObserver(([e])=>{const crossed=!e.isIntersecting&&e.boundingClientRect.top<0;document.body.classList.toggle('nav-collapsed',crossed);const nav=q('[data-compact-nav]');if(nav){nav.inert=!crossed;nav.setAttribute('aria-hidden',String(!crossed))}},{threshold:0});io.observe(navSentinel)}
    const compactNav=q('[data-compact-nav]');
    if(compactNav){const syncCompactHeight=()=>document.documentElement.style.setProperty('--compact-nav-actual-height',`${Math.ceil(compactNav.getBoundingClientRect().height)}px`);syncCompactHeight();new ResizeObserver(syncCompactHeight).observe(compactNav);window.addEventListener('resize',syncCompactHeight,{passive:true})}
    const banner=q('[data-programme-start]');
    if(banner){const out=q('[data-countdown]',banner);const start=new Date(banner.dataset.programmeStart);const end=new Date(banner.dataset.programmeEnd);const tick=()=>{const now=new Date();let txt='10–12 Sep';if(now<start){const ms=start-now,d=Math.floor(ms/864e5),h=Math.floor(ms%864e5/36e5),m=Math.floor(ms%36e5/6e4);txt=`starts in ${d}d ${h}h ${m}m`}else if(now<=end)txt='happening now';else txt='programme archive';if(out)out.textContent=txt};tick();setInterval(tick,60000)}
  </script>
</body>
</html>

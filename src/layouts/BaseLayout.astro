---
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import '../styles/polish-05.css';
import { SITE } from '../data/site';
import type { Locale } from '../data/types';
import ProgrammeBanner from '../components/ProgrammeBanner.astro';
import Masthead from '../components/Masthead.astro';
import CompactNav from '../components/CompactNav.astro';
import AskDialog from '../components/AskDialog.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { alternateLocalePath, t } from '../lib/i18n';

const { title, description, locale='en', active='now', immersive=false, noFooter=false } = Astro.props as { title?:string; description?:string; locale?:Locale; active?:string; immersive?:boolean; noFooter?:boolean };
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const desc = description || t(SITE.description, locale);
const canonical = new URL(Astro.url.pathname.replace(/^\/pmy(?=\/|$)/,'') || '/', SITE.url);
const alternate = new URL(alternateLocalePath(Astro.url.pathname, locale), SITE.url);
const lang = locale==='pmy'?'id':'en';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#080a10" />
  <meta name="description" content={desc} />
  <meta name="color-scheme" content="dark" />
  <meta property="og:title" content={pageTitle} /><meta property="og:description" content={desc} /><meta property="og:type" content="website" />
  <meta property="og:url" content={canonical.toString()} /><meta property="og:site_name" content={SITE.name} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={canonical.toString()} />
  <link rel="alternate" hreflang={locale==='en'?'pmy':'en'} href={alternate.toString()} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href="/site.webmanifest" />
  <title>{pageTitle}</title>
</head>
<body class:list={[immersive && 'exhibition-view-body']}>
  {!immersive && <ProgrammeBanner locale={locale} />}
  {!immersive && <Masthead locale={locale} active={active} path={Astro.url.pathname} />}
  {!immersive && <CompactNav locale={locale} active={active} path={Astro.url.pathname} />}
  <main><slot /></main>
  {!immersive && !noFooter && <SiteFooter locale={locale} />}
  {!immersive && <AskDialog locale={locale} />}
  <script>
    const q=(s,root=document)=>root.querySelector(s); const qa=(s,root=document)=>[...root.querySelectorAll(s)];
    const masthead=q('[data-masthead]');
    if(masthead){const io=new IntersectionObserver(([e])=>document.body.classList.toggle('nav-collapsed',!e.isIntersecting),{threshold:.04});io.observe(masthead)}
    const banner=q('[data-programme-start]');
    if(banner){const out=q('[data-countdown]',banner);const start=new Date(banner.dataset.programmeStart);const end=new Date(banner.dataset.programmeEnd);const tick=()=>{const now=new Date();let txt='10–12 Sep';if(now<start){const ms=start-now,d=Math.floor(ms/864e5),h=Math.floor(ms%864e5/36e5),m=Math.floor(ms%36e5/6e4);txt=`starts in ${d}d ${h}h ${m}m`}else if(now<=end)txt='happening now';else txt='programme archive';if(out)out.textContent=txt};tick();setInterval(tick,60000)}
    const dialog=q('[data-ask-dialog]'); const input=q('[data-ask-input]',dialog); const results=q('[data-ask-results]',dialog); const answer=q('[data-ask-answer]',dialog); const submit=q('[data-ask-submit]',dialog); let corpus=[];
    async function getCorpus(){if(corpus.length)return corpus;try{corpus=await fetch('/search.json',{cache:'force-cache'}).then(r=>r.json())}catch{corpus=[]}return corpus}
    function esc(s=''){return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
    async function localSearch(value){const c=await getCorpus();const locale=dialog?.dataset.locale||'en';const words=value.toLowerCase().split(/\s+/).filter(Boolean);const ranked=c.map(x=>{const title=(x.title?.[locale]||x.title?.en||x.title||'').toLowerCase();const text=(x.text?.[locale]||x.text?.en||x.text||'').toLowerCase();const hay=title+' '+text+' '+(x.tags||[]).join(' ').toLowerCase();let score=words.reduce((n,w)=>n+(title.includes(w)?4:0)+(hay.includes(w)?1:0),0);return{x,score}}).filter(v=>v.score>0).sort((a,b)=>b.score-a.score).slice(0,5).map(v=>v.x);if(results){results.innerHTML=ranked.map(x=>`<a class="ask-result" href="${esc(x.href)}"><small>${esc(x.type)}</small><div><strong>${esc(x.title?.[locale]||x.title?.en||x.title)}</strong><p>${esc((x.text?.[locale]||x.text?.en||x.text||'').slice(0,160))}</p></div></a>`).join('')}}
    qa('[data-ask-open]').forEach(b=>b.addEventListener('click',()=>{dialog?.showModal();setTimeout(()=>input?.focus(),40)}));
    qa('[data-prompt]',dialog).forEach(b=>b.addEventListener('click',()=>{if(input)input.value=b.dataset.prompt||'';localSearch(input?.value||'')}));
    input?.addEventListener('input',()=>localSearch(input.value));
    async function ask(){const query=input?.value.trim()||'';if(query.length<2)return;submit.disabled=true;if(answer){answer.hidden=false;answer.textContent=dialog?.dataset.locale==='pmy'?'Sedang cari sumber…':'Checking sources…'}try{const r=await fetch('/api/ask',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({query,locale:dialog?.dataset.locale||'en'})});const data=await r.json();if(!r.ok)throw new Error(data.error||'Ask unavailable');if(answer){answer.innerHTML=`<p>${esc(data.answer)}</p><div class="ask-citations">${(data.sources||[]).map(s=>`<a href="${esc(s.url)}" target="_blank" rel="noreferrer">${esc(s.publisher)} · ${esc(s.title)}</a>`).join('')}</div>`}}catch(err){if(answer)answer.textContent=err instanceof Error?err.message:'Ask unavailable'}finally{submit.disabled=false}}
    submit?.addEventListener('click',ask); input?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();ask()}});
    document.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();dialog?.showModal();setTimeout(()=>input?.focus(),40)}});
    // data-driven History stage
    const frames=qa('[data-history-frame]');const chapters=qa('[data-history-chapter]');if(frames.length&&chapters.length){const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){const id=e.target.dataset.historyChapter;frames.forEach(f=>f.classList.toggle('active',f.dataset.historyFrame===id))}}),{threshold:.5});chapters.forEach(c=>io.observe(c))}
    // Resource filters
    const resourceRows=qa('[data-resource-row]'); const resourceSearch=q('[data-resource-search]'); const filters=qa('[data-resource-filter]'); let resourceType='all';const applyResources=()=>{const term=(resourceSearch?.value||'').toLowerCase();resourceRows.forEach(row=>{const tags=(row.dataset.resourceTags||'').split(/\s+/).filter(Boolean);const matchType=resourceType==='all'||row.dataset.resourceType===resourceType||tags.includes(resourceType);const matchTerm=!term||(row.textContent||'').toLowerCase().includes(term);row.hidden=!(matchType&&matchTerm)})};resourceSearch?.addEventListener('input',applyResources);filters.forEach(b=>b.addEventListener('click',()=>{resourceType=b.dataset.resourceFilter||'all';filters.forEach(x=>x.classList.toggle('active',x===b));applyResources()}));
    // Issue filters
    const issueRows=qa('[data-issue-row]');const issueFilters=qa('[data-issue-filter]');issueFilters.forEach(b=>b.addEventListener('click',()=>{const cat=b.dataset.issueFilter||'all';issueFilters.forEach(x=>x.classList.toggle('active',x===b));issueRows.forEach(r=>r.hidden=!(cat==='all'||r.dataset.issueCategory===cat))}));
  </script>
</body>
</html>

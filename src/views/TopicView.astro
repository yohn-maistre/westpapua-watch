---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResourceList from '../components/resources/ResourceList.astro';
import {libraryForTopic} from '../data/library';
import {t,withLocale} from '../lib/i18n';
import type {Issue,Locale} from '../data/types';
const {issue,locale='en'}=Astro.props as {issue:Issue;locale:Locale};const en=locale==='en';
---
<BaseLayout locale={locale} active="issues" title={t(issue.title,locale)} description={t(issue.summary,locale)}>
<div class="wrap topic-page" data-topic-page data-slug={issue.slug} data-locale={locale}>
<a class="story-back" href={withLocale('/topics/#topics',locale)}>← {en?'Topics':'Topik'}</a>
<header class="topic-page-head"><h1 class="page-title">{t(issue.title,locale)}</h1><p>{t(issue.summary,locale)}</p></header>
<nav class="topic-page-index" aria-label={en?'On this page':'Di halaman ini'}><a href="#reporting">{en?'News':'Berita'}</a><a href="#library">{en?'Library':'Pustaka'}</a></nav>
<section id="reporting" class="section"><div class="section-head section-head-simple"><h2>{en?'News.':'Berita.'}</h2><span data-topic-time></span></div><p role="status" data-topic-status>{en?'Loading news…':'Memuat berita…'}</p><div class="topic-news-grid" data-topic-news aria-busy="true">{[0,1,2].map(()=><div class="topic-news-skeleton" aria-hidden="true"></div>)}</div></section>
<section id="library" class="section"><div class="section-head section-head-simple"><h2>{en?'Library.':'Pustaka.'}</h2><a href={withLocale('/resources/',locale)+'?topic='+issue.slug}>{en?'Browse all ↗':'Lihat semua ↗'}</a></div><ResourceList items={libraryForTopic(issue.slug)} locale={locale} topic={issue.slug}/></section>
</div>
<script>
import {fetchJSON} from '../lib/http';
const root=document.querySelector<HTMLElement>('[data-topic-page]');
if(root){const en=root.dataset.locale==='en',grid=root.querySelector<HTMLElement>('[data-topic-news]')!,status=root.querySelector<HTMLElement>('[data-topic-status]')!;
fetchJSON(`/api/issue/${encodeURIComponent(root.dataset.slug!)}`).then(data=>{grid.replaceChildren();status.textContent=data.developments?.length?'':en?'No linked news yet.':'Belum ada berita terkait.';for(const d of data.developments||[]){const a=document.createElement('a');a.className='topic-news-card';a.href=`${en?'':'/pmy'}${d.story_url}`;if(d.image?.url){const img=document.createElement('img');img.src=d.image.url;img.alt='';img.loading='lazy';a.append(img)}const body=document.createElement('div'),h=document.createElement('h3'),p=document.createElement('p'),meta=document.createElement('small');h.textContent=en?d.title_en:(d.title_id||d.title_en);p.textContent=en?d.summary_en:(d.summary_id||d.summary_en);meta.textContent=`${d.article_count||1} ${en?'reports':'laporan'} · ${d.source_count||1} ${en?'sources':'sumber'}`;body.append(h,p,meta);a.append(body);grid.append(a)}if(data.updated_at)root.querySelector('[data-topic-time]')!.textContent=new Date(data.updated_at).toLocaleDateString(en?'en-GB':'id-ID',{day:'numeric',month:'short',year:'numeric'})}).catch(()=>{grid.replaceChildren();status.textContent=en?'News is temporarily unavailable.':'Berita sementara tidak tersedia.'}).finally(()=>grid.setAttribute('aria-busy','false'))}
</script>
<style>
.topic-page{padding-top:2.5rem}.story-back{color:var(--muted);font-size:.85rem}.topic-page-head{padding:2.2rem 0 2rem;display:grid;grid-template-columns:1.3fr 1fr;align-items:end;gap:3rem}.topic-page-head h1{margin:0;font-size:clamp(2.7rem,6vw,6.2rem);line-height:.98;max-width:17ch}.topic-page-head p{font-size:clamp(1rem,1.6vw,1.25rem);color:var(--muted);line-height:1.65;margin:0;max-width:43ch}.topic-page-index{display:flex;gap:2rem;border-block:1px solid var(--line);padding:1rem 0}.topic-news-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.2rem}.topic-news-grid:empty{display:none}.topic-news-card{display:flex;flex-direction:column;background:#12151d;border:1px solid var(--line);border-radius:18px;overflow:hidden}.topic-news-card img{width:100%;aspect-ratio:1.5;object-fit:cover}.topic-news-card>div{padding:1.4rem;display:flex;flex:1;flex-direction:column;gap:1rem}.topic-news-card h3{font-size:clamp(1.5rem,2.3vw,2.2rem);letter-spacing:-.045em;line-height:1.08;margin:0;text-wrap:balance}.topic-news-card p{color:var(--muted);font-size:.9rem;line-height:1.6;margin:0;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}.topic-news-card small{margin-top:auto;color:var(--muted);font-size:.7rem}.topic-news-skeleton{min-height:280px;border-radius:18px;background:linear-gradient(110deg,#171a23,#222634,#171a23);background-size:200% 100%;animation:loading 1.8s infinite}.section{scroll-margin-top:calc(var(--compact-nav-actual-height,110px) + 24px)}[data-topic-status]{color:var(--muted);font-size:.85rem}[data-topic-status]:empty{display:none}[data-topic-time]{font-size:.75rem;color:var(--muted)}@keyframes loading{to{background-position:-200% 0}}@media(max-width:760px){.topic-page-head{grid-template-columns:1fr;gap:1.5rem}.topic-news-grid{grid-template-columns:1fr}.topic-page-head h1{font-size:clamp(2.6rem,10vw,4.5rem)}}@media(prefers-reduced-motion:reduce){.topic-news-skeleton{animation:none}}
</style>
</BaseLayout>

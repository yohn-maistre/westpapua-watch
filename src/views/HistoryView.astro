---
import BaseLayout from '../layouts/BaseLayout.astro';import { historyChapters } from '../data/history';import { sourceById } from '../data/sources';import { t } from '../lib/i18n';import type { Locale } from '../data/types';import ui from '../../content/ui.json';const {locale='en'}=Astro.props as {locale?:Locale};
---
<BaseLayout locale={locale} active="history" title={locale==='en'?'History':'Sejarah'}><section class="section history-page"><div class="wrap"><h1 class="page-title history-page-title">{ui.history.pageTitle[locale]}</h1><div class="history-mobile-narrative" data-history-mobile><div class="history-stage-shell" data-history-stage-shell><div class="history-stage" data-history-stage aria-hidden="true"><div class="history-stage-label"><span data-history-stage-count>{String(1).padStart(2,'0')} / {String(historyChapters.length).padStart(2,'0')}</span><span data-history-stage-year>{historyChapters[0].year}</span></div>{historyChapters.map((c,i)=> c.visual==='document'?<div class:list={['history-frame','history-document',i===0&&'is-current']} data-history-frame={String(i)}><div class="history-paper"><div class="history-stamp">{c.year}</div>{[82,64,90,72,58,86,68].map(w=><div class="history-line" style={`width:${w}%`}></div>)}</div></div>:c.visual==='split'?<div class:list={['history-frame','history-split',i===0&&'is-current']} data-history-frame={String(i)}><div><span>institutional record</span></div><div><span>Papuan accounts / scholarship</span></div><b>{c.year}</b></div>:<div class:list={['history-frame','history-map',i===0&&'is-current']} data-history-frame={String(i)}><div class="history-island"></div><i class="history-node" style="left:29%;top:54%"></i><i class="history-node" style="left:48%;top:50%"></i><i class="history-node" style="left:65%;top:57%"></i><b>{c.year}</b></div>)}<div class="history-stage-index">{historyChapters.map((c,i)=><span class:list={[i===0&&'active']} data-history-dot={String(i)}>{c.year}</span>)}</div></div><div class="history-copy">{historyChapters.map((c,i)=><article class="history-chapter" data-history-chapter={String(i)} data-history-year={c.year}><div class="history-year">{c.year}</div><h2>{t(c.title,locale)}</h2><p>{t(c.body,locale)}</p><div class="history-sources">{c.sourceIds.map(id=>sourceById[id]?.publisher).filter(Boolean).join(' · ')}</div></article>)}</div></div></div>
<div class="history-desktop-spreads">{historyChapters.map((c,i)=><article class:list={['history-spread',i%2===1&&'is-reverse']}><div class="history-stage history-spread-stage" aria-hidden="true"><div class="history-stage-label"><span>{String(i+1).padStart(2,'0')} / {String(historyChapters.length).padStart(2,'0')}</span><span>{c.year}</span></div>{c.visual==='document'?<div class="history-frame history-document is-current"><div class="history-paper"><div class="history-stamp">{c.year}</div>{[82,64,90,72,58,86,68].map(w=><div class="history-line" style={`width:${w}%`}></div>)}</div></div>:c.visual==='split'?<div class="history-frame history-split is-current"><div><span>institutional record</span></div><div><span>Papuan accounts / scholarship</span></div><b>{c.year}</b></div>:<div class="history-frame history-map is-current"><div class="history-island"></div><i class="history-node" style="left:29%;top:54%"></i><i class="history-node" style="left:48%;top:50%"></i><i class="history-node" style="left:65%;top:57%"></i><b>{c.year}</b></div>}</div><div class="history-spread-copy"><div class="history-year">{c.year}</div><h2>{t(c.title,locale)}</h2><p>{t(c.body,locale)}</p><div class="history-sources">{c.sourceIds.map(id=>sourceById[id]?.publisher).filter(Boolean).join(' · ')}</div></div></article>)}</div></div></section>
<script>
const mobile=document.querySelector<HTMLElement>('[data-history-mobile]'),frames=[...(mobile?.querySelectorAll<HTMLElement>('[data-history-frame]')||[])],chapters=[...(mobile?.querySelectorAll<HTMLElement>('[data-history-chapter]')||[])],dots=[...(mobile?.querySelectorAll<HTMLElement>('[data-history-dot]')||[])],year=mobile?.querySelector<HTMLElement>('[data-history-stage-year]'),count=mobile?.querySelector<HTMLElement>('[data-history-stage-count]'),stage=mobile?.querySelector<HTMLElement>('[data-history-stage]');let active=-1,raf=0;const activate=(i:number)=>{if(i===active||i<0||i>=chapters.length)return;active=i;frames.forEach((f,n)=>{f.classList.toggle('is-current',n===i);f.classList.toggle('is-past',n<i)});dots.forEach((d,n)=>d.classList.toggle('active',n===i));if(year)year.textContent=chapters[i]?.dataset.historyYear||'';if(count)count.textContent=`${String(i+1).padStart(2,'0')} / ${String(chapters.length).padStart(2,'0')}`};const update=()=>{raf=0;if(!stage||!chapters.length||innerWidth>760)return;const compact=document.querySelector<HTMLElement>('[data-compact-nav]');const navBottom=document.body.classList.contains('nav-collapsed')&&compact?Math.max(0,compact.getBoundingClientRect().bottom):0;stage.style.setProperty('--history-sticky-top',`${navBottom}px`);const rect=stage.getBoundingClientRect();stage.classList.toggle('is-pinned',document.body.classList.contains('nav-collapsed')&&rect.top<=navBottom+2);const anchor=rect.bottom+24;let next=0;chapters.forEach((c,i)=>{if(c.getBoundingClientRect().top<=anchor)next=i});activate(next)};const queue=()=>{if(!raf)raf=requestAnimationFrame(update)};addEventListener('scroll',queue,{passive:true});addEventListener('resize',queue,{passive:true});new MutationObserver(queue).observe(document.body,{attributes:true,attributeFilter:['class']});queue();
</script></BaseLayout>

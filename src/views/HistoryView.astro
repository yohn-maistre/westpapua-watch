---
import BaseLayout from '../layouts/BaseLayout.astro';
import {historyChapters} from '../data/history';
import {itemBySourceId as sourceById} from '../data/library';
import {t,withLocale} from '../lib/i18n';
import type {Locale} from '../data/types';
const {locale='en'}=Astro.props as {locale?:Locale};const en=locale==='en';
const groups=[{id:'people',label:{en:'People & place',pmy:'Masyarakat & tanah'},ids:['history-living','history-1949']},{id:'choice',label:{en:'A future contested',pmy:'Masa depan diperebutkan'},ids:['history-1961','history-1962','history-1969']},{id:'land',label:{en:'Land & public life',pmy:'Tanah & kehidupan publik'},ids:['history-land','history-mambesak']},{id:'voices',label:{en:'Organising & change',pmy:'Gerakan & perubahan'},ids:['history-reformasi','history-2001','history-2014','history-today']}];
---
<BaseLayout locale={locale} active="history" title={en?'History':'Sejarah'}>
<div class="history-editorial">
<header class="wrap history-opening"><h1 class="page-title">{en?'History.':'Sejarah.'}</h1><nav aria-label={en?'Chapters':'Bab'}>{groups.map((g,i)=><a href={`#${g.id}`}><small>0{i+1}</small>{t(g.label,locale)}<span aria-hidden="true">↘</span></a>)}</nav></header>
{groups.map((g,gi)=><section class:list={['history-volume',gi%2===1&&'history-volume-paper']} id={g.id}><div class="wrap history-volume-grid">
<aside class="history-volume-heading"><span>0{gi+1}</span><h2>{t(g.label,locale)}</h2><nav aria-label={en?'Dates':'Tahun'}>{g.ids.map(id=>historyChapters.find(c=>c.id===id)!).map(c=><a href={`#${c.id}`}>{t(c.yearLabel,locale)}</a>)}</nav></aside>
<div class="history-events">{g.ids.map(id=>historyChapters.find(c=>c.id===id)!).map(c=><article id={c.id} class="history-event">
<div class="history-event-date">{t(c.yearLabel,locale)}</div>
{c.media&&<figure class="history-media"><button type="button" data-history-image={c.media.src} data-history-caption={t(c.media.caption,locale)} aria-label={en?'Enlarge image':'Perbesar gambar'}><img src={c.media.src} alt={t(c.media.caption,locale)} loading="lazy" width="1000" height="750"/><span aria-hidden="true">↗</span></button><figcaption>{t(c.media.caption,locale)} <a href={c.media.url} target="_blank" rel="noreferrer">{c.media.credit}</a> · <a href={c.media.licenseUrl} target="_blank" rel="noreferrer">{c.media.license}</a></figcaption></figure>}
<h3>{t(c.title,locale)}</h3>{t(c.body,locale).split('\n\n').map(p=><p>{p}</p>)}
<details class="history-records"><summary>{en?'Sources':'Sumber'} <span>{c.sourceIds.length}</span></summary><div>{c.sourceIds.map(id=>sourceById[id]).filter(Boolean).map(s=><a href={s.url} target="_blank" rel="noreferrer"><small>{s.publisher}</small><span>{s.title} ↗</span></a>)}</div></details>
</article>)}</div></div></section>)}
<footer class="wrap history-footer"><a href={withLocale('/topics/',locale)}><h2>{en?'Follow the story.':'Ikuti ceritanya.'}</h2><span>↗</span></a><details><summary>{en?'About this chronology':'Tentang kronologi ini'}</summary><p>{en?'Selected events, centred on Papuan experiences. Sources include historical research, movement documents and official records. Images retain their own dates and credits.':'Pilihan peristiwa dari pengalaman orang Papua. Sumber mencakup penelitian sejarah, dokumen gerakan, dan catatan resmi. Tanggal serta kredit gambar dicantumkan tersendiri.'}</p></details></footer>
</div>
<dialog class="history-image-dialog" data-history-dialog><button type="button" data-history-dialog-close aria-label={en?'Close':'Tutup'}>×</button><figure><img data-history-dialog-image alt=""/><figcaption data-history-dialog-caption></figcaption></figure></dialog>
</BaseLayout>
<style>
.history-editorial{padding-top:2rem}.history-opening{padding-bottom:3rem}.history-opening nav{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.5rem;margin-top:2rem;border-top:1px solid var(--line)}.history-opening nav a{display:grid;grid-template-columns:1fr auto;gap:.5rem;padding:1rem 0;font-size:.85rem}.history-opening nav small{grid-column:1/-1;color:var(--muted);font-size:.65rem}.history-volume{padding:clamp(3rem,7vw,7rem) 0;background:#11151c;--history-muted:#b8b8c2;--history-line:#ffffff22;scroll-margin-top:var(--compact-nav-actual-height,110px)}.history-volume-paper{background:#e8e5dc;color:#23272c;--history-muted:#50565b;--history-line:#23272c30}.history-volume-grid{display:grid;grid-template-columns:.65fr 1fr;gap:clamp(2rem,8vw,8rem);align-items:start}.history-volume-heading{position:sticky;top:calc(var(--compact-nav-actual-height,110px) + 24px)}.history-volume-heading>span{display:block;font-size:.75rem;letter-spacing:.12em;margin-bottom:2rem}.history-volume-heading h2{font-size:clamp(2.7rem,5vw,5.5rem);letter-spacing:-.06em;line-height:.98;margin:0 0 2rem;max-width:11ch}.history-volume-heading nav{display:flex;flex-wrap:wrap;gap:.6rem 1rem;color:var(--history-muted);font-size:.75rem}.history-events{border-left:1px solid var(--history-line);padding-left:clamp(1.5rem,3vw,3rem)}.history-event{position:relative;padding-bottom:4rem;scroll-margin-top:calc(var(--compact-nav-actual-height,110px) + 24px)}.history-event:last-child{padding-bottom:0}.history-event:before{content:'';position:absolute;left:calc(-1 * clamp(1.5rem,3vw,3rem) - 5px);top:12px;width:9px;height:9px;border-radius:50%;background:#a79bc8;border:2px solid currentColor}.history-event-date{font-size:clamp(1.7rem,4vw,3.4rem);font-weight:600;letter-spacing:-.06em;line-height:1;margin-bottom:1.5rem}.history-event h3{font-size:clamp(1.8rem,3vw,3rem);line-height:1.04;letter-spacing:-.045em;margin:1.5rem 0 1rem;max-width:25ch}.history-event>p{font-size:clamp(1rem,1.25vw,1.15rem);line-height:1.7;color:var(--history-muted);max-width:60ch;margin:0 0 1rem}.history-media{margin:0 0 1.6rem}.history-media>button{position:relative;display:block;padding:0;border:0;background:transparent;width:100%;cursor:zoom-in;overflow:hidden;border-radius:3px}.history-media img{display:block;width:100%;height:auto;max-height:540px;object-fit:contain}.history-media button>span{position:absolute;bottom:10px;right:10px;border-radius:50%;background:#f4f1e9;color:#23272c;width:32px;height:32px;display:grid;place-items:center}.history-media figcaption{font-size:.65rem;line-height:1.5;color:var(--history-muted);margin-top:.6rem}.history-media figcaption a{text-decoration:underline;text-underline-offset:2px}.history-records{border-top:1px solid var(--history-line);margin-top:1.3rem;padding-top:.6rem}.history-records summary{cursor:pointer;font-size:.75rem;min-height:32px}.history-records summary>span{color:var(--history-muted);margin-left:.6rem}.history-records a{display:grid;gap:.3rem;padding:.7rem 0;border-bottom:1px solid var(--history-line);font-size:.82rem;line-height:1.4}.history-records small{color:var(--history-muted)}.history-footer{padding-block:3rem}.history-footer>a{display:flex;justify-content:space-between;gap:2rem;align-items:center}.history-footer h2{font-size:clamp(2.5rem,6vw,6rem);letter-spacing:-.065em;line-height:1}.history-footer>a>span{font-size:3rem}.history-footer details{font-size:.8rem;color:var(--muted);max-width:70ch}.history-footer summary{cursor:pointer}.history-image-dialog{border:0;padding:3rem 1rem 1rem;background:#10131b;color:#eeedf5;width:min(1000px,94vw);max-height:92svh;border-radius:14px}.history-image-dialog::backdrop{background:#06080eea;backdrop-filter:blur(6px)}.history-image-dialog>button{position:absolute;right:10px;top:5px;background:transparent;color:inherit;border:0;font-size:2rem;width:44px;height:44px;cursor:pointer}.history-image-dialog figure{margin:0}.history-image-dialog img{display:block;max-width:100%;max-height:75svh;width:auto;height:auto;margin:auto}.history-image-dialog figcaption{padding-top:.75rem;font-size:.8rem}
@media(max-width:760px){.history-opening nav{grid-template-columns:1fr 1fr;gap:0 1.5rem;margin-top:1rem}.history-opening{padding-bottom:2rem}.history-volume-grid{display:block}.history-volume-heading{position:static;margin-bottom:2.5rem}.history-volume-heading>span{margin-bottom:1rem}.history-volume-heading h2{font-size:clamp(2.8rem,11vw,4rem);max-width:14ch;margin-bottom:1rem}.history-volume-heading nav{display:none}.history-events{padding-left:1.25rem}.history-event:before{left:calc(-1.25rem - 5px)}.history-event{padding-bottom:3rem}.history-event-date{font-size:2.4rem}.history-event h3{font-size:clamp(1.9rem,7vw,2.7rem)}.history-media img{max-height:none}.history-volume{padding-block:2.5rem}}
@media print{.history-volume-heading{position:static}.history-volume{background:white;color:black}.history-records>div{display:block}}
</style>
<script>
const dialog=document.querySelector<HTMLDialogElement>('[data-history-dialog]');
document.querySelectorAll<HTMLButtonElement>('[data-history-image]').forEach(button=>button.addEventListener('click',()=>{if(!dialog)return;const image=dialog.querySelector<HTMLImageElement>('[data-history-dialog-image]')!;image.src=button.dataset.historyImage!;image.alt=button.dataset.historyCaption||'';dialog.querySelector('[data-history-dialog-caption]')!.textContent=image.alt;dialog.showModal()}));
dialog?.querySelector('[data-history-dialog-close]')?.addEventListener('click',()=>dialog.close());dialog?.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close()}});
</script>

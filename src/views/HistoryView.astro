---
import BaseLayout from '../layouts/BaseLayout.astro';
import {historyChapters} from '../data/history';
import {sourceById} from '../data/sources';
import {t,withLocale} from '../lib/i18n';
import type {Locale} from '../data/types';
const {locale='en'}=Astro.props as {locale?:Locale};
const en=locale==='en';
---
<BaseLayout locale={locale} active="history" title={en?'History':'Sejarah'}>
<section class="section history-reader"><div class="wrap">
 <header class="history-opening"><span class="eyebrow">{en?'People · land · self-determination':'Masyarakat · tanah · penentuan nasib sendiri'}</span><h1 class="page-title">{en?'History.':'Sejarah.'}</h1><p class="page-intro">{en?'A living chronology of West Papua, centred on Papuan experiences. Read the events, follow the arguments, and return to the sources.':'Kronologi hidup Papua Barat, berpusat pada pengalaman orang Papua. Baca peristiwanya, telusuri pandangannya, dan kembali ke sumbernya.'}</p><p class="history-method">{en?'An introductory chronology, not an exhaustive history. Papuan communities hold diverse views. Movement documents, historical research and official records are identified below.':'Kronologi pengantar, bukan seluruh sejarah. Masyarakat Papua memiliki pandangan beragam. Dokumen gerakan, penelitian sejarah, dan catatan resmi ditampilkan di bawah.'}</p></header>
 <nav class="history-jump" aria-label={en?'Jump to a chapter':'Pilih bab'}>{historyChapters.map(c=><a href={`#${c.id}`}>{c.year}</a>)}</nav>
 <div class="history-reading-grid">
 <aside class="history-date-stage" aria-hidden="true"><span>{en?'WEST PAPUA / A CHRONOLOGY':'PAPUA BARAT / KRONOLOGI'}</span><strong data-history-year>{historyChapters[0].year}</strong><p data-history-title>{t(historyChapters[0].title,locale)}</p><small data-history-progress>01 / {String(historyChapters.length).padStart(2,'0')}</small></aside>
 <div class="history-chapters">{historyChapters.map((c,i)=><article id={c.id} class="history-reading-chapter" data-history-chapter data-year={c.year} data-title={t(c.title,locale)} data-index={i+1}>
  <div class="history-chapter-number"><span>{String(i+1).padStart(2,'0')}</span><time>{c.year}</time></div><h2>{t(c.title,locale)}</h2>
  {t(c.body,locale).split('\n\n').map(p=><p>{p}</p>)}
  <div class="history-evidence"><span>{en?'Read the record':'Telusuri sumber'}</span>{c.sourceIds.map(id=>sourceById[id]).filter(Boolean).map(s=><a href={s.url} target="_blank" rel="noreferrer"><small>{s.publisher}</small><strong>{s.title} ↗</strong></a>)}</div>
 </article>)}</div></div>
 <footer class="history-continue"><h2>{en?'History continues.':'Sejarah berlanjut.'}</h2><p>{en?'Follow a subject through its background, timeline and latest reporting.':'Ikuti sebuah topik melalui latar belakang, linimasa, dan laporan terbarunya.'}</p><a class="chip primary" href={withLocale('/topics/',locale)}>{en?'Explore topics':'Jelajahi topik'} →</a><a class="chip" href={withLocale('/resources/',locale)}>{en?'Browse resources':'Jelajahi sumber'} →</a></footer>
</div></section>
</BaseLayout>
<style>
.history-opening{max-width:1000px}.history-method{max-width:75ch;color:var(--muted);font-size:.85rem;line-height:1.6}.history-jump{display:flex;flex-wrap:wrap;gap:.5rem;margin:2rem 0 3rem;padding:1rem 0;border-block:1px solid var(--line)}.history-jump a{padding:.6rem .75rem;border-radius:999px;background:var(--surface);font-size:.76rem}.history-jump a[aria-current]{background:var(--ink);color:var(--bg)}
.history-reading-grid{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(2rem,6vw,7rem);align-items:start}.history-date-stage{position:sticky;top:calc(var(--compact-nav-actual-height,70px) + 20px);min-height:460px;height:min(65svh,680px);padding:clamp(1.5rem,3vw,3rem);display:flex;flex-direction:column;justify-content:space-between;background:#e6e4dc;color:#20242c;border-radius:24px;overflow:hidden}.history-date-stage>span,.history-date-stage small{font:600 .65rem var(--sans);letter-spacing:.12em}.history-date-stage strong{font:650 clamp(3.2rem,7vw,8rem)/.94 var(--sans);letter-spacing:-.07em;overflow-wrap:anywhere}.history-date-stage p{font-size:clamp(1.2rem,2.2vw,2rem);line-height:1.1;max-width:18ch}.history-reading-chapter{min-height:65svh;padding:2rem 0 4rem;border-top:1px solid var(--line);scroll-margin-top:calc(var(--compact-nav-actual-height,70px) + 20px)}.history-chapter-number{display:flex;justify-content:space-between;color:var(--muted);font-size:.75rem}.history-reading-chapter h2{font-size:clamp(2.4rem,4vw,4.6rem);letter-spacing:-.055em;line-height:.98;margin:1.25rem 0}.history-reading-chapter>p{font-size:clamp(1.05rem,1.4vw,1.2rem);line-height:1.75;max-width:62ch;color:var(--muted)}.history-evidence{display:grid;gap:.7rem;margin-top:2rem}.history-evidence>span{font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted)}.history-evidence a{display:grid;gap:.25rem;padding:.7rem 0;border-bottom:1px solid var(--line)}.history-evidence small{font-size:.72rem;color:var(--muted)}.history-evidence strong{font-size:.9rem;font-weight:550}.history-continue{padding-block:3rem;border-top:1px solid var(--line)}.history-continue h2{font-size:clamp(2.5rem,6vw,6rem);letter-spacing:-.06em;line-height:1}.history-continue .chip{margin:.5rem .5rem 0 0}
@media(max-width:760px){.history-reading-grid{display:block}.history-date-stage{display:none}.history-reading-chapter{min-height:0;padding:2rem 0 3rem}.history-jump{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none}.history-jump a{flex:none}.history-reading-chapter h2{font-size:clamp(2.5rem,10vw,4rem)}}
@media(prefers-reduced-motion:reduce){.history-reader{scroll-behavior:auto}}
</style>
<script>
 const chapters=[...document.querySelectorAll<HTMLElement>('[data-history-chapter]')];
 const observer=new IntersectionObserver(entries=>{const active=entries.filter(e=>e.isIntersecting).sort((a,b)=>a.boundingClientRect.top-b.boundingClientRect.top)[0]?.target as HTMLElement|undefined;if(!active)return;for(const [selector,value] of [['[data-history-year]',active.dataset.year],['[data-history-title]',active.dataset.title],['[data-history-progress]',`${String(active.dataset.index).padStart(2,'0')} / ${String(chapters.length).padStart(2,'0')}`]]){const el=document.querySelector(selector!);if(el)el.textContent=value||''}document.querySelectorAll('.history-jump a').forEach(a=>{if(a.getAttribute('href')===`#${active.id}`)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current')})},{rootMargin:'-20% 0px -55% 0px'});chapters.forEach(c=>observer.observe(c));
</script>

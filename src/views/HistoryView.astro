---
import BaseLayout from '../layouts/BaseLayout.astro';import { historyChapters } from '../data/history';import { sourceById } from '../data/sources';import { t } from '../lib/i18n';import type { Locale } from '../data/types';
const {locale='en'}=Astro.props as {locale?:Locale};
---
<BaseLayout locale={locale} active="history" title={locale==='en'?'History':'Sejarah'}>
<section class="section history-page"><div class="wrap"><h1 class="page-title history-page-title">{locale==='en'?'West Papua, 1961 to today':'Papua Barat, 1961 sampai sekarang'}</h1>

<div class="history-mobile-narrative" data-history-mobile>
  <div class="history-stage-shell" data-history-stage-shell>
    <div class="history-stage" data-history-stage aria-hidden="true">
      <div class="history-stage-label"><span data-history-stage-count>{String(1).padStart(2,'0')} / {String(historyChapters.length).padStart(2,'0')}</span><span data-history-stage-year>{historyChapters[0].year}</span></div>
      {historyChapters.map((c,i)=> c.visual==='document'
        ? <div class:list={['history-frame','history-document',i===0&&'is-current']} data-history-frame={String(i)}><div class="history-paper"><div class="history-stamp">{c.year}</div>{[82,64,90,72,58,86,68].map(w=><div class="history-line" style={`width:${w}%`}></div>)}</div></div>
        : c.visual==='split'
        ? <div class:list={['history-frame','history-split',i===0&&'is-current']} data-history-frame={String(i)}><div><span>institutional record</span></div><div><span>Papuan accounts / scholarship</span></div><b>{c.year}</b></div>
        : <div class:list={['history-frame','history-map',i===0&&'is-current']} data-history-frame={String(i)}><div class="history-island"></div><i class="history-node" style="left:29%;top:54%"></i><i class="history-node" style="left:48%;top:50%"></i><i class="history-node" style="left:65%;top:57%"></i><b>{c.year}</b></div>)}
      <div class="history-stage-index">{historyChapters.map((c,i)=><span class:list={[i===0&&'active']} data-history-dot={String(i)}>{c.year}</span>)}</div>
    </div>
    <div class="history-copy">{historyChapters.map((c,i)=><article class="history-chapter" data-history-chapter={String(i)} data-history-year={c.year}><div class="history-year">{c.year}</div><h2>{t(c.title,locale)}</h2><p>{t(c.body,locale)}</p><div class="history-sources">{c.sourceIds.map(id=>sourceById[id]?.publisher).filter(Boolean).join(' · ')}</div></article>)}</div>
  </div>
</div>

<div class="history-desktop-spreads">
  {historyChapters.map((c,i)=><article class:list={['history-spread',i%2===1&&'is-reverse']}>
    <div class="history-stage history-spread-stage" aria-hidden="true">
      <div class="history-stage-label"><span>{String(i+1).padStart(2,'0')} / {String(historyChapters.length).padStart(2,'0')}</span><span>{c.year}</span></div>
      {c.visual==='document'
        ? <div class="history-frame history-document is-current"><div class="history-paper"><div class="history-stamp">{c.year}</div>{[82,64,90,72,58,86,68].map(w=><div class="history-line" style={`width:${w}%`}></div>)}</div></div>
        : c.visual==='split'
        ? <div class="history-frame history-split is-current"><div><span>institutional record</span></div><div><span>Papuan accounts / scholarship</span></div><b>{c.year}</b></div>
        : <div class="history-frame history-map is-current"><div class="history-island"></div><i class="history-node" style="left:29%;top:54%"></i><i class="history-node" style="left:48%;top:50%"></i><i class="history-node" style="left:65%;top:57%"></i><b>{c.year}</b></div>}
    </div>
    <div class="history-spread-copy"><div class="history-year">{c.year}</div><h2>{t(c.title,locale)}</h2><p>{t(c.body,locale)}</p><div class="history-sources">{c.sourceIds.map(id=>sourceById[id]?.publisher).filter(Boolean).join(' · ')}</div></div>
  </article>)}
</div>
</div></section>
<script>
  const mobile=document.querySelector<HTMLElement>('[data-history-mobile]');
  const historyFrames=[...(mobile?.querySelectorAll<HTMLElement>('[data-history-frame]')||[])];
  const chapters=[...(mobile?.querySelectorAll<HTMLElement>('[data-history-chapter]')||[])];
  const dots=[...(mobile?.querySelectorAll<HTMLElement>('[data-history-dot]')||[])];
  const year=mobile?.querySelector<HTMLElement>('[data-history-stage-year]');
  const count=mobile?.querySelector<HTMLElement>('[data-history-stage-count]');
  const stage=mobile?.querySelector<HTMLElement>('[data-history-stage]');
  const shell=mobile?.querySelector<HTMLElement>('[data-history-stage-shell]');
  if(historyFrames.length&&chapters.length){
    const activate=(index:number)=>{historyFrames.forEach((frame,i)=>{frame.classList.toggle('is-current',i===index);frame.classList.toggle('is-past',i<index)});dots.forEach((dot,i)=>dot.classList.toggle('active',i===index));if(year)year.textContent=chapters[index]?.dataset.historyYear||'';if(count)count.textContent=`${String(index+1).padStart(2,'0')} / ${String(chapters.length).padStart(2,'0')}`};
    const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting)activate(Number((entry.target as HTMLElement).dataset.historyChapter||0))}),{rootMargin:'-38% 0px -43% 0px',threshold:0});
    chapters.forEach(chapter=>observer.observe(chapter));
  }
  let historyRaf=0;
  const updateHistoryMorph=()=>{
    historyRaf=0;if(!stage||!shell||innerWidth>760)return;
    const compact=document.querySelector<HTMLElement>('[data-compact-nav]');const links=compact?.querySelector<HTMLElement>('.compact-links');
    const stickyTop=(compact?.offsetHeight||58)+(links?.offsetHeight||0);
    const rect=shell.getBoundingClientRect();const distance=Math.max(180,innerHeight*.28);
    const progress=Math.max(0,Math.min(1,(stickyTop-rect.top)/distance));
    stage.style.setProperty('--history-sticky-top',`${stickyTop}px`);
    stage.style.setProperty('--history-inset',`${15*(1-progress)}px`);
    stage.style.setProperty('--history-radius',`${24*(1-progress)}px`);
    stage.style.setProperty('--history-height',`${34+12*progress}svh`);
    stage.style.setProperty('--history-shadow',String(.16+.18*progress));
  };
  const queueHistoryMorph=()=>{if(!historyRaf)historyRaf=requestAnimationFrame(updateHistoryMorph)};
  addEventListener('scroll',queueHistoryMorph,{passive:true});addEventListener('resize',queueHistoryMorph,{passive:true});queueHistoryMorph();
</script>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';import type { Locale } from '../data/types';const {locale='en'}=Astro.props as {locale?:Locale};
---
<BaseLayout locale={locale} active="now" title={locale==='en'?'Development':'Perkembangan'}><section class="story-page" data-story-page data-locale={locale}><div class="wrap story-wrap"><a class="story-back" href={locale==='pmy'?'/pmy/':'/'}>← {locale==='en'?'Current':'Sekarang'}</a><div class="story-loading" data-story-loading>{locale==='en'?'Loading development…':'Memuat perkembangan…'}</div><article hidden data-story-content><div class="story-kicker" data-story-kicker></div><h1 data-story-title></h1><p class="story-dek" data-story-summary></p><div class="story-meta-line" data-story-meta></div><div class="story-relations" data-story-relations hidden></div><figure class="story-figure" hidden data-story-figure><img data-story-image alt=""/><figcaption><a data-story-image-source target="_blank" rel="noreferrer"></a></figcaption></figure><section class="story-block" hidden data-story-points><span>{locale==='en'?'At a glance':'Poin utama'}</span><ul></ul></section><section class="story-block" hidden data-story-changed><span>{locale==='en'?'What changed':'Apa yang berubah'}</span><p></p></section><section class="story-block" hidden data-story-common><span>{locale==='en'?'Across sources':'Dari beberapa sumber'}</span><ul></ul></section><section class="story-sources"><div class="story-section-head"><span>{locale==='en'?'Latest reports':'Laporan terbaru'}</span><strong data-story-source-count></strong></div><div data-story-sources></div></section></article><div class="story-error" hidden data-story-error></div></div></section>
<script>
const page=document.querySelector<HTMLElement>('[data-story-page]');if(page){const locale=page.dataset.locale==='pmy'?'pmy':'en',id=new URL(location.href).searchParams.get('id'),loading=page.querySelector<HTMLElement>('[data-story-loading]'),content=page.querySelector<HTMLElement>('[data-story-content]'),error=page.querySelector<HTMLElement>('[data-story-error]');const put=(n:any,v:any)=>{if(n)n.textContent=String(v||'')},list=(v:any)=>{if(Array.isArray(v))return v;try{return JSON.parse(String(v||'[]'))}catch{return[]}},date=(v:string)=>v?new Date(v).toLocaleDateString(locale==='pmy'?'id-ID':'en-GB',{day:'numeric',month:'short',year:'numeric'}):'';if(!id||!/^\d+$/.test(id)){loading.hidden=true;error.hidden=false;put(error,locale==='pmy'?'Perkembangan ini tidak ditemukan.':'This development was not found.')}else fetch(`/api/development/${id}`).then(async r=>{const d=await r.json();if(!r.ok)throw new Error(d.error||'Unavailable');return d}).then(data=>{loading.hidden=true;content.hidden=false;const d=data.development||{},s=data.synthesis||{},articles=data.articles||[],issues=data.issues||[],places=data.places||[];put(page.querySelector('[data-story-kicker]'),issues[0]?.category||String(d.issue_slug||'Development').replaceAll('-',' '));put(page.querySelector('[data-story-title]'),locale==='pmy'?(d.title_id||d.title_en):d.title_en);put(page.querySelector('[data-story-summary]'),locale==='pmy'?(d.summary_id||d.summary_en):d.summary_en);const publishers=new Set(articles.filter((a:any)=>!a.syndicated_from_article_id).map((a:any)=>a.publisher_id||a.publisher));const meta=page.querySelector<HTMLElement>('[data-story-meta]');if(meta)meta.textContent=`${articles.length} ${locale==='pmy'?'laporan':'reports'} · ${publishers.size||articles.length} ${locale==='pmy'?'sumber':'sources'}${d.updated_at?` · ${locale==='pmy'?'diperbarui':'updated'} ${date(d.updated_at)}`:''}`;
const relations=page.querySelector<HTMLElement>('[data-story-relations]');if(relations){relations.replaceChildren();for(const issue of issues.slice(0,3)){const a=document.createElement('a');a.className='chip';a.href=`${locale==='pmy'?'/pmy':''}/issues/${issue.slug}/`;a.textContent=locale==='pmy'?(issue.title_id||issue.title_en):issue.title_en;relations.append(a)}for(const place of places.slice(0,3)){const span=document.createElement('span');span.className='chip';span.textContent=place.name;relations.append(span)}relations.hidden=relations.children.length===0}
const points=locale==='pmy'?(s.key_points?.id||list(s.key_points_id_json)):(s.key_points?.en||list(s.key_points_en_json));const pointEl=page.querySelector<HTMLElement>('[data-story-points]');if(points?.length&&pointEl){pointEl.hidden=false;const ul=pointEl.querySelector('ul');for(const x of points.slice(0,5)){const li=document.createElement('li');li.textContent=String(x);ul?.append(li)}}const changed=page.querySelector<HTMLElement>('[data-story-changed]');const changedText=locale==='pmy'?(s.what_changed_id||s.what_changed):s.what_changed;if(changedText){changed.hidden=false;put(changed.querySelector('p'),changedText)}const common=list(s.common_ground_json),commonEl=page.querySelector<HTMLElement>('[data-story-common]');if(common.length&&publishers.size>1){commonEl.hidden=false;const ul=commonEl.querySelector('ul');for(const x of common){const li=document.createElement('li');li.textContent=String(x);ul?.append(li)}}
put(page.querySelector('[data-story-source-count]'),`${publishers.size||articles.length} ${locale==='pmy'?'sumber':'sources'}`);const out=page.querySelector<HTMLElement>('[data-story-sources]');for(const a of articles){const link=document.createElement('a');link.className='story-source';link.href=a.canonical_url;link.target='_blank';link.rel='noreferrer';const meta=document.createElement('span');meta.textContent=`${a.publisher} · ${String(a.role||'source').replaceAll('_',' ')}${a.published_at?' · '+date(a.published_at):''}`;const h=document.createElement('strong');h.textContent=a.title;const p=document.createElement('p');p.textContent=a.what_changed||a.packet_summary||a.summary||'';link.append(meta,h,p);out?.append(link)}const ia=articles.find((a:any)=>a.image_url);if(ia){const fig=page.querySelector<HTMLElement>('[data-story-figure]'),img=fig?.querySelector<HTMLImageElement>('img'),a=fig?.querySelector<HTMLAnchorElement>('a');if(fig&&img&&a){fig.hidden=false;img.src=ia.image_url;img.alt=ia.title;a.href=ia.image_source_url||ia.canonical_url;a.textContent=`${locale==='pmy'?'Gambar':'Image'}: ${ia.image_credit||ia.publisher} ↗`;img.addEventListener('error',()=>fig.hidden=true,{once:true})}}}).catch(e=>{loading.hidden=true;error.hidden=false;put(error,e instanceof Error?e.message:'Unavailable')})}
</script><style>.story-page{padding:2rem 0 6rem}.story-wrap{max-width:1080px}.story-back{display:inline-block;color:var(--muted);margin-bottom:4rem}.story-loading,.story-error{color:var(--muted);font-size:1.1rem;padding:5rem 0}.story-kicker,.story-block>span,.story-section-head span{font-size:.7rem;text-transform:uppercase;letter-spacing:.16em;color:var(--muted);font-weight:650}.story-page h1{font-size:clamp(3.4rem,8vw,7.6rem);line-height:.88;letter-spacing:-.07em;margin:.8rem 0 1.3rem;max-width:1000px}.story-dek{font-size:clamp(1.15rem,2vw,1.45rem);line-height:1.45;color:#b8bbc8;max-width:800px;margin:0 0 1rem}.story-meta-line{font-size:.78rem;color:var(--muted);margin-bottom:1.1rem}.story-relations{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:2.6rem}.story-figure{margin:0 0 3rem}.story-figure img{width:100%;max-height:70vh;object-fit:cover;border-radius:var(--radius-lg);border:1px solid var(--line)}.story-figure figcaption{padding:.65rem .15rem;color:var(--muted);font-size:.75rem}.story-block{display:grid;grid-template-columns:180px minmax(0,1fr);gap:2rem;border-top:1px solid var(--line);padding:1.4rem 0}.story-block p,.story-block ul{margin:0;font-size:1.05rem;color:var(--ink-soft);line-height:1.55}.story-block ul{padding-left:1.2rem}.story-sources{margin-top:3.5rem;border-top:1px solid var(--line-strong)}.story-section-head{display:flex;justify-content:space-between;padding:1.2rem 0}.story-source{display:grid;grid-template-columns:180px minmax(0,1fr);gap:1.5rem;padding:1.35rem 0;border-top:1px solid var(--line)}.story-source span{font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}.story-source strong{font-size:clamp(1.25rem,2.5vw,2rem);line-height:1}.story-source p{grid-column:2;color:var(--muted);margin:0;max-width:720px}@media(max-width:700px){.story-back{margin-bottom:2.5rem}.story-block,.story-source{grid-template-columns:1fr;gap:.65rem}.story-source p{grid-column:1}.story-page h1{font-size:clamp(3rem,14vw,5.2rem)}}</style></BaseLayout>

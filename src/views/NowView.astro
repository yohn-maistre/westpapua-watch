---
import BaseLayout from '../layouts/BaseLayout.astro';import DevelopmentCard from '../components/DevelopmentCard.astro';import { developments } from '../data/developments';import { sourceById } from '../data/sources';import { topicTagBySlug } from '../data/taxonomy';import { t,withLocale } from '../lib/i18n';import type { Locale } from '../data/types';
const {locale='en'}=Astro.props as {locale?:Locale};const featured=developments.find(d=>d.featured)??developments[0];const secondary=developments.filter(d=>d!==featured).slice(0,3);const leadSources=featured.sourceIds.map(id=>sourceById[id]).filter(Boolean);const fallbackReports=developments.slice(0,4);const fallbackTagSlugs=['environment-biodiversity','land-indigenous-rights','economy-livelihoods'];
const topicLabels=Object.fromEntries(Object.entries(topicTagBySlug).map(([slug,tag]:[string,any])=>[slug,tag?.label?.[locale==='pmy'?'id':'en']||slug]));
---
<BaseLayout locale={locale} active="current" description={locale==='en'?'Current clustered developments in West Papua.':'Perkembangan terkelompok terbaru di Papua Barat.'}>
<div class="wrap"><div class="now-header now-header-minimal"><span class="now-date" data-current-date></span><span class="current-live-state" data-current-live hidden></span></div>
<section class="hero hero-composite" data-current-hero data-locale={locale}>
  <div class="hero-media"><img data-current-image src={featured.image} data-fallback={featured.image} alt={featured.imageAlt} width="1600" height="1000" fetchpriority="high"/><div class="hero-media-fade">
    <div class="story-meta"><span data-current-category>{featured.category}</span><span>·</span><span data-current-place>{featured.place}</span><a data-current-sources href={withLocale(`/issues/${featured.issueSlug}/#sources`,locale)}>{leadSources.length} {locale==='en'?'sources':'sumber'}</a><span data-current-published></span></div>
    <h2 class="hero-title" data-current-title>{t(featured.title,locale)}</h2><a class="hero-image-credit" data-current-image-credit hidden target="_blank" rel="noreferrer"></a>
  </div></div>
  <div class="hero-below"><p class="hero-summary" data-current-summary>{t(featured.summary,locale)}</p><div class="development-live-meta" data-current-live-meta hidden></div><div class="actions">
    <a class="chip primary" data-current-story hidden>{locale==='en'?'Read story':'Baca cerita'}</a><a class="chip" data-current-issue href={withLocale(`/issues/${featured.issueSlug}/`,locale)}>{locale==='en'?'Open dossier':'Buka dossier'}</a>
    <div class="current-topic-tags" data-current-topic-tags data-topic-labels={JSON.stringify(topicLabels)}>{fallbackTagSlugs.map(slug=><span class="chip topic-chip">{topicLabels[slug]}</span>)}</div>
  </div></div>
</section>
<section class="signal" aria-label="Latest reports" data-live-signals><div class="eyebrow">{locale==='en'?'Latest reports':'Laporan terbaru'}</div>{fallbackReports.map((s,i)=><div class="signal-row"><time>{['18:42','17:20','15:13','12:06'][i]}</time><strong>{t(s.title,locale)}</strong><span>{s.category}</span></div>)}</section></div>
<section class="section current-all"><div class="wrap"><div class="card-grid" data-live-development-grid>{secondary.map(item=><DevelopmentCard item={item} locale={locale}/>)}</div><div class="current-load-more-wrap"><button class="current-load-more" type="button" data-current-load-more hidden>{locale==='en'?'Load more':'Muat lagi'}</button></div></div></section>
<script>
const hero=document.querySelector<HTMLElement>('[data-current-hero]');
if(hero){
 const locale=hero.dataset.locale==='pmy'?'pmy':'en',pick=(v:any)=>typeof v==='object'?(locale==='pmy'?(v?.pmy||v?.id||v?.en):(v?.en||v?.id||'')):String(v||'');
 const fmt=(iso:string)=>iso?new Date(iso).toLocaleDateString(locale==='pmy'?'id-ID':'en-GB',{day:'numeric',month:'short',year:'numeric'}):'';
 const relative=(iso:string)=>{if(!iso)return'';const m=Math.max(0,Math.round((Date.now()-new Date(iso).getTime())/60000));return m<1?(locale==='pmy'?'baru saja':'just now'):m<60?`${m}m`:m<1440?`${Math.floor(m/60)}h`:`${Math.floor(m/1440)}d`};
 const fallbackFor=(x:any)=>x.issue_slug?.includes('raja')?'/images/abstract/raja-ampat.svg':x.issue_slug?.includes('south-papua')?'/images/abstract/merauke.svg':x.issue_slug?.includes('conflict')?'/images/abstract/highlands.svg':'/images/abstract/oceanic.svg';
 const grid=document.querySelector<HTMLElement>('[data-live-development-grid]'),more=document.querySelector<HTMLButtonElement>('[data-current-load-more]');let nextPage=2,busy=false;
 const makeCard=(x:any)=>{const a=document.createElement('a');a.className='development-card';a.href=`${locale==='pmy'?'/pmy':''}${x.story_url}`;const media=document.createElement('div');media.className='media';const img=document.createElement('img'),fb=fallbackFor(x);img.src=x.image?.url||fb;img.alt=pick(x.title);img.loading='lazy';img.onerror=()=>{img.onerror=null;img.src=fb};media.append(img);const body=document.createElement('div');body.className='body';const eyebrow=document.createElement('div');eyebrow.className='eyebrow';eyebrow.textContent=[x.category,x.place].filter(Boolean).join(' · ');const h=document.createElement('h3');h.textContent=pick(x.title);const p=document.createElement('p');p.textContent=pick(x.summary);const m=document.createElement('div');m.className='development-live-meta';m.textContent=`${x.source_count||1} ${locale==='pmy'?'sumber':'sources'}${x.latest_report_at?` · ${locale==='pmy'?'terbit':'published'} ${fmt(x.latest_report_at)}`:''}`;body.append(eyebrow,h,p,m);a.append(media,body);return a};
 const loadPage=async(page:number,append=false)=>{const r=await fetch(`/api/current?page=${page}&limit=12`,{headers:{accept:'application/json'}});if(!r.ok)throw new Error('Current unavailable');const data=await r.json(),items=data?.items||[];if(page===1&&items.length){const item=items[0],set=(s:string,v:any)=>{const n=hero.querySelector<HTMLElement>(s);if(n&&v)n.textContent=String(v)};set('[data-current-title]',pick(item.title));set('[data-current-summary]',pick(item.summary));set('[data-current-category]',item.category||'Current');set('[data-current-place]',item.place||'West Papua');set('[data-current-published]',item.latest_report_at?`${locale==='pmy'?'terbit':'published'} ${fmt(item.latest_report_at)}`:'');const date=document.querySelector<HTMLElement>('[data-current-date]');if(date)date.textContent=item.latest_report_at?fmt(item.latest_report_at):'';const live=document.querySelector<HTMLElement>('[data-current-live]');if(live&&data.meta?.last_checked){live.hidden=false;live.textContent=`${locale==='pmy'?'dicek':'checked'} ${relative(data.meta.last_checked)} ${locale==='pmy'?'lalu':'ago'}`};const src=hero.querySelector<HTMLAnchorElement>('[data-current-sources]');if(src)src.textContent=`${item.source_count||1} ${locale==='pmy'?'sumber':'sources'}`;const story=hero.querySelector<HTMLAnchorElement>('[data-current-story]');if(story){story.hidden=false;story.href=`${locale==='pmy'?'/pmy':''}${item.story_url}`};const issue=hero.querySelector<HTMLAnchorElement>('[data-current-issue]');if(issue){issue.hidden=!item.issue_slug;if(item.issue_slug)issue.href=`${locale==='pmy'?'/pmy':''}/issues/${item.issue_slug}/`};const tagBox=hero.querySelector<HTMLElement>('[data-current-topic-tags]');if(tagBox){let labels:Record<string,string>={};try{labels=JSON.parse(tagBox.dataset.topicLabels||'{}')}catch{}const tags=Array.isArray(item.tags)?item.tags.slice(0,4):[];tagBox.replaceChildren();for(const slug of tags){const chip=document.createElement('span');chip.className='chip topic-chip';chip.textContent=labels[slug]||String(slug).replaceAll('-',' ');tagBox.append(chip)}tagBox.hidden=tags.length===0};const meta=hero.querySelector<HTMLElement>('[data-current-live-meta]');if(meta){meta.hidden=false;meta.textContent=`${item.article_count||1} ${locale==='pmy'?'laporan':'reports'} · ${item.source_count||1} ${locale==='pmy'?'sumber':'sources'}`};const image=hero.querySelector<HTMLImageElement>('[data-current-image]'),credit=hero.querySelector<HTMLAnchorElement>('[data-current-image-credit]');if(image){const fb=fallbackFor(item);image.src=item.image?.url||fb;image.alt=pick(item.title);image.onerror=()=>{image.onerror=null;image.src=fb;if(credit)credit.hidden=true}}if(credit&&item.image?.source_url){credit.hidden=false;credit.href=item.image.source_url;credit.textContent=item.image.credit?`Image: ${item.image.credit} ↗`:'Image source ↗'};const signal=document.querySelector<HTMLElement>('[data-live-signals]');if(signal){const eyebrow=signal.querySelector('.eyebrow');signal.replaceChildren(eyebrow!);for(const rep of (data.lead_reports||[]).slice(0,6)){const row=document.createElement('div');row.className='signal-row';const time=document.createElement('time');time.textContent=relative(rep.published_at||rep.fetched_at);const strong=document.createElement('strong');strong.textContent=rep.title;const publisher=document.createElement('span');publisher.textContent=rep.publisher||'source';row.append(time,strong,publisher);row.setAttribute('role','link');row.tabIndex=0;const open=()=>window.open(rep.canonical_url,'_blank','noopener');row.addEventListener('click',open);row.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();open()}});signal.append(row)}}}
   if(grid){if(!append)grid.replaceChildren();const start=page===1?1:0;for(const x of items.slice(start))grid.append(makeCard(x))}
   nextPage=data?.pagination?.next_page||page+1;if(more)more.hidden=!data?.pagination?.has_more;
   return data;
 };
 loadPage(1).catch(()=>{});
 more?.addEventListener('click',async()=>{if(busy)return;busy=true;more.disabled=true;try{await loadPage(nextPage,true)}finally{busy=false;more.disabled=false}});
}
</script>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';import DevelopmentCard from '../components/DevelopmentCard.astro';import { developments } from '../data/developments';import { sourceById } from '../data/sources';import { topicTagBySlug } from '../data/taxonomy';import { t,withLocale } from '../lib/i18n';import type { Locale } from '../data/types';import newsSources from '../../content/news-sources.json';
const {locale='en'}=Astro.props as {locale?:Locale};const featured=developments.find(d=>d.featured)??developments[0];const secondary=developments.filter(d=>d!==featured).slice(0,3);const leadSources=featured.sourceIds.map(id=>sourceById[id]).filter(Boolean);const fallbackReports=developments.slice(0,4);const fallbackTagSlugs=['environment-biodiversity','land-indigenous-rights','economy-livelihoods'];
const sourceGroups=[{label:locale==='en'?'Papuan media':'Media Papua',roles:['local_newsroom','alternative_media','movement_media'],ids:['papuan-voices']},{label:locale==='en'?'Independent & Pacific':'Independen & Pasifik',roles:['environmental_newsroom','investigative_newsroom','public_service_media'],ids:[]},{label:locale==='en'?'Civil society':'Masyarakat sipil',roles:['civil_society','monitoring_org'],ids:[]},{label:locale==='en'?'Public & state media':'Media publik & negara',roles:['state_public_media','state_media'],ids:[]}].map(group=>({...group,sources:newsSources.filter(source=>source.enabled&&(group.ids.includes(source.id)||(group.roles.includes(source.role)&&!['papuan-voices'].includes(source.id))))}));
const topicLabels=Object.fromEntries(Object.entries(topicTagBySlug).map(([slug,tag]:[string,any])=>[slug,tag?.label?.[locale==='pmy'?'id':'en']||slug]));
---
<BaseLayout locale={locale} active="current" description={locale==='en'?'Current clustered developments in West Papua.':'Perkembangan terkelompok terbaru di Papua Barat.'}>
<div class="wrap"><div class="now-header now-header-minimal"><button class="news-sources-trigger" type="button" data-news-sources-open aria-haspopup="dialog">{locale==='en'?'Sources':'Sumber'}</button><span class="current-live-state" data-current-live role="status">{locale==='en'?'Loading news…':'Memuat berita…'}</span></div>
<dialog class="news-sources-dialog" data-news-sources-dialog aria-labelledby="news-sources-title"><div class="news-sources-inner"><div class="news-sources-head"><h2 id="news-sources-title">{locale==='en'?'Sources.':'Sumber.'}</h2><button type="button" data-news-sources-close aria-label={locale==='en'?'Close sources':'Tutup sumber'}>×</button></div><p>{locale==='en'?'Outlets and organizations in the Watch’s news source list. Each story names the reports it uses.':'Media dan organisasi dalam daftar sumber berita Watch. Tiap cerita mencantumkan laporan yang digunakan.'}</p><div class="news-sources-groups">{sourceGroups.map(group=><section><h3>{group.label}</h3><div>{group.sources.map(source=><a href={source.homepage} target="_blank" rel="noreferrer"><span>{source.name}</span><span aria-hidden="true">↗</span></a>)}</div></section>)}</div></div></dialog>
<section class="hero hero-composite is-loading" aria-busy="true" inert data-current-hero data-locale={locale}>
  <div class="hero-media"><img data-current-image alt="" width="1600" height="1000" fetchpriority="high"/><div class="hero-media-fade">
    <div class="story-meta"><span data-current-category></span><span>·</span><span data-current-place></span><a data-current-sources href={withLocale(`/topics/${featured.issueSlug}/#sources`,locale)}>{leadSources.length} {locale==='en'?'sources':'sumber'}</a><span data-current-published></span></div>
    <h2 class="hero-title" data-current-title></h2><a class="hero-image-credit" data-current-image-credit hidden target="_blank" rel="noreferrer"></a>
  </div></div>
  <div class="hero-below"><p class="hero-summary" data-current-summary></p><div class="development-live-meta" data-current-live-meta hidden></div><div class="actions">
    <a class="chip primary" data-current-story hidden>{locale==='en'?'Read story':'Baca cerita'}</a><a class="chip" data-current-issue href={withLocale(`/topics/${featured.issueSlug}/`,locale)}>{locale==='en'?'Read background':'Baca latar belakang'}</a>
    <div class="current-topic-tags" data-current-topic-tags data-topic-labels={JSON.stringify(topicLabels)}>{fallbackTagSlugs.map(slug=><span class="topic-chip">{topicLabels[slug]}</span>)}</div>
  </div></div>
</section>
<section class="signal" hidden aria-label="Latest reports" data-live-signals><div class="eyebrow">{locale==='en'?'Latest reports':'Laporan terbaru'}</div>{[].map((s:any,i)=><div class="signal-row"><time>{s.updatedAt}</time><strong>{t(s.title,locale)}</strong><span>{s.category}</span></div>)}</section></div>
<section class="section current-all"><div class="wrap"><div class="card-grid" data-live-development-grid></div><div class="current-load-more-wrap"><button class="current-load-more" type="button" data-current-load-more hidden>{locale==='en'?'Load more':'Muat lagi'}</button></div></div></section>
<script>
import {fetchJSON} from '../lib/http';
const hero=document.querySelector<HTMLElement>('[data-current-hero]');
if(hero){
 const sourcesDialog=document.querySelector<HTMLDialogElement>('[data-news-sources-dialog]');document.querySelector<HTMLButtonElement>('[data-news-sources-open]')?.addEventListener('click',()=>sourcesDialog?.showModal());sourcesDialog?.querySelector<HTMLButtonElement>('[data-news-sources-close]')?.addEventListener('click',()=>sourcesDialog.close());sourcesDialog?.addEventListener('click',event=>{if(event.target===sourcesDialog)sourcesDialog.close()});
 const locale=hero.dataset.locale==='pmy'?'pmy':'en',pick=(v:any)=>typeof v==='object'?(locale==='pmy'?(v?.pmy||v?.id||v?.en):(v?.en||v?.id||'')):String(v||'');
 const fmt=(iso:string)=>iso?new Date(iso).toLocaleDateString(locale==='pmy'?'id-ID':'en-GB',{day:'numeric',month:'short',year:'numeric'}):'';
 const relative=(iso:string)=>{if(!iso)return'';const m=Math.max(0,Math.round((Date.now()-new Date(iso).getTime())/60000));return m<1?(locale==='pmy'?'baru saja':'just now'):m<60?`${m}m`:m<1440?`${Math.floor(m/60)}h`:`${Math.floor(m/1440)}d`};
 const fallback='/images/abstract/watch-wash.svg';
 const grid=document.querySelector<HTMLElement>('[data-live-development-grid]'),more=document.querySelector<HTMLButtonElement>('[data-current-load-more]');let nextPage=2,busy=false;const seen=new Set<number>();
 const makeCard=(x:any)=>{const a=document.createElement('a');a.className='development-card';a.href=`${locale==='pmy'?'/id':''}${x.story_url}`;const media=document.createElement('div');media.className='media';const img=document.createElement('img');img.src=x.image?.url||fallback;img.alt=x.image?.url?pick(x.title):'';img.loading='lazy';img.onerror=()=>{img.onerror=null;img.alt='';img.src=fallback};media.append(img);const body=document.createElement('div');body.className='body';const eyebrow=document.createElement('div');eyebrow.className='eyebrow';eyebrow.textContent=[x.category,x.place].filter(Boolean).join(' · ');const h=document.createElement('h3');h.textContent=pick(x.title);const p=document.createElement('p');p.textContent=pick(x.summary);const m=document.createElement('div');m.className='development-live-meta';m.textContent=`${x.article_count||1} ${locale==='pmy'?'laporan':'reports'} · ${x.source_count||1} ${locale==='pmy'?'sumber':'sources'}${x.latest_report_at?` · ${locale==='pmy'?'terbit':'published'} ${fmt(x.latest_report_at)}`:''}`;body.append(eyebrow,h,p,m);a.append(media,body);return a};
 const loadPage=async(page:number,append=false)=>{const data=await fetchJSON(`/api/current?page=${page}&limit=12`),items=data?.items||[];if(page===1&&items.length){const item=items[0],set=(s:string,v:any)=>{const n=hero.querySelector<HTMLElement>(s);if(n)n.textContent=String(v??'')};set('[data-current-title]',pick(item.title));set('[data-current-summary]',pick(item.summary));set('[data-current-category]',item.category||'News');set('[data-current-place]',item.place||'');set('[data-current-published]',item.latest_report_at?`${locale==='pmy'?'terbit':'published'} ${fmt(item.latest_report_at)}`:'');const date=document.querySelector<HTMLElement>('[data-current-date]');if(date)date.textContent=item.latest_report_at?fmt(item.latest_report_at):'';const live=document.querySelector<HTMLElement>('[data-current-live]');if(live&&data.meta?.engine_activity?.completed_at){live.hidden=false;live.title=locale==='pmy'?'Siklus mesin terakhir selesai; tanggal laporan tercantum di setiap berita.':'Last completed engine cycle; report dates appear on each story.';live.textContent=`${locale==='pmy'?'diperbarui':'updated'} ${relative(data.meta.engine_activity.completed_at)} ${locale==='pmy'?'lalu':'ago'}`};const src=hero.querySelector<HTMLAnchorElement>('[data-current-sources]');if(src){src.href=`${locale==='pmy'?'/id':''}${item.story_url}#sources`;src.textContent=`${item.source_count||1} ${locale==='pmy'?'sumber':'sources'}`;}const story=hero.querySelector<HTMLAnchorElement>('[data-current-story]');if(story){story.hidden=false;story.href=`${locale==='pmy'?'/id':''}${item.story_url}`};const issue=hero.querySelector<HTMLAnchorElement>('[data-current-issue]');if(issue){issue.hidden=!item.issue_slug;if(item.issue_slug)issue.href=`${locale==='pmy'?'/id':''}/topics/${item.issue_slug}/`};const tagBox=hero.querySelector<HTMLElement>('[data-current-topic-tags]');if(tagBox){let labels:Record<string,string>={};try{labels=JSON.parse(tagBox.dataset.topicLabels||'{}')}catch{}const tags=Array.isArray(item.tags)?item.tags.slice(0,4):[];tagBox.replaceChildren();for(const slug of tags){const chip=document.createElement('span');chip.className='topic-chip';chip.textContent=labels[slug]||String(slug).replaceAll('-',' ');tagBox.append(chip)}tagBox.hidden=tags.length===0};const meta=hero.querySelector<HTMLElement>('[data-current-live-meta]');if(meta){meta.hidden=false;meta.textContent=`${item.article_count||1} ${locale==='pmy'?'laporan':'reports'} · ${item.source_count||1} ${locale==='pmy'?'sumber':'sources'}`};const image=hero.querySelector<HTMLImageElement>('[data-current-image]'),credit=hero.querySelector<HTMLAnchorElement>('[data-current-image-credit]');if(image){image.src=item.image?.url||fallback;image.alt=item.image?.url?pick(item.title):'';image.onerror=()=>{image.onerror=null;image.alt='';image.src=fallback;if(credit)credit.hidden=true}}if(credit)credit.hidden=true;if(credit&&item.image?.url&&item.image?.source_url){credit.hidden=false;credit.href=item.image.source_url;credit.textContent=item.image.credit?`Image: ${item.image.credit} ↗`:'Image source ↗'};const signal=document.querySelector<HTMLElement>('[data-live-signals]');if(signal){signal.hidden=false;const eyebrow=signal.querySelector('.eyebrow');signal.replaceChildren(eyebrow!);for(const rep of (data.lead_reports||[]).slice(0,6)){const row=document.createElement('div');row.className='signal-row';const time=document.createElement('time');time.textContent=relative(rep.published_at||rep.fetched_at);const strong=document.createElement('strong');strong.textContent=rep.title;const publisher=document.createElement('span');publisher.textContent=rep.publisher||'source';row.append(time,strong,publisher);row.setAttribute('role','link');row.tabIndex=0;const open=()=>window.open(rep.canonical_url,'_blank','noopener');row.addEventListener('click',open);row.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();open()}});signal.append(row)}}}
   if(grid){if(!append){grid.replaceChildren();seen.clear()};const start=page===1?1:0;if(page===1&&items[0])seen.add(Number(items[0].id));for(const x of items.slice(start)){if(seen.has(Number(x.id)))continue;seen.add(Number(x.id));grid.append(makeCard(x))}}
   nextPage=data?.pagination?.next_page||page+1;if(more)more.hidden=!data?.pagination?.has_more;
   return data;
 };
 const returnKey='wpw:news-return';
 hero.closest('main')?.addEventListener('click',event=>{const target=event.target;if(!(target instanceof Element))return;const link=target.closest<HTMLAnchorElement>('a[href]');if(!link||!link.href.startsWith(location.origin))return;const destination=new URL(link.href);if(!/\/story\/$/.test(destination.pathname))return;try{sessionStorage.setItem(returnKey,JSON.stringify({from:location.pathname,to:destination.pathname+destination.search,scroll:scrollY,pages:nextPage-1,at:Date.now()}))}catch{}});
 const saved=(()=>{try{const x=JSON.parse(sessionStorage.getItem(returnKey)||'null');return x?.from===location.pathname&&Date.now()-x.at<30*60*1000?x:null}catch{return null}})();
 const restore=async()=>{if(!saved)return;try{for(let page=2;page<=Math.min(saved.pages,12);page++){const data=await loadPage(page,true);if(!data?.items?.length||!data?.pagination?.has_more)break}requestAnimationFrame(()=>requestAnimationFrame(()=>scrollTo({top:saved.scroll,behavior:'instant'})))}catch{}finally{sessionStorage.removeItem(returnKey)}};
 const live=document.querySelector<HTMLElement>('[data-current-live]');
 loadPage(1).then(data=>{if(live)live.textContent=data.items?.length?(data.meta?.engine_activity?.completed_at?`${locale==='pmy'?'Diperbarui':'Updated'} ${relative(data.meta.engine_activity.completed_at)} ${locale==='pmy'?'lalu':'ago'}`:''):(locale==='pmy'?'Belum ada berita.':'No stories yet.');if(!data.items?.length){hero.hidden=true;document.querySelector<HTMLElement>('[data-live-signals]')!.hidden=true}else void restore()}).catch(()=>{hero.hidden=true;if(live)live.textContent=locale==='pmy'?'Berita sementara tidak tersedia.':'News is temporarily unavailable.'}).finally(()=>{hero.classList.remove('is-loading');hero.inert=false;hero.setAttribute('aria-busy','false')});
 more?.addEventListener('click',async()=>{if(busy)return;busy=true;more.disabled=true;try{await loadPage(nextPage,true)}catch{if(live)live.textContent=locale==='pmy'?'Gagal memuat. Coba lagi.':'Could not load more reports. Try again.'}finally{busy=false;more.disabled=false}});
}
</script>
</BaseLayout>

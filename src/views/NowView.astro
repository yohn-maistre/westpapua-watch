---
import BaseLayout from '../layouts/BaseLayout.astro';import DevelopmentCard from '../components/DevelopmentCard.astro';import IssueCard from '../components/IssueCard.astro';import { developments } from '../data/developments';import { issues } from '../data/issues';import { sourceById } from '../data/sources';import { topicTagBySlug } from '../data/taxonomy';import { t,withLocale } from '../lib/i18n';import type { Locale } from '../data/types';
const {locale='en'}=Astro.props as {locale?:Locale};const featured=developments.find(d=>d.featured)??developments[0];const secondary=developments.filter(d=>d!==featured).slice(0,3);const leadSources=featured.sourceIds.map(id=>sourceById[id]).filter(Boolean);const fallbackReports=developments.slice(0,4);const fallbackTagSlugs=['environment-biodiversity','land-indigenous-rights','economy-livelihoods'];
const topicLabels=Object.fromEntries(Object.entries(topicTagBySlug).map(([slug,tag]:[string,any])=>[slug,tag?.label?.[locale==='pmy'?'id':'en']||slug]));
---
<BaseLayout locale={locale} active="now" description={locale==='en'?'Current developments in West Papua.':'Perkembangan terbaru di Papua Barat.'}>
<div class="wrap"><div class="now-header now-header-minimal"><span class="now-date" data-current-date>29 August 2026 · {locale==='en'?'updated':'diperbarui'} 07:00 WIT</span><span class="current-live-state" data-current-live hidden></span></div>
<section class="hero hero-composite" data-current-hero data-locale={locale}><div class="hero-media"><img data-current-image src={featured.image} data-fallback={featured.image} alt={featured.imageAlt} width="1600" height="1000" fetchpriority="high"/><div class="hero-media-fade"><div class="story-meta"><span data-current-category>{featured.category}</span><span>·</span><span data-current-place>{featured.place}</span><a data-current-sources href={withLocale(`/issues/${featured.issueSlug}/#sources`,locale)}>{leadSources.length} {locale==='en'?'sources':'sumber'}</a><span data-current-updated>{locale==='en'?'updated 25 Aug':'diperbarui 25 Agu'}</span></div><h2 class="hero-title" data-current-title>{t(featured.title,locale)}</h2><a class="hero-image-credit" data-current-image-credit hidden target="_blank" rel="noreferrer"></a></div></div><div class="hero-below"><p class="hero-summary" data-current-summary>{t(featured.summary,locale)}</p><div class="development-live-meta" data-current-live-meta hidden></div><div class="actions"><a class="chip primary" data-current-story hidden>{locale==='en'?'Read story':'Baca cerita'}</a><a class="chip" data-current-issue href={withLocale(`/issues/${featured.issueSlug}/`,locale)}>{locale==='en'?'Open issue':'Buka isu'}</a><div class="current-topic-tags" data-current-topic-tags data-topic-labels={JSON.stringify(topicLabels)}>{fallbackTagSlugs.map(slug=><span class="chip topic-chip">{topicLabels[slug]}</span>)}</div></div></div></section>
<section class="signal" aria-label="Latest reports" data-live-signals><div class="eyebrow">{locale==='en'?'Latest reports':'Laporan terbaru'}</div>{fallbackReports.map((s,i)=><div class="signal-row"><time>{['18:42','17:20','15:13','12:06'][i]}</time><strong>{t(s.title,locale)}</strong><span>{s.category}</span></div>)}</section></div>
<section class="section"><div class="wrap"><div class="section-head section-head-simple"><h2>{locale==='en'?'More developments.':'Perkembangan lain.'}</h2></div><div class="card-grid" data-live-development-grid>{secondary.map(item=><DevelopmentCard item={item} locale={locale}/>)}</div></div></section>
<section class="section"><div class="wrap"><div class="section-head section-head-simple"><h2>{locale==='en'?'Issues.':'Isu.'}</h2></div><div class="issue-grid">{issues.slice(0,6).map((item,index)=><IssueCard item={item} locale={locale} index={index}/>)}</div></div></section>
<script>
const hero=document.querySelector<HTMLElement>('[data-current-hero]');if(hero){const locale=hero.dataset.locale==='pmy'?'pmy':'en';const pick=(v:any)=>typeof v==='object'?(locale==='pmy'?(v?.pmy||v?.id||v?.en):(v?.en||v?.id||'')):String(v||'');const fmt=(iso:string)=>iso?new Date(iso).toLocaleString(locale==='pmy'?'id-ID':'en-GB',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}):'';const relative=(iso:string)=>{if(!iso)return'';const m=Math.max(0,Math.round((Date.now()-new Date(iso).getTime())/60000));return m<1?(locale==='pmy'?'baru saja':'just now'):m<60?`${m}m`:m<1440?`${Math.floor(m/60)}h`:`${Math.floor(m/1440)}d`};const fallbackFor=(x:any)=>x.issue_slug?.includes('raja')?'/images/abstract/raja-ampat.svg':x.issue_slug?.includes('south-papua')?'/images/abstract/merauke.svg':x.issue_slug?.includes('conflict')?'/images/abstract/highlands.svg':'/images/abstract/oceanic.svg';
fetch('/api/current',{headers:{accept:'application/json'}}).then(r=>r.ok?r.json():null).then(data=>{const items=data?.items||[];if(!items.length)return;const item=items[0];const set=(s:string,v:any)=>{const n=hero.querySelector<HTMLElement>(s);if(n&&v)n.textContent=String(v)};set('[data-current-title]',pick(item.title));set('[data-current-summary]',pick(item.summary));set('[data-current-category]',item.category||'Current');set('[data-current-place]',item.place||'West Papua');set('[data-current-updated]',`${locale==='pmy'?'diperbarui':'updated'} ${relative(item.updated_at)}`);const date=document.querySelector<HTMLElement>('[data-current-date]');if(date)date.textContent=fmt(item.updated_at);const live=document.querySelector<HTMLElement>('[data-current-live]');if(live&&data.meta?.last_checked){live.hidden=false;live.textContent=`${locale==='pmy'?'dicek':'checked'} ${relative(data.meta.last_checked)} ${locale==='pmy'?'lalu':'ago'}`}
const src=hero.querySelector<HTMLAnchorElement>('[data-current-sources]');if(src){src.textContent=`${item.source_count||1} ${locale==='pmy'?'sumber':'sources'}`;if(item.issue_slug)src.href=`${locale==='pmy'?'/pmy':''}/issues/${item.issue_slug}/#sources`}const story=hero.querySelector<HTMLAnchorElement>('[data-current-story]');if(story){story.hidden=false;story.href=`${locale==='pmy'?'/pmy':''}${item.story_url}`}const issue=hero.querySelector<HTMLAnchorElement>('[data-current-issue]');if(issue){issue.hidden=!item.issue_slug;if(item.issue_slug)issue.href=`${locale==='pmy'?'/pmy':''}/issues/${item.issue_slug}/`}
const tagBox=hero.querySelector<HTMLElement>('[data-current-topic-tags]');if(tagBox){let labels:Record<string,string>={};try{labels=JSON.parse(tagBox.dataset.topicLabels||'{}')}catch{}const tags=Array.isArray(item.tags)?item.tags.slice(0,3):[];tagBox.replaceChildren();for(const slug of tags){const chip=document.createElement('span');chip.className='chip topic-chip';chip.textContent=labels[slug]||String(slug).replaceAll('-',' ');tagBox.append(chip)}tagBox.hidden=tags.length===0}
const meta=hero.querySelector<HTMLElement>('[data-current-live-meta]');if(meta){meta.hidden=false;meta.replaceChildren();const a=document.createElement('span');a.textContent=`${item.article_count||1} ${locale==='pmy'?'laporan':'reports'}`;const b=document.createElement('span');b.textContent=`${item.source_count||1} ${locale==='pmy'?'sumber':'sources'}`;meta.append(a,b)}const image=hero.querySelector<HTMLImageElement>('[data-current-image]');const credit=hero.querySelector<HTMLAnchorElement>('[data-current-image-credit]');if(image){const fb=fallbackFor(item);image.src=item.image?.url||fb;image.alt=pick(item.title);image.onerror=()=>{image.onerror=null;image.src=fb;if(credit)credit.hidden=true}}if(credit){if(item.image?.source_url){credit.hidden=false;credit.href=item.image.source_url;credit.textContent=item.image.credit?`Image: ${item.image.credit} ↗`:'Image source ↗'}else credit.hidden=true}
const signal=document.querySelector<HTMLElement>('[data-live-signals]');if(signal){const eyebrow=signal.querySelector('.eyebrow');signal.replaceChildren(eyebrow!);const reports=Array.isArray(data.lead_reports)?data.lead_reports:[];for(const r of reports.slice(0,6)){const row=document.createElement('div');row.className='signal-row';const time=document.createElement('time');time.textContent=relative(r.published_at||r.fetched_at);const strong=document.createElement('strong');strong.textContent=r.title;const source=document.createElement('span');source.textContent=r.publisher||String(r.role||'source').replaceAll('_',' ');row.append(time,strong,source);row.addEventListener('click',()=>window.open(r.canonical_url,'_blank','noopener'));row.setAttribute('role','link');row.tabIndex=0;row.addEventListener('keydown',e=>{if(e.key==='Enter')window.open(r.canonical_url,'_blank','noopener')});signal.append(row)}signal.hidden=reports.length===0}
const grid=document.querySelector<HTMLElement>('[data-live-development-grid]');if(grid){grid.replaceChildren();for(const x of items.slice(1,9)){const a=document.createElement('a');a.className='development-card';a.href=`${locale==='pmy'?'/pmy':''}${x.story_url}`;const media=document.createElement('div');media.className='media';const img=document.createElement('img');const fb=fallbackFor(x);img.src=x.image?.url||fb;img.alt=pick(x.title);img.loading='lazy';img.onerror=()=>{img.onerror=null;img.src=fb};media.append(img);const body=document.createElement('div');body.className='body';const eyebrow=document.createElement('div');eyebrow.className='eyebrow';eyebrow.textContent=[x.category,x.place].filter(Boolean).join(' · ');const h=document.createElement('h3');h.textContent=pick(x.title);const p=document.createElement('p');p.textContent=pick(x.summary);const m=document.createElement('div');m.className='development-live-meta';m.textContent=`${x.source_count||1} ${locale==='pmy'?'sumber':'sources'} · ${locale==='pmy'?'diperbarui':'updated'} ${relative(x.updated_at)}`;body.append(eyebrow,h,p,m);a.append(media,body);grid.append(a)}}}).catch(()=>{})}
</script>
</BaseLayout>

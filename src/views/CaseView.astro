---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseWorkbench from '../components/investigation/CaseWorkbench';
import TopicTimeline from '../components/TopicTimeline.astro';
import MapShell from '../components/map/MapShell.astro';
import ResourceList from '../components/resources/ResourceList.astro';
import {investigativeRecord} from '../data/investigative-record';
import {caseIndex,caseRoute,caseTitles,caseCover,caseIdBySlug} from '../data/case-presentation';
import {topicTimelines} from '../data/topic-timelines';
import {libraryForTopic} from '../data/library';
import following from '../../content/following.json';
import {t,withLocale} from '../lib/i18n';
import type {Locale} from '../data/types';
const {locale='en',caseId}=Astro.props as {locale:Locale;caseId:string};const en=locale==='en';
const dossier=investigativeRecord.cases.find(c=>c.id===caseId)!;
const slug=Object.keys(caseIdBySlug).find(s=>caseIdBySlug[s]===caseId)||'';
const note=following.find(c=>c.slug===slug),cover=caseCover(caseId),title=caseTitles[caseId]||dossier.title;
const sourceIds=new Set(dossier.claimIds.flatMap(id=>investigativeRecord.claims.find(c=>c.id===id)!.evidence.map(e=>e.source)));
const resources=slug?libraryForTopic(slug):[];
const showTimeline=!!topicTimelines[slug];
---
<BaseLayout locale={locale} active="issues" title={t(title,locale)} description={t(dossier.deck,locale)}>
 <div class="wrap case-page" data-case-page={caseId} data-issue-page data-issue-slug={slug} data-locale={locale}>
  <a class="case-back" href={withLocale('/topics/#following',locale)}>← {en?'Issues':'Isu'}</a>
  <header class="case-opening"><div><h1>{t(title,locale)}</h1><p>{t(dossier.deck,locale)}</p><span class="case-opening-meta">{dossier.period} · {sourceIds.size} {en?'sources':'sumber'}</span></div>{cover&&<figure class:list={['case-cover',cover.document&&'is-document']}><a href={cover.url} target="_blank" rel="noreferrer"><img src={cover.src} width={cover.width} height={cover.height} alt={t(cover.caption,locale)} style={`object-position:${cover.position}`} fetchpriority="high"/><span aria-hidden="true">↗</span></a><figcaption>{t(cover.caption,locale)} <span>{cover.credit}</span></figcaption></figure>}</header>
  <nav class="case-page-index" aria-label={en?'On this page':'Di halaman ini'}><a href="#explore">{en?'Connections':'Keterkaitan'}</a><a href={showTimeline?'#timeline':'#records'}>{en?'Timeline':'Linimasa'}</a><a href="#documents">{en?'Documents':'Dokumen'}</a>{slug&&<><a href="#latest">{en?'News':'Berita'}</a><a href="#places">{en?'Map':'Peta'}</a></>}{resources.length>0&&<a href="#sources">{en?'Library':'Pustaka'}</a>}</nav>
  <nav class="case-switcher" aria-label={en?'Followed cases and investigative threads':'Kasus pantauan dan lintas kasus'}>{caseIndex.map(item=><a href={withLocale(item.href,locale)} aria-current={item.id===caseId?'page':undefined} data-case-link={item.id}>{item.cover&&<img src={item.cover.src} width="68" height="52" style={`object-position:${item.cover.position}`} alt="" loading="lazy"/>}<span>{t(item.title,locale)}</span></a>)}</nav>
  <CaseWorkbench client:load data={investigativeRecord} caseId={caseId} routes={caseRoute} locale={locale} chronology={showTimeline}>{showTimeline&&<TopicTimeline slug={slug} locale={locale} compact/>}</CaseWorkbench>
  <noscript><section class="case-no-script"><h2>{en?'Records and sources':'Catatan dan sumber'}</h2>{dossier.body.map(p=><p>{t(p.text,locale)}</p>)}{dossier.claimIds.map(id=>{const c=investigativeRecord.claims.find(x=>x.id===id)!;return <article><h3>{c.date} · {t(c.title,locale)}</h3><p>{t(c.text,locale)}</p>{c.evidence.map(e=><a href={investigativeRecord.sources.find(s=>s.id===e.source)!.url}>{t(e.locator,locale)} ↗</a>)}</article>})}</section>{showTimeline&&<section class="case-no-script"><h2>{en?'Timeline':'Linimasa'}</h2>{topicTimelines[slug].map(r=><article><h3>{r.date} · {t(r.title,locale)}</h3><p>{t(r.text,locale)}</p><a href={r.source}>{r.publisher} ↗</a></article>)}</section>}</noscript>
  {note?.state&&<section class="case-current" id="overview" data-following-state data-slug={slug}><header><h2>{en?'Latest documented change':'Perkembangan tercatat'}</h2><time data-state-date datetime={note.state.asOf}>{new Date(note.state.asOf+'T00:00:00Z').toLocaleDateString(en?'en-GB':'id-ID',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'})}</time></header><p data-state-summary>{t(note.state.summary,locale)}</p><div class="case-state-evidence" data-state-sources>{note.backgroundSources.filter(s=>note.state.sourceIds.includes(s.id)).map(s=><a href={s.url} target="_blank" rel="noreferrer">{s.title} ↗</a>)}</div></section>}
  <section class="case-news" id="latest" data-case-news data-slug={slug}><header><h2>{en?'News':'Berita'}</h2><a href={withLocale('/news/',locale)}>{en?'All news':'Semua berita'} ↗</a></header><p data-case-news-status role="status">{en?'Loading linked reporting…':'Memuat berita terkait…'}</p><div data-case-news-items></div></section>
  {slug&&<section class="case-geography" id="places"><header><h2>{en?'Places':'Lokasi'}</h2></header><MapShell locale={locale} mode="context" context="issue" contextValue={slug} initialView={['nduga','puncak','intan-jaya','kiwirok'].includes(caseId)?'conflict':caseId==='communications'?'current':'extraction'} deferred/></section>}
  {resources.length>0&&<section class="case-library" id="sources"><header><h2>{en?'Library':'Pustaka'}</h2><a href={withLocale('/resources/',locale)+'?topic='+slug}>{en?'Browse all':'Lihat semua'} ↗</a></header><ResourceList items={resources} locale={locale} topic={slug}/></section>}
  <section class="case-related"><header><h2>{en?'Continue exploring':'Telusuri lainnya'}</h2><a href={withLocale('/topics/',locale)}>{en?'All issues':'Semua isu'} ↗</a></header><div>{caseIndex.filter(c=>c.id!==caseId).slice(0,4).map(c=><a href={withLocale(c.href,locale)}>{c.cover&&<img src={c.cover.src} width={c.cover.width} height={c.cover.height} style={`object-position:${c.cover.position}`} loading="lazy" alt=""/>}<strong>{t(c.title,locale)} ↗</strong></a>)}</div></section>
 </div>
</BaseLayout>
<script>
import {fetchJSON} from '../lib/http';
const root=document.querySelector<HTMLElement>('[data-case-page]');
if(root){const bar=root.querySelector<HTMLElement>('.case-switcher'),current=bar?.querySelector<HTMLElement>('[aria-current=page]');if(bar&&current)bar.scrollLeft=Math.max(0,current.offsetLeft-bar.offsetLeft-bar.clientWidth/3);const en=root.dataset.locale==='en',slug=root.dataset.issueSlug!,status=root.querySelector('[data-case-news-status]'),items=root.querySelector('[data-case-news-items]')!;
const pick=(v:any)=>en?v?.en:v?.pmy||v?.id;
if(slug)fetchJSON('/api/issue/'+encodeURIComponent(slug)).then(data=>{if(!data)throw Error('Unavailable');const rows=data.developments||[];if(status)status.textContent=rows.length?'':en?'No linked reporting available.':'Belum ada berita terkait.';for(const item of rows.slice(0,6)){const a=document.createElement('a'),time=document.createElement('time'),h=document.createElement('h3'),p=document.createElement('p');a.href=(en?'':'/id')+item.story_url;const date=item.latest_report_at||item.updated_at;time.textContent=date?new Date(date).toLocaleDateString(en?'en-GB':'id-ID',{day:'numeric',month:'short',year:'numeric'}):'';h.textContent=en?item.title_en:item.title_id||item.title_en;p.textContent=en?item.summary_en:item.summary_id||item.summary_en;a.append(time,h,p);items.append(a)}}).catch(()=>{if(status)status.textContent=en?'Linked reporting is temporarily unavailable.':'Berita terkait sementara tidak tersedia.'});else{root.querySelector('[data-case-news]')?.remove()}
if(slug)fetchJSON('/api/following').then(data=>{const entry=data?.items?.find((x:any)=>x.slug===slug),state=entry?.state;if(!state)return;const old=root.querySelector<HTMLTimeElement>('[data-state-date]');if(!old||Date.parse(state.asOf)<Date.parse(old.dateTime))return;old.dateTime=state.asOf;old.textContent=new Date(state.asOf).toLocaleDateString(en?'en-GB':'id-ID',{day:'numeric',month:'short',year:'numeric'});const summary=root.querySelector('[data-state-summary]');if(summary&&pick(state.summary))summary.textContent=pick(state.summary);const sources=root.querySelector('[data-state-sources]');if(sources&&state.evidence?.length)sources.replaceChildren(...state.evidence.map((s:any)=>{const a=document.createElement('a');a.href=s.url;a.target='_blank';a.rel='noreferrer';a.textContent=s.title+' ↗';return a}))}).catch(()=>{});
}
</script>
<style>
.case-page{padding-top:2rem;padding-bottom:4rem}.case-back{display:inline-flex;align-items:center;min-height:44px;color:var(--muted);font-size:.9rem}.case-opening{display:grid;grid-template-columns:1.3fr 1fr;align-items:center;gap:clamp(2rem,5vw,5rem);padding:1.5rem 0 2rem}.case-opening h1{font-size:clamp(2.8rem,5.4vw,5.7rem);line-height:1.02;letter-spacing:-.06em;margin:0 0 1.4rem;text-wrap:balance;max-width:22ch}.case-opening>div>p{font-size:clamp(1.05rem,1.5vw,1.25rem);color:var(--muted);line-height:1.7;margin:0 0 1.3rem;max-width:48ch}.case-opening-meta{font-size:.8rem;color:#a49bb1}.case-cover{margin:0}.case-cover a{position:relative;display:block;border-radius:5px;overflow:hidden;background:#272a32}.case-cover img{display:block;width:100%;height:240px;object-fit:cover}.case-cover.is-document img{object-fit:contain;background:#d8d4ca;padding:12px}.case-cover a>span{position:absolute;right:10px;bottom:10px;display:grid;place-items:center;width:34px;height:34px;background:#151721c9;border-radius:50%}.case-cover figcaption{font-size:11px;color:var(--muted);line-height:1.6;margin-top:9px}.case-cover figcaption>span{margin-left:5px}.case-page-index{display:flex;flex-wrap:wrap;gap:8px 26px;padding:4px 0 18px}.case-page-index>a{min-height:44px;display:flex;align-items:center;color:#c3b7d5;font-size:15px}.case-switcher{display:flex;gap:9px;overflow-x:auto;padding:14px 0 20px;scrollbar-width:thin;scrollbar-color:#635a76 transparent;border-top:1px solid var(--line);scroll-margin-top:100px}.case-switcher>a{display:flex;align-items:center;gap:12px;flex:0 0 215px;min-height:68px;padding:8px;border-radius:5px;color:#a9a3b6;font-size:13px;line-height:1.5}.case-switcher>a[aria-current]{background:#24222f;color:#eee5fb}.case-switcher>a:hover{background:#1c1e28;color:#eee5fb}.case-switcher img{display:block;flex-shrink:0;width:68px;height:52px;object-fit:cover;border-radius:3px}.case-switcher>a:focus-visible{outline:2px solid #b6a3d2;outline-offset:-2px}.case-current,.case-news,.case-geography,.case-library,.case-related{padding-block:2.8rem;scroll-margin-top:calc(var(--compact-nav-actual-height,100px) + 20px)}.case-current>header,.case-news>header,.case-geography>header,.case-library>header,.case-related>header{display:flex;align-items:baseline;justify-content:space-between;gap:24px;margin-bottom:1.5rem}.case-page section>header>h2{font-size:clamp(1.8rem,3vw,2.8rem);letter-spacing:-.045em;line-height:1.12;margin:0}.case-page section>header>a,.case-current time{font-size:.85rem;color:var(--muted)}.case-current>p{font-size:1.2rem;line-height:1.8;max-width:72ch;color:#c9c3d2}.case-state-evidence{display:flex;flex-wrap:wrap;gap:12px 24px;font-size:.85rem;color:#bda8d5}.case-news [data-case-news-items]{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px}.case-news [data-case-news-items]>a{border-top:1px solid var(--line);padding-top:18px}.case-news time{font-size:12px;color:var(--muted)}.case-news h3{font-size:1.5rem;line-height:1.15;letter-spacing:-.035em}.case-news [data-case-news-items] p{font-size:.95rem;line-height:1.7;color:var(--muted);display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}.case-news [role=status]{font-size:.95rem;color:var(--muted)}.case-geography .watch-map{max-width:none;margin:0}.case-related>div{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}.case-related img{display:block;width:100%;height:150px;object-fit:cover;border-radius:4px;margin-bottom:14px}.case-related strong{font-size:1.2rem;line-height:1.3;letter-spacing:-.03em;font-weight:550}.case-no-script article{padding:1rem 0;border-top:1px solid var(--line)}.case-no-script p{font-size:1.05rem;line-height:1.8;max-width:70ch}
@media(max-width:800px){.case-opening{gap:2rem}.case-cover img{height:220px}.case-related>div{grid-template-columns:repeat(2,minmax(0,1fr))}.case-news [data-case-news-items]{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.case-page{padding-top:1.2rem}.case-opening{grid-template-columns:1fr;gap:1.6rem;padding-top:1rem}.case-opening h1{font-size:clamp(2.5rem,10vw,3.7rem);margin-bottom:1.2rem}.case-cover img{height:200px}.case-cover figcaption{font-size:11px}.case-switcher>a{flex-basis:190px}.case-page-index{gap:0 22px}.case-page-index>a{font-size:14px}.case-current>header{display:block}.case-current time{display:block;margin-top:12px}.case-current>p{font-size:1.05rem}.case-news [data-case-news-items]{grid-template-columns:1fr}.case-related>div{gap:25px 16px}.case-related img{height:110px}.case-related strong{font-size:1rem}.case-current,.case-news,.case-geography,.case-library,.case-related{padding-block:2rem}}
</style>

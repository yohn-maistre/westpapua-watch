---
import BaseLayout from '../layouts/BaseLayout.astro';import { exhibitionItems } from '../data/exhibition';import { sourceById } from '../data/sources';import { withLocale } from '../lib/i18n';import type { Locale } from '../data/types';
const {locale='en'}=Astro.props as {locale?:Locale};
---
<BaseLayout locale={locale} active="exhibition" title={locale==='en'?'Exhibition':'Pameran'}>
<section class="section"><div class="wrap"><div class="eyebrow">{locale==='en'?'Exhibition':'Pameran'}</div><h1 class="page-title">{locale==='en'?'Artists, collectives, writers, works, and archive material.':'Seniman, kolektif, penulis, karya, deng materi arsip.'}</h1><p class="page-intro"><a class="chip primary" href={withLocale('/exhibition/view/',locale)}>{locale==='en'?'Enter exhibition view':'Masuk tampilan pameran'} ↗</a></p><div class="exhibition-grid">{exhibitionItems.map(item=><article class="work-card"><img src={item.image} alt="" loading="lazy"/><div class="body"><div class="eyebrow">{item.type}</div><h2>{item.title}</h2><p>{item.summary}</p><p style="margin-top:.7rem"><a href={sourceById[item.sourceId]?.url} target="_blank" rel="noreferrer">{sourceById[item.sourceId]?.publisher} ↗</a></p></div></article>)}</div></div></section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';import { exhibitionItems } from '../data/exhibition';import { sourceById } from '../data/sources';import { withLocale } from '../lib/i18n';import type { Locale } from '../data/types';
const {locale='en'}=Astro.props as {locale?:Locale};
---
<BaseLayout locale={locale} active="exhibition" title={locale==='en'?'Exhibition':'Pameran'}>
<section class="section"><div class="wrap"><h1 class="page-title">{locale==='en'?'Artists, collectives, writers, works, and archive material.':'Seniman, kolektif, penulis, karya, deng materi arsip.'}</h1><p class="page-intro"><a class="chip primary" href={withLocale('/exhibition/view/',locale)}>{locale==='en'?'Enter exhibition view':'Masuk tampilan pameran'} ↗</a></p><input class="resource-search" type="search" data-exhibit-search aria-label={locale==='en'?'Search exhibition':'Cari pameran'} placeholder={locale==='en'?'Find a work, artist or medium':'Cari karya, seniman, atau medium'}/><p data-exhibit-count role="status"></p><div class="exhibition-grid">{exhibitionItems.map(item=><article class="work-card" data-exhibit-text={[item.title,item.type,item.creator,item.summary].join(' ').toLowerCase()}><img src={item.image} alt="" loading="lazy"/><div class="body"><div class="eyebrow">{item.type}</div><h2>{item.title}</h2><p>{item.summary}</p><small class="muted">{item.credit}</small><p style="margin-top:.7rem"><a href={item.sourceUrl||sourceById[item.sourceId]?.url} target="_blank" rel="noreferrer">{item.publisher||sourceById[item.sourceId]?.publisher} ↗</a></p></div></article>)}</div></div></section>
</BaseLayout>

<script>
const search=document.querySelector<HTMLInputElement>('[data-exhibit-search]');const cards=[...document.querySelectorAll<HTMLElement>('[data-exhibit-text]')];
const filter=()=>{let count=0;for(const card of cards){card.hidden=!card.dataset.exhibitText?.includes(search?.value.trim().toLowerCase()||'');if(!card.hidden)count++}document.querySelector('[data-exhibit-count]')!.textContent=`${count} / ${cards.length}`};search?.addEventListener('input',filter);filter();
</script>
<style>.work-card[hidden]{display:none}.resource-search{margin:1.5rem 0 .5rem;width:100%}[data-exhibit-count]{color:var(--muted);margin-bottom:1.5rem}</style>

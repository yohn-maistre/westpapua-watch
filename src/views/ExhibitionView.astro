---
import BaseLayout from '../layouts/BaseLayout.astro';import { exhibitionItems } from '../data/exhibition';import { withLocale } from '../lib/i18n';import type { Locale } from '../data/types';
const {locale='en'}=Astro.props as {locale?:Locale};
---
<BaseLayout locale={locale} active="exhibition" title={locale==='en'?'Exhibition view':'Tampilan pameran'} immersive={true} noFooter={true}>
  <div class="exhibition-scroll-space" data-exhibition-scroll>
    <div class="exhibition-field" aria-hidden="true">
      {exhibitionItems.slice(0,6).map((item,i)=><div class={`exhibit-card c${i+1}`} data-exhibit-card data-speed={String([.16,-.12,.21,-.15,.1,-.19][i])}><img src={item.image} alt=""/><span>{item.title}</span></div>)}
    </div>
    <div class="exhibit-overlay">
      <div class="exhibit-top"><span class="exhibit-kicker">{locale==='en'?'Exhibition':'Pameran'}</span><a class="chip exhibit-home" href={withLocale('/',locale)}>West Papua Watch</a></div>
      <h1 class="exhibit-title">{locale==='en'?'Art, writing & collective work':'Seni, tulisan & kerja kolektif'}</h1>
      <div class="exhibit-bottom"><a href={withLocale('/exhibition/',locale)}>{locale==='en'?'Browse artists, works & credits':'Lihat seniman, karya & kredit'} →</a></div>
    </div>
  </div>
  <script>
    const cards=[...document.querySelectorAll('[data-exhibit-card]')];
    const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(!reduced){let ticking=false;const update=()=>{const max=Math.max(1,document.documentElement.scrollHeight-innerHeight);const p=scrollY/max;cards.forEach((card,i)=>{const speed=Number(card.dataset.speed||0);const x=(p-.5)*innerWidth*speed*2.2;const y=(p-.5)*innerHeight*speed*1.3;card.style.translate=`${x}px ${y}px`;});ticking=false};addEventListener('scroll',()=>{if(!ticking){requestAnimationFrame(update);ticking=true}},{passive:true});update()}
  </script>
</BaseLayout>

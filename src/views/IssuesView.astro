---
import BaseLayout from '../layouts/BaseLayout.astro';
import FollowingMosaic from '../components/investigation/FollowingMosaic.astro';
import RecordSearch from '../components/investigation/RecordSearch';
import {investigativeRecord} from '../data/investigative-record';
import {caseIndex,caseRoute} from '../data/case-presentation';
import {issues} from '../data/issues';
import {t,withLocale} from '../lib/i18n';
import type {Locale} from '../data/types';
import '../styles/issues-editorial.css';
const {locale='en'}=Astro.props as {locale?:Locale};const en=locale==='en';
---
<BaseLayout locale={locale} active="issues" title={en?'Issues':'Isu'} description={en?'Follow the stories shaping Papua, explore their connections and read the original evidence.':'Ikuti persoalan di Papua, telusuri keterkaitannya, dan baca sumber aslinya.'}>
 <div class="wrap issues-editorial">
  <header class="issues-opening"><h1>{en?'Issues.':'Isu.'}</h1><RecordSearch client:load data={investigativeRecord} routes={caseRoute} locale={locale}/></header>
  <section id="following" aria-labelledby="following-title"><div class="issues-section-head"><h2 id="following-title">{en?'Following':'Dalam pantauan'}</h2><a href="#topics">{en?'All topics':'Semua topik'} <svg class="issues-link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 4v16m-7-7 7 7 7-7"/></svg></a></div><FollowingMosaic locale={locale}/></section>
  <section aria-labelledby="threads-title"><div class="issues-section-head"><h2 id="threads-title">{en?'Across the cases':'Lintas kasus'}</h2></div><div class="issues-threads">{caseIndex.filter(c=>c.thread).map(c=><a href={withLocale(c.href,locale)}><h3>{t(c.title,locale)} <svg class="issues-link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></h3><p>{t(investigativeRecord.cases.find(k=>k.id===c.id)!.deck,locale)}</p></a>)}</div></section>
  <section class="topics-directory" id="topics" aria-labelledby="all-topics-title"><div class="issues-section-head"><h2 id="all-topics-title">{en?'All topics':'Semua topik'}</h2></div><div class="topics-directory-grid">{issues.map(item=><a href={withLocale(`/topics/${item.slug}/`,locale)}><div><h3>{t(item.title,locale)}</h3><p>{t(item.summary,locale)}</p></div><svg class="issues-link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></a>)}</div></section>
  <details class="issues-research-index"><summary>{en?'Research index':'Indeks riset'} · {investigativeRecord.threads.length}</summary><ol>{investigativeRecord.threads.map(thread=><li>{t(thread.title,locale)}</li>)}</ol></details>
 </div>
 <script type="application/json" data-case-routes set:html={JSON.stringify(caseRoute).replace(/</g,'\\u003c')}/>
</BaseLayout>
<script>
// Keep links shared from the earlier desk useful after moving it into cases.
const old=new URL(location.href),id=old.searchParams.get('case'),routes=JSON.parse(document.querySelector('[data-case-routes]')?.textContent||'{}');
if(id&&routes[id]){const next=new URL((document.documentElement.lang==='id'?'/id':'')+routes[id],location.origin);for(const k of ['entity','claim','view','evidence'])if(old.searchParams.has(k))next.searchParams.set(k,old.searchParams.get(k)!);next.hash=old.searchParams.get('view')==='timeline'?'records':old.searchParams.get('view')==='documents'?'documents':'explore';location.replace(next.href)}
</script>

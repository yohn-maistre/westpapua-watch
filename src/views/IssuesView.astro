---
import BaseLayout from '../layouts/BaseLayout.astro';
import {issues} from '../data/issues';
import {dossierBySlug} from '../data/dossiers';
import {featuredTopicSlugs,secondaryFollowingSlugs} from '../data/topic-collections';
import {t,withLocale} from '../lib/i18n';
import type {Locale} from '../data/types';
const {locale='en'}=Astro.props as {locale?:Locale};const en=locale==='en';
const featured=featuredTopicSlugs.map(s=>dossierBySlug[s]).filter(Boolean);
const secondary=secondaryFollowingSlugs.map(s=>dossierBySlug[s]).filter(Boolean);
---
<BaseLayout locale={locale} active="issues" title={en?'Topics':'Topik'}>
<section class="section topics-editorial"><div class="wrap">
<header class="topics-opening"><h1 class="page-title">{en?'Topics.':'Topik.'}</h1><a href="#topics">{en?'Browse topics':'Jelajahi topik'} <span aria-hidden="true">↓</span></a></header>
<section id="following" aria-labelledby="following-title"><div class="topics-section-title"><h2 id="following-title">{en?'Following':'Dalam pantauan'}</h2><span>01—{String(featured.length+secondary.length).padStart(2,'0')}</span></div>
<div class="following-mosaic">{featured.map((item,i)=><a class:list={['following-tile',`following-tile-${i}`]} href={withLocale(`/topics/${item.slug}/`,locale)}>
<span class="following-number">{String(i+1).padStart(2,'0')}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></span>
<div class="following-copy"><h3>{t(item.title,locale)}</h3><p>{t(item.summary,locale)}</p></div>
<footer>{item.sourceIds.length} {en?'references':'referensi'}</footer></a>)}
{secondary.map((item,i)=><a class="following-tile following-small" href={withLocale(`/topics/${item.slug}/`,locale)}><span class="following-number">{String(featured.length+i+1).padStart(2,'0')}<span aria-hidden="true">↗</span></span><div class="following-copy"><h3>{t(item.title,locale)}</h3><p>{t(item.summary,locale)}</p></div></a>)}
</div></section>
<section id="topics" class="topics-directory" aria-labelledby="topics-title"><div class="topics-section-title"><h2 id="topics-title">{en?'Topics':'Topik'}</h2><span>{String(issues.length).padStart(2,'0')}</span></div><div class="topics-directory-grid">{issues.map((item,i)=><a href={withLocale(`/topics/${item.slug}/`,locale)}><span class="directory-number">{String(i+1).padStart(2,'0')}</span><div><h3>{t(item.title,locale)}</h3><p>{t(item.summary,locale)}</p></div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-7-7 7 7-7 7"/></svg></a>)}</div></section>
</div></section></BaseLayout>
<style>
.topics-opening{display:flex;align-items:baseline;justify-content:space-between;gap:2rem;margin-bottom:3rem}.topics-opening>a{font-size:.85rem;color:var(--muted);white-space:nowrap}.topics-opening>a span{margin-left:1rem}.topics-section-title{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:1.5rem;gap:1rem}.topics-section-title h2{font-size:clamp(1.6rem,3vw,2.6rem);letter-spacing:-.045em;margin:0}.topics-section-title>span,.directory-number{font-size:.7rem;font-variant-numeric:tabular-nums;letter-spacing:.08em;color:var(--muted)}
.following-mosaic{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px}.following-tile{grid-column:span 3;position:relative;isolation:isolate;display:flex;flex-direction:column;justify-content:space-between;gap:2.3rem;min-width:0;min-height:330px;border-radius:20px;padding:clamp(1.4rem,3vw,2.8rem);color:#faf8f2;background:#293b35;overflow:hidden;transition:transform .2s,box-shadow .2s}.following-tile:before{content:'';position:absolute;z-index:-1;width:85%;aspect-ratio:1;right:-24%;top:-38%;border:1px solid #ffffff22;border-radius:50%;box-shadow:0 0 0 48px #ffffff05,0 0 0 96px #ffffff04}.following-tile:hover{transform:translateY(-3px);box-shadow:0 12px 40px #0003}.following-tile:focus-visible,.topics-directory-grid>a:focus-visible{outline:3px solid #c9c2ed;outline-offset:5px}.following-tile-0{grid-column:span 4;background:radial-gradient(ellipse at 100% 0%,#788b58,transparent 80%),#263c32}.following-tile-1{grid-column:span 2;background:radial-gradient(ellipse at 100% 0%,#8c788a,transparent 90%),#383146}.following-tile-2{background:radial-gradient(ellipse at 100% 0%,#497d84,transparent 90%),#243c48}.following-tile-3{background:radial-gradient(ellipse at 100% 0%,#a68065,transparent 90%),#493930}.following-number{display:flex;justify-content:space-between;align-items:center;font-size:.7rem;letter-spacing:.08em;color:#ffffffb8}.following-number svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.5}.following-copy h3{font-size:clamp(1.9rem,3.6vw,3.5rem);letter-spacing:-.05em;line-height:1.04;margin:0 0 1rem;overflow-wrap:break-word;text-wrap:balance;max-width:20ch}.following-tile-0 h3{font-size:clamp(2.4rem,4.8vw,4.5rem)}.following-tile-1 h3{font-size:clamp(1.9rem,3vw,3rem)}.following-copy p{font-size:.95rem;line-height:1.55;color:#faf8f2c9;max-width:46ch;margin:0}.following-tile footer{font-size:.7rem;color:#ffffffb8}.following-small{grid-column:span 2;min-height:210px;background:linear-gradient(140deg,#292d3e,#181b25);gap:1.5rem;padding:1.5rem 2rem}.following-small h3{font-size:clamp(1.5rem,2.5vw,2.2rem)}.following-small p{font-size:.9rem}.topics-directory{padding-top:5rem;scroll-margin-top:calc(var(--compact-nav-actual-height,110px) + 24px)}.topics-directory-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 3rem}.topics-directory-grid>a{display:grid;grid-template-columns:24px 1fr 24px;align-items:start;gap:1rem;padding:2rem 0;border-top:1px solid var(--line)}.directory-number{padding-top:.4rem}.topics-directory-grid h3{font-size:clamp(1.45rem,2.4vw,2.2rem);line-height:1.12;letter-spacing:-.035em;margin:0 0 .7rem;text-wrap:balance}.topics-directory-grid p{max-width:44ch;font-size:.95rem;line-height:1.6;color:var(--muted);margin:0}.topics-directory-grid svg{width:22px;fill:none;stroke:currentColor;stroke-width:1.3;margin-top:.2rem;transition:transform .2s}.topics-directory-grid>a:hover svg{transform:translateX(4px)}
@media(max-width:760px){.topics-opening{display:block;margin-bottom:2.4rem}.topics-opening>a{display:inline-block;margin-top:1rem}.following-mosaic{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.following-tile{grid-column:span 2;min-height:280px}.following-tile-0{min-height:350px}.following-small{grid-column:span 1;min-height:235px;padding:1.2rem;gap:2rem}.following-small:last-child{grid-column:span 2}.following-small h3{font-size:1.45rem}.following-small p{font-size:.82rem;line-height:1.5}.topics-directory-grid{grid-template-columns:1fr}.topics-directory{padding-top:3.5rem}.topics-directory-grid>a{padding:1.6rem 0;gap:.8rem}}
@media(max-width:350px){.following-small{grid-column:span 2;min-height:180px}}
@media(prefers-reduced-motion:reduce){.following-tile,.topics-directory-grid svg{transition:none}}
</style>

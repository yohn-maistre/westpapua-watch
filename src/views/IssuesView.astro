---
import BaseLayout from '../layouts/BaseLayout.astro';
import {issues} from '../data/issues';
import {dossiers,dossierBySlug} from '../data/dossiers';
import {topicCollections,featuredTopicSlugs} from '../data/topic-collections';
import {t,withLocale} from '../lib/i18n';
import type {Locale} from '../data/types';
const {locale='en'}=Astro.props as {locale?:Locale};const en=locale==='en';
const featured=featuredTopicSlugs.map(s=>dossierBySlug[s]).filter(Boolean);
---
<BaseLayout locale={locale} active="issues" title={en?'Topics':'Topik'}>
<section class="section topics-editorial"><div class="wrap">
<header class="topics-opening"><h1 class="page-title">{en?'Topics.':'Topik.'}</h1><nav aria-label={en?'Topic categories':'Kategori topik'}>{topicCollections.map(c=><a href={`#${c.id}`}>{t(c.title,locale)} <span>↘</span></a>)}</nav></header>
<section class="topics-featured" aria-label={en?'Featured topics':'Topik pilihan'}><div class="topics-section-title"><h2>{en?'Featured':'Pilihan'}</h2></div><div class="topics-feature-grid">{featured.map((item,i)=><a class:list={['topic-feature',`topic-feature-${i}`]} href={withLocale(`/topics/${item.slug}/`,locale)}><span class="topic-feature-number">0{i+1}<i aria-hidden="true">↗</i></span><div><h2>{t(item.title,locale)}</h2><p>{t(item.summary,locale)}</p></div><footer>{item.sourceIds.length} {en?'sources':'sumber'}</footer></a>)}</div></section>
{topicCollections.map(collection=><section class="topic-collection" id={collection.id}><div class="topics-section-title"><h2>{t(collection.title,locale)}</h2><span>{collection.slugs.length.toString().padStart(2,'0')}</span></div><div class="topics-subjects">{collection.slugs.map(slug=>dossierBySlug[slug]).filter(Boolean).map(item=><a class="topic-subject" href={withLocale(`/topics/${item.slug}/`,locale)}><h3>{t(item.title,locale)}</h3><p>{t(item.summary,locale)}</p><span aria-hidden="true">↗</span></a>)}</div></section>)}
<details class="topic-browse"><summary>{en?'Browse by category':'Jelajahi kategori'}</summary><div>{issues.map(item=><a href={withLocale(`/topics/${item.slug}/`,locale)}>{t(item.title,locale)} <span>↗</span></a>)}</div></details>
</div></section></BaseLayout>
<style>
.topics-opening{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:3rem}.topics-opening nav{display:flex;flex-wrap:wrap;gap:.7rem 1.5rem;max-width:480px;padding-bottom:1rem}.topics-opening nav a{font-size:.85rem;color:var(--muted)}.topics-opening nav span{margin-left:.4rem}.topics-section-title{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;margin-bottom:1.4rem}.topics-section-title h2{font-size:clamp(1.65rem,3vw,3rem);letter-spacing:-.045em;margin:0}.topics-section-title>span{color:var(--muted);font-size:.8rem}.topics-feature-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:1.2rem}.topic-feature{padding:clamp(1.5rem,3vw,3rem);border-radius:22px;min-height:350px;display:flex;flex-direction:column;justify-content:space-between;color:#f7f5f0;gap:2.5rem;overflow:hidden;transition:transform .2s}.topic-feature:hover{transform:translateY(-3px)}.topic-feature-0{background:radial-gradient(ellipse at 100% 0%,#819877,transparent 70%),#283b34}.topic-feature-1{background:radial-gradient(ellipse at 0% 0%,#8b809d,transparent 75%),#292738}.topic-feature-number{display:flex;justify-content:space-between;font-size:.75rem;letter-spacing:.1em}.topic-feature-number i{font-style:normal;font-size:1.5rem}.topic-feature h2{font-size:clamp(2rem,3.5vw,4rem);letter-spacing:-.055em;line-height:1.02;margin:0 0 1rem;max-width:20ch}.topic-feature p{line-height:1.55;max-width:46ch;margin:0;color:#f2f0e5cc}.topic-feature footer{font-size:.75rem}.topic-collection{padding-top:4.5rem;scroll-margin-top:calc(var(--compact-nav-actual-height,110px) + 20px)}.topics-subjects{border-top:1px solid var(--line)}.topic-subject{display:grid;grid-template-columns:1fr 1.2fr 28px;gap:2rem;align-items:start;padding:1.65rem 0;border-bottom:1px solid var(--line)}.topic-subject h3{font-size:clamp(1.35rem,2.2vw,2rem);line-height:1.1;letter-spacing:-.035em;margin:0}.topic-subject p{font-size:.95rem;line-height:1.6;color:var(--muted);margin:0;max-width:60ch}.topic-subject>span{font-size:1.3rem}.topic-browse{margin-top:3rem;border-top:1px solid var(--line);padding-top:1rem}.topic-browse summary{cursor:pointer;padding:.75rem 0}.topic-browse>div{display:grid;grid-template-columns:1fr 1fr;gap:0 2rem}.topic-browse a{display:flex;justify-content:space-between;padding:1rem 0;border-bottom:1px solid var(--line);font-size:.9rem}
@media(max-width:760px){.topics-opening{display:block;margin-bottom:2rem}.topics-opening nav{margin-top:1.5rem;gap:.8rem 1.2rem}.topics-feature-grid{grid-template-columns:1fr}.topic-feature{min-height:300px}.topic-subject{grid-template-columns:1fr 24px;gap:.6rem 1rem}.topic-subject p{grid-column:1;grid-row:2}.topic-subject>span{grid-column:2;grid-row:1}.topic-browse>div{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.topic-feature{transition:none}}
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';import { issues } from '../data/issues';import { t,withLocale } from '../lib/i18n';import type { Locale } from '../data/types';const {locale='en'}=Astro.props as {locale?:Locale};const categories=['all',...new Set(issues.map(i=>i.category))];
---
<BaseLayout locale={locale} active="issues" title={locale==='en'?'Issues':'Isu'}><section class="section issues-index"><div class="wrap"><h1 class="page-title">{locale==='en'?'Issues.':'Isu.'}</h1><div class="filters">{categories.map((c,i)=><button class:list={['filter',i===0&&'active']} type="button" data-issue-filter={c}>{c==='all'?(locale==='en'?'All':'Semua'):c}</button>)}</div><div class="issue-list" data-issues-list data-locale={locale}>{issues.map((item,index)=><a class="issue-row" data-issue-row data-issue-slug={item.slug} data-issue-category={item.category} href={withLocale(`/issues/${item.slug}/`,locale)}><span class="eyebrow">{String(index+1).padStart(2,'0')}</span><div><h2 data-issue-title>{t(item.title,locale)}</h2><p data-issue-summary>{t(item.summary,locale)}</p><small class="issue-index-live" data-issue-live-note hidden></small></div><span class="status" data-issue-status><i class="status-dot"></i>{t(item.status,locale)}</span><span class="status" data-issue-live-updated>{locale==='en'?'Updated':'Diperbarui'} {item.updatedAt}</span></a>)}</div></div></section><script>
const list=document.querySelector<HTMLElement>('[data-issues-list]');const locale=list?.dataset.locale==='pmy'?'pmy':'en';const filters=[...document.querySelectorAll<HTMLButtonElement>('[data-issue-filter]')];filters.forEach(button=>button.addEventListener('click',()=>{filters.forEach(x=>x.classList.toggle('active',x===button));const c=button.dataset.issueFilter||'all';document.querySelectorAll<HTMLElement>('[data-issue-row]').forEach(row=>row.hidden=c!=='all'&&row.dataset.issueCategory!==c)}));fetch('/api/issues').then(r=>r.ok?r.json():null).then(data=>{for(const item of data?.items||[]){const row=document.querySelector<HTMLElement>(`[data-issue-slug="${CSS.escape(item.slug)}"]`);if(!row)continue;const u=row.querySelector<HTMLElement>('[data-issue-live-updated]'),n=row.querySelector<HTMLElement>('[data-issue-live-note]'),h=row.querySelector<HTMLElement>('[data-issue-title]'),p=row.querySelector<HTMLElement>('[data-issue-summary]'),s=row.querySelector<HTMLElement>('[data-issue-status]');row.dataset.issueCategory=item.category||row.dataset.issueCategory||'';if(h)h.textContent=locale==='pmy'?(item.title_id||item.title_en):item.title_en;if(p)p.textContent=locale==='pmy'?(item.summary_id||item.summary_en):item.summary_en;if(s)s.textContent=locale==='pmy'?(item.status_id||item.status_en):item.status_en;if(u&&item.updated_at)u.textContent=`${locale==='pmy'?'Diperbarui':'Updated'} ${new Date(item.updated_at).toLocaleDateString(locale==='pmy'?'id-ID':'en-GB',{day:'numeric',month:'short'})}`;if(n){n.hidden=false;n.textContent=`${item.development_count||0} ${locale==='pmy'?'perkembangan':'developments'} · ${item.source_count||0} ${locale==='pmy'?'sumber':'sources'}`}}}).catch(()=>{});
</script></BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';import { issues } from '../data/issues';import { t,withLocale } from '../lib/i18n';import type { Locale } from '../data/types';const {locale='en'}=Astro.props as {locale?:Locale};const categories=['all',...new Set(issues.map(i=>i.category))];
---
<BaseLayout locale={locale} active="issues" title={locale==='en'?'Issues':'Isu'}><section class="section issues-index"><div class="wrap"><h1 class="page-title">{locale==='en'?'Ongoing issues.':'Isu yang masih jalan.'}</h1><div class="filters">{categories.map((c,i)=><button class:list={['filter',i===0&&'active']} type="button" data-issue-filter={c}>{c==='all'?(locale==='en'?'All':'Semua'):c}</button>)}</div><div class="issue-list" data-issues-list data-locale={locale}>{issues.map((item,index)=><a class="issue-row" data-issue-row data-issue-slug={item.slug} data-issue-category={item.category} href={withLocale(`/issues/${item.slug}/`,locale)}><span class="eyebrow">{String(index+1).padStart(2,'0')}</span><div><h2>{t(item.title,locale)}</h2><p>{t(item.summary,locale)}</p><small class="issue-index-live" data-issue-live-note hidden></small></div><span class="status"><i class="status-dot"></i>{t(item.status,locale)}</span><span class="status" data-issue-live-updated>{locale==='en'?'Updated':'Diperbarui'} {item.updatedAt}</span></a>)}</div>
<section class="emerging-section" data-emerging-section hidden><div class="emerging-head"><div><div class="eyebrow">{locale==='en'?'Emerging':'Berkembang'}</div><h2>{locale==='en'?'Storylines taking shape.':'Rangkaian cerita yang mulai terbentuk.'}</h2></div><p>{locale==='en'?'Detected across distinct developments over time. These are dynamic storylines, not permanent editorial categories.':'Terdeteksi dari beberapa perkembangan berbeda sepanjang waktu. Ini rangkaian dinamis, bukan kategori editorial permanen.'}</p></div><div class="emerging-list" data-emerging-list></div></section>
</div></section><script>
const list=document.querySelector<HTMLElement>('[data-issues-list]');const locale=list?.dataset.locale==='pmy'?'pmy':'en';const filters=[...document.querySelectorAll<HTMLButtonElement>('[data-issue-filter]')];filters.forEach(button=>button.addEventListener('click',()=>{filters.forEach(x=>x.classList.toggle('active',x===button));const c=button.dataset.issueFilter||'all';document.querySelectorAll<HTMLElement>('[data-issue-row]').forEach(row=>row.hidden=c!=='all'&&row.dataset.issueCategory!==c)}));fetch('/api/issues').then(r=>r.ok?r.json():null).then(data=>{for(const item of data?.items||[]){const row=document.querySelector<HTMLElement>(`[data-issue-slug="${CSS.escape(item.issue_slug)}"]`);if(!row)continue;const u=row.querySelector<HTMLElement>('[data-issue-live-updated]'),n=row.querySelector<HTMLElement>('[data-issue-live-note]');if(u&&item.updated_at)u.textContent=`${locale==='pmy'?'Diperbarui':'Updated'} ${new Date(item.updated_at).toLocaleDateString(locale==='pmy'?'id-ID':'en-GB',{day:'numeric',month:'short'})}`;if(n){n.hidden=false;n.textContent=`${item.development_count} ${locale==='pmy'?'perkembangan':'developments'} · ${item.source_count} ${locale==='pmy'?'sumber':'sources'}`}}}).catch(()=>{});fetch('/api/emerging-issues').then(r=>r.ok?r.json():null).then(data=>{const items=data?.items||[];if(!items.length)return;const section=document.querySelector<HTMLElement>('[data-emerging-section]'),out=document.querySelector<HTMLElement>('[data-emerging-list]');if(!section||!out)return;section.hidden=false;items.forEach((x:any,i:number)=>{const row=document.createElement('article');row.className='emerging-row';const no=document.createElement('small');no.textContent=String(i+1).padStart(2,'0');const main=document.createElement('div');const h=document.createElement('h3');h.textContent=locale==='pmy'?(x.title_id||x.title):x.title;const p=document.createElement('p');p.textContent=locale==='pmy'?(x.summary_id||x.summary||''):(x.summary||x.summary_id||'');main.append(h,p);const meta=document.createElement('small');const days=Math.max(1,Math.round((new Date(x.last_seen_at).getTime()-new Date(x.first_seen_at).getTime())/864e5));meta.textContent=`${x.development_count} ${locale==='pmy'?'perkembangan':'developments'} · ${x.source_count} ${locale==='pmy'?'sumber':'sources'} · ${days}d`;row.append(no,main,meta);out.append(row)})}).catch(()=>{});
</script></BaseLayout>

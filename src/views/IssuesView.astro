---
import BaseLayout from '../layouts/BaseLayout.astro';import { issues } from '../data/issues';import { t, withLocale } from '../lib/i18n';import type { Locale } from '../data/types';
const {locale='en'}=Astro.props as {locale?:Locale};const categories=['all',...new Set(issues.map(i=>i.category))];
---
<BaseLayout locale={locale} active="issues" title={locale==='en'?'Issues':'Isu'}>
  <section class="section issues-index"><div class="wrap"><h1 class="page-title">{locale==='en'?'Ongoing issues.':'Isu yang masih jalan.'}</h1>
    <div class="filters">{categories.map((c,i)=><button class:list={['filter',i===0&&'active']} type="button" data-issue-filter={c}>{c==='all'?(locale==='en'?'All':'Semua'):c}</button>)}</div>
    <div class="issue-list" data-issues-list data-locale={locale}>{issues.map((item,index)=><a class="issue-row" data-issue-row data-issue-slug={item.slug} data-issue-category={item.category} href={withLocale(`/issues/${item.slug}/`,locale)}><span class="eyebrow">{String(index+1).padStart(2,'0')}</span><div><h2>{t(item.title,locale)}</h2><p>{t(item.summary,locale)}</p><small class="issue-index-live" data-issue-live-note hidden></small></div><span class="status"><i class="status-dot"></i>{t(item.status,locale)}</span><span class="status" data-issue-live-updated>{locale==='en'?'Updated':'Diperbarui'} {item.updatedAt}</span></a>)}</div>
  </div></section>
  <script>
    const list=document.querySelector<HTMLElement>('[data-issues-list]');const locale=list?.dataset.locale==='pmy'?'pmy':'en';
    const filters=[...document.querySelectorAll<HTMLButtonElement>('[data-issue-filter]')];filters.forEach(button=>button.addEventListener('click',()=>{filters.forEach(x=>x.classList.toggle('active',x===button));const category=button.dataset.issueFilter||'all';document.querySelectorAll<HTMLElement>('[data-issue-row]').forEach(row=>row.hidden=category!=='all'&&row.dataset.issueCategory!==category)}));
    fetch('/api/issues',{headers:{accept:'application/json'}}).then(r=>r.ok?r.json():null).then(data=>{for(const item of data?.items||[]){const row=document.querySelector<HTMLElement>(`[data-issue-slug="${CSS.escape(item.issue_slug)}"]`);if(!row)continue;const updated=row.querySelector<HTMLElement>('[data-issue-live-updated]');const note=row.querySelector<HTMLElement>('[data-issue-live-note]');if(updated&&item.updated_at){const date=new Date(item.updated_at).toLocaleDateString(locale==='pmy'?'id-ID':'en-GB',{day:'numeric',month:'short',year:'numeric'});updated.textContent=`${locale==='pmy'?'Diperbarui':'Updated'} ${date}`}if(note){note.hidden=false;note.textContent=item.current_status||`${item.development_count} ${locale==='pmy'?'pembaruan':'live updates'} · ${item.source_count} ${locale==='pmy'?'sumber':'sources'}`}}}).catch(()=>{});
  </script>
</BaseLayout>

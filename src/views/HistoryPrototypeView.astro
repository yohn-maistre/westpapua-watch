---
import BaseLayout from '../layouts/BaseLayout.astro';
import HistoryArrow from '../components/history/HistoryArrow.astro';
import HistoryPathControls from '../components/history/HistoryPathControls';
import MapShell from '../components/map/MapShell.astro';
import HistoryRecordDialog from '../components/history/HistoryRecordDialog.astro';
import {prototypeHistoryRecords as records,historyPaths,historyEras,recordsForPath,companionFor} from '../data/history-prototype';
import {archiveItemById,archiveText} from '../data/archive';
import {t,withLocale} from '../lib/i18n';
import type {Locale} from '../data/types';
import '../styles/history-prototype.css';
const {locale='en'}=Astro.props as {locale?:Locale};const en=locale==='en';
const route=withLocale('/history/prototype/',locale);
const pathHref=(path:string,id?:string)=>`${route}?path=${path}${id?`#${id}`:''}`;
const metadata=records.map(r=>({id:r.id,year:r.year,era:r.era,paths:r.paths,date:t(r.yearLabel,locale),places:r.places}));
---
<BaseLayout locale={locale} active="history" title={en?'History · Preview':'Sejarah · Pratinjau'}>
<div class="history-prototype" data-history-prototype data-locale={locale}>
  <header class="wrap prototype-opening" id="paths">
    <a class="prototype-return" href={withLocale('/history/',locale)}>{en?'History':'Sejarah'} <HistoryArrow direction="up-right"/></a>
    <h1>{en?'History.':'Sejarah.'}</h1>
    <nav class="prototype-path-index" aria-label={en?'History paths':'Jalur sejarah'}>
      {historyPaths.filter(p=>p.id!=='all').map(p=><a href={pathHref(p.id,recordsForPath(p.id)[0].id)} data-history-path={p.id}><strong>{t(p.label,locale)}</strong><span>{t(p.start,locale)}</span><HistoryArrow direction="down-right"/></a>)}
    </nav>
    <div class="prototype-opening-footer"><a href={pathHref('all',records[0].id)} data-history-path="all">{en?'Full chronology':'Kronologi lengkap'} <HistoryArrow direction="down"/></a><a href={`${withLocale('/history/',locale)}#archive`}>{en?'Archive':'Arsip'} <HistoryArrow direction="up-right"/></a></div>
  </header>
  <div class="prototype-reader" data-history-reader>
    <aside class="prototype-margin">
      <HistoryPathControls client:load locale={locale} paths={historyPaths.map(p=>({id:p.id,label:t(p.label,locale),start:t(p.start,locale)}))}/>
      <div class="prototype-margin-body">
        <p class="prototype-era" data-active-era>{en?'Early settlement':'Permukiman awal'}</p>
        <nav class="prototype-date-index" data-history-dates aria-label={en?'Dates':'Tahun'}>{records.map(r=><a href={`#${r.id}`} data-history-date={r.id}>{t(r.yearLabel,locale)}</a>)}</nav>
        <div class="prototype-map-shell" id="history-context-map" data-history-map-shell>
          <header><span data-history-map-date></span><span data-history-map-places>{en?'New Guinea':'Nugini'}</span></header>
          <MapShell locale={locale} mode="context" context="history" historyFeatures={JSON.stringify({type:'FeatureCollection',features:[]})}/>
          <small>{en?'Places in this account':'Tempat dalam kisah ini'} · <a href="https://www.naturalearthdata.com/about/terms-of-use/" target="_blank" rel="noreferrer">{en?'Sources':'Sumber'}</a></small>
        </div>
      </div>
    </aside>
    <div class="prototype-scenes" data-history-scenes>
      {records.map((r,i)=>{const companion=companionFor(r);const paper=r.era==='transfer'||r.era==='recent';return <article id={r.id} class:list={['prototype-scene',paper&&'prototype-scene-paper',r.year<0&&'prototype-scene-early']} data-history-scene data-era={r.era} data-paths={r.paths.join(' ')}>
        <div class="prototype-event-head"><span class="prototype-event-date">{t(r.yearLabel,locale)}</span><small>{t(historyEras.find(e=>e.id===r.era)!.label,locale)}</small></div>
        <div class:list={['prototype-spread',companion&&'has-companion']}>
          <div class="prototype-account">
            <h2>{t(r.title,locale)}</h2>
            {r.media&&<figure><a href={r.media.src} target="_blank" aria-label={en?'Enlarge image':'Perbesar gambar'}><img src={r.media.src} alt={t(r.media.caption,locale)} loading="lazy" width="1000" height="750"/></a><figcaption>{t(r.media.caption,locale)} <a href={r.media.url} target="_blank" rel="noreferrer">{r.media.credit}</a> · <a href={r.media.licenseUrl} target="_blank" rel="noreferrer">{r.media.license}</a></figcaption></figure>}
            {t(r.body,locale).split('\n\n').map(p=><p>{p}</p>)}
            {r.archiveIds.length>0&&<div class="prototype-archive-records">{r.archiveIds.map(id=>{const a=archiveItemById[id];return <button type="button" data-history-record={id}><span>{a.date}</span><strong>{archiveText(a.title,locale)}</strong><span>{a.mediaType==='film'?(en?'Film':'Film'):(en?'Photograph':'Foto')} <HistoryArrow direction="up-right"/></span></button>})}</div>}
            <details class="prototype-sources"><summary>{en?'Sources':'Sumber'} <span>{r.sources.length}</span></summary>{r.sources.map(s=><a href={s.url} target="_blank" rel="noreferrer"><small>{s.publisher}</small><span>{s.title} <HistoryArrow direction="up-right"/></span></a>)}</details>
          </div>
          {companion&&<aside class="prototype-companion"><a href={pathHref(companion.paths[0],companion.id)} data-history-path={companion.paths[0]} data-target-event={companion.id}><span>{t(historyPaths.find(p=>p.id===companion.paths[0])!.label,locale)} <HistoryArrow/></span><small>{t(companion.yearLabel,locale)}</small><h3>{t(companion.title,locale)}</h3><p>{t(companion.body,locale).split('\n\n')[0]}</p><span class="prototype-companion-link">{en?'Continue':'Lanjutkan'} <HistoryArrow direction="up-right"/></span></a></aside>}
        </div>
      </article>})}
      <footer class="prototype-reader-end"><a href="#paths">{en?'Choose a path':'Pilih jalur'} <HistoryArrow direction="up"/></a><a href={`${withLocale('/history/',locale)}#archive`}>{en?'Explore the archive':'Jelajahi arsip'} <HistoryArrow direction="up-right"/></a></footer>
    </div>
  </div>
  <p class="sr-only" data-history-announcement role="status" aria-live="polite"></p>
  <script type="application/json" data-history-prototype-data set:html={JSON.stringify({records:metadata,paths:historyPaths.map(p=>({id:p.id,label:t(p.label,locale)})),eras:historyEras.map(e=>({id:e.id,label:t(e.label,locale)}))}).replace(/</g,'\\u003c')}></script>
</div>
<HistoryRecordDialog locale={locale}/>
<script>import {initHistoryPrototype} from '../lib/history-prototype';initHistoryPrototype();</script>
</BaseLayout>

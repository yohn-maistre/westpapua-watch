---
import featuredIds from '../../content/library-featured.json';
import OrganizationDirectory from '../components/resources/OrganizationDirectory.astro';
import {organizations} from '../../shared/organizations';
import {dossierBySlug} from '../data/dossiers';
import {followingSlugs} from '../data/topic-collections';
import ResourceList from '../components/resources/ResourceList.astro';
import {LIBRARY_GROUPS,libraryGroup} from '../../shared/library';
import ResourceFilters from '../components/resources/ResourceFilters';
import BaseLayout from '../layouts/BaseLayout.astro';
import {libraryItems as resources} from '../data/library';
import {glossary} from '../data/glossary';
import {issues} from '../data/issues';
import {t} from '../lib/i18n';
import type {Locale} from '../data/types';
const {locale='en'}=Astro.props as {locale?:Locale};
const TOPICS=issues.map(i=>[i.slug,i.title.en,i.title.pmy] as const);
const places=[...new Set(resources.flatMap(r=>r.places))].sort();
const years=[...new Set(resources.map(r=>r.year))].filter(y=>/^\d{4}$/.test(y)).sort((a,b)=>Number(b)-Number(a));
// Stable IDs preserve the edit across title changes.
const featured=featuredIds.map(id=>resources.find(item=>item.id===id)).filter((item):item is (typeof resources)[number]=>Boolean(item));
const indexItems=[['sites',locale==='en'?'Sites & organizations':'Situs & organisasi'],['catalogue',locale==='en'?'Library':'Pustaka'],['glossary',locale==='en'?'Terms':'Istilah']];
---
<BaseLayout locale={locale} active="resources" title={locale==='en'?'Resources':'Sumber'}>
<section class="section resources-index"><div class="wrap">
 <h1 class="page-title">{locale==='en'?'Resources.':'Sumber.'}</h1>
 <nav class="resource-jumps" data-resource-index aria-label={locale==='en'?'On this page':'Di halaman ini'}>{indexItems.map(([id,label],i)=><a href={`#${id}`}><small>0{i+1}</small><span>{label}</span><b aria-hidden="true">↓</b></a>)}</nav>
 <div id="sites" class="resource-sites"><OrganizationDirectory locale={locale} expanded/></div>
 <section id="catalogue" class="resource-library">
 <div class="resource-library-heading"><h2 class="resource-library-title">{locale==='en'?'Library.':'Pustaka.'}</h2><p>{locale==='en'?'Research, documents, films and archives.':'Riset, dokumen, film, dan arsip.'}</p></div>
 <div class="resource-featured" data-resource-featured aria-label={locale==='en'?'Featured library items':'Pilihan pustaka'}><div class="resource-featured-grid">{featured.map((item,i)=><a class:list={['resource-featured-item',i===0&&'is-lead',`tone-${libraryGroup(item.itemType)}`]} href={item.url} target="_blank" rel="noreferrer" style={`--feature-index:${i}`}><span class="resource-featured-meta"><small>{LIBRARY_GROUPS.find(g=>g[0]===libraryGroup(item.itemType))?.[locale==='pmy'?2:1]}</small><small>{String(i+1).padStart(2,'0')}</small></span>{item.visual&&<img src={item.visual.url} alt="" loading="lazy" referrerpolicy="no-referrer"/>}<strong>{item.title}</strong><span class="resource-featured-footer"><span class="resource-featured-byline">{item.authors[0]||item.publisher} · {item.year}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></span></a>)}</div></div>
 <div class="resource-tools"><input class="resource-search" data-resource-search type="search" aria-label={locale==='en'?'Search library':'Cari pustaka'} placeholder={locale==='en'?'Search library':'Cari pustaka'} /><label class="resource-sort" data-resource-sort-wrap hidden><span class="sr-only">{locale==='en'?'Sort':'Urutkan'}</span><select data-resource-sort><option value="relevance">{locale==='en'?'Relevance':'Relevansi'}</option><option value="newest">{locale==='en'?'Newest':'Terbaru'}</option><option value="az">A–Z</option></select></label></div>
 <ResourceFilters client:load locale={locale} facets={[
  {key:'organization',label:locale==='en'?'Organization':'Organisasi',options:organizations.map(o=>[o.id,o.name])},
  {key:'following',label:locale==='en'?'Following':'Dalam pantauan',options:followingSlugs.map(slug=>dossierBySlug[slug]).map(d=>[d.slug,t(d.title,locale)])},
  {key:'topic',label:locale==='en'?'Topics':'Topik',options:TOPICS.map(([v,en,id])=>[v,locale==='en'?en:id])},
  {key:'type',label:locale==='en'?'Type':'Jenis',options:LIBRARY_GROUPS.map(([v,en,id])=>[v,locale==='en'?en:id])},
  {key:'year',label:locale==='en'?'Year':'Tahun',options:years.map(y=>[y,y])},
  {key:'place',label:locale==='en'?'Place':'Lokasi',options:places.map(p=>[p,p])},
  {key:'language',label:locale==='en'?'Language':'Bahasa',options:[['id','Indonesia'],['en','English'],['multi',locale==='en'?'Multilingual':'Multibahasa']]}
 ]}/><noscript><p>{locale==='en'?'All resources are listed below.':'Semua sumber ada di bawah.'}</p></noscript>
 <div class="resource-results-bar"><p data-resource-count role="status"></p><button class="chip" type="button" data-resource-reset hidden>{locale==='en'?'Reset filters':'Atur ulang'}</button></div>
 <p data-resource-empty hidden>{locale==='en'?'No resources match these filters.':'Tidak ada sumber yang cocok.'}</p>
 <ResourceList items={resources} locale={locale}/><div class="library-more"><button type="button" class="chip" data-resource-more hidden>{locale==='en'?'Show more':'Tampilkan lagi'}</button><button type="button" class="chip" data-resource-export>{locale==='en'?'Export results':'Ekspor hasil'}</button></div>
 </section></div></section>
<section class="section" id="glossary"><div class="wrap"><div class="section-head section-head-simple"><h2>{locale==='en'?'Terms & concepts.':'Istilah & konsep.'}</h2></div><div class="glossary-grid">{glossary.map(item=><article class="term-card" id={item.slug}><h3>{item.term}</h3><p>{t(item.definition,locale)}</p></article>)}</div></div></section>
<a href="#" class="resource-to-top" data-resource-floating hidden aria-label={locale==='en'?'Back to top':'Kembali ke atas'} title={locale==='en'?'Back to top':'Kembali ke atas'}>↑</a>
<script>
import {fetchJSON} from '../lib/http';
const table=document.querySelector<HTMLElement>('[data-resource-table]'),input=document.querySelector<HTMLInputElement>('[data-resource-search]'),sort=document.querySelector<HTMLSelectElement>('[data-resource-sort]'),sortWrap=document.querySelector<HTMLElement>('[data-resource-sort-wrap]'),featured=document.querySelector<HTMLElement>('[data-resource-featured]');
featured?.querySelectorAll<HTMLImageElement>('img').forEach(img=>{img.addEventListener('error',()=>img.remove(),{once:true});if(img.complete&&!img.naturalWidth)img.remove()});
const params=new URL(location.href).searchParams;if(input)input.value=params.get('q')||'';
let selected:Record<string,string[]>={};for(const k of ['organization','following','topic','type','language','place','year'])selected[k]=(params.get(k)||'').split(',').filter(v=>v&&v!=='all');
let visibleLimit=36;
const terms=(q:string)=>q.toLowerCase().replace(/[^\p{L}\p{N}\s-]/gu,' ').split(/\s+/).filter(Boolean);
const weighted=(row:HTMLElement,q:string)=>{let total=0;for(const word of terms(q)){let score=0;if((row.dataset.resourceTitle||'').includes(word))score+=12;if((row.dataset.resourceAuthors||'').includes(word))score+=8;if((row.dataset.resourcePublisher||'').includes(word))score+=6;if(`${row.dataset.resourceBroad||''} ${row.dataset.resourcePlaces||''}`.toLowerCase().includes(word))score+=4;if((row.dataset.resourceDescription||'').includes(word))score+=2;if((row.dataset.resourceSearch||'').includes(word))score+=1;if(!score)return 0;total+=score}return total};
const apply=()=>{const term=(input?.value||'').trim().toLowerCase(),hasFilters=Object.values(selected).some(v=>v.length),matches=(key:string,values:string[])=>!selected[key]?.length||selected[key].some(v=>values.includes(v));const rows=[...document.querySelectorAll<HTMLElement>('[data-resource-row]')];
 for(const row of rows){const languages=(row.dataset.resourceLanguages||'').split(/\s+/).filter(Boolean);if(languages.length>1)languages.push('multi');const s=term?weighted(row,term):0;row.dataset.resourceScore=String(s);row.hidden=!(matches('organization',(row.dataset.resourceOrganizations||'').split(' '))&&matches('following',(row.dataset.resourceFollowing||'').split(' '))&&matches('language',languages)&&matches('topic',(row.dataset.resourceBroad||'').split(' '))&&matches('type',[row.dataset.resourceType||''])&&matches('year',[row.dataset.resourceYear||''])&&matches('place',JSON.parse(row.dataset.resourcePlaces||'[]'))&&(!term||s>0))}
 let matched=rows.filter(r=>!r.hidden);if(term&&table){const mode=sort?.value||'relevance';matched.sort((a,b)=>mode==='newest'?Number(b.dataset.resourceYear||0)-Number(a.dataset.resourceYear||0):mode==='az'?(a.dataset.resourceTitle||'').localeCompare(b.dataset.resourceTitle||''):Number(b.dataset.resourceScore||0)-Number(a.dataset.resourceScore||0));for(const row of matched)table.append(row)}for(const row of rows)row.dataset.resourceMatch=String(!row.hidden);const count=matched.length;matched.forEach((row,i)=>row.hidden=i>=visibleLimit);const more=document.querySelector<HTMLButtonElement>('[data-resource-more]');if(more)more.hidden=count<=visibleLimit;const label=document.querySelector('[data-resource-count]');if(label)label.textContent=`${count} / ${rows.length}`;const empty=document.querySelector<HTMLElement>('[data-resource-empty]');if(empty)empty.hidden=count!==0;const reset=document.querySelector<HTMLButtonElement>('[data-resource-reset]');if(reset)reset.hidden=!term&&!hasFilters;if(sortWrap)sortWrap.hidden=!term;if(featured)featured.hidden=!!term||hasFilters;
 const url=new URL(location.href);for(const key of ['organization','following','topic','type','language','place','year']){const value=selected[key]?.join(',');if(value)url.searchParams.set(key,value);else url.searchParams.delete(key)}if(term)url.searchParams.set('q',input!.value);else url.searchParams.delete('q');history.replaceState(null,'',url)};
document.addEventListener('watch:resource-filter',e=>{selected=(e as CustomEvent).detail;visibleLimit=36;apply()});document.querySelector('[data-resource-reset]')?.addEventListener('click',()=>{selected={};if(input)input.value='';document.dispatchEvent(new Event('watch:resource-reset'));apply()});input?.addEventListener('input',()=>{visibleLimit=36;apply()});sort?.addEventListener('change',apply);document.querySelector('[data-resource-more]')?.addEventListener('click',()=>{visibleLimit+=36;apply()});document.addEventListener('watch:library-loaded',apply);apply();
const opening=document.querySelector('[data-resource-index]'),floating=document.querySelector<HTMLElement>('[data-resource-floating]');if(opening&&floating)new IntersectionObserver(([entry])=>floating.hidden=entry.isIntersecting,{rootMargin:'-90px 0px 0px'}).observe(opening);
document.querySelector<HTMLButtonElement>('[data-resource-export]')?.addEventListener('click',async e=>{const button=e.currentTarget as HTMLButtonElement;button.disabled=true;try{let data;try{data=await fetchJSON('/api/resources')}catch{data=await fetchJSON('/library.json')}const ids=new Set([...document.querySelectorAll<HTMLElement>('[data-resource-match="true"]')].map(r=>r.dataset.resourceId));const items=(data.items||[]).filter((r:any)=>ids.has(r.id));const blob=new Blob([JSON.stringify({exportedAt:new Date().toISOString(),items},null,2)],{type:'application/json'});const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='west-papua-watch-library.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}catch{button.textContent=document.documentElement.lang==='id'?'Coba lagi':'Try export again'}finally{button.disabled=false}});
</script>
</BaseLayout>
<style>
.resource-jumps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin:1.25rem 0 clamp(3rem,6vw,5rem);border-block:1px solid var(--line)}
.resource-jumps a{display:grid;grid-template-columns:1fr auto;align-items:center;gap:.35rem;min-height:72px;padding:.8rem 1rem .8rem 0;border-right:1px solid var(--line);font-size:clamp(.82rem,1.25vw,1.12rem);letter-spacing:-.025em;transition:color .2s,padding-left .2s}
.resource-jumps a+a{padding-left:1rem}.resource-jumps a:last-child{border-right:0}.resource-jumps small{grid-column:1/-1;color:var(--muted);font-size:.6rem;letter-spacing:.08em}.resource-jumps b{font-weight:400;font-size:.9rem;color:#c5bce0}.resource-jumps a:hover{color:#d1c7f3;padding-left:1.3rem}
.resource-sites,.resource-library,#glossary{scroll-margin-top:calc(var(--compact-nav-actual-height,110px) + 24px)}
.resource-library{margin-top:clamp(4rem,7vw,7rem)}.resource-library-heading{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:1rem 3rem;padding-bottom:1.5rem;border-bottom:0}
.resource-library-title{font-size:clamp(3.5rem,8vw,8.5rem);line-height:.84;letter-spacing:-.075em;margin:0}.resource-library-heading p{max-width:34ch;color:var(--muted);font-size:clamp(.9rem,1.3vw,1.05rem);line-height:1.5;margin:0}
.resource-featured{margin:1.5rem 0 4rem}.resource-featured[hidden]{display:none}
.resource-featured-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:minmax(180px,auto);gap:1px;background:var(--line);border:0}
.resource-featured-item{--feature-glow:#8783a9;position:relative;isolation:isolate;display:flex;flex-direction:column;justify-content:flex-end;gap:.7rem;min-width:0;min-height:180px;padding:1.2rem;background:#0c0f17;overflow:hidden;transition:background .2s}
.resource-featured-item::before{content:"";position:absolute;z-index:-1;inset:0;background:radial-gradient(ellipse at 90% 0%,var(--feature-glow),transparent 68%);opacity:.26;transition:opacity .3s}.resource-featured-item:hover{background:#111520}.resource-featured-item:hover::before{opacity:.43}
.resource-featured-item.tone-book{--feature-glow:#b5856c}.resource-featured-item.tone-report{--feature-glow:#8776ad}.resource-featured-item.tone-research{--feature-glow:#7893b8}.resource-featured-item.tone-document{--feature-glow:#9d895e}.resource-featured-item.tone-data{--feature-glow:#6b9d8b}.resource-featured-item.tone-media{--feature-glow:#a86c83}.resource-featured-item.tone-archive{--feature-glow:#938176}.resource-featured-item.tone-analysis{--feature-glow:#7397a4}
.resource-featured-item.is-lead{grid-column:span 2;grid-row:span 2;padding:clamp(1.5rem,3vw,3rem)}.resource-featured-meta{display:flex;justify-content:space-between;gap:1rem;margin-bottom:auto}.resource-featured-meta small,.resource-featured-byline{position:relative;z-index:2;color:#b2b1c0;font-size:.66rem;line-height:1.35}.resource-featured-meta small:first-child{text-transform:uppercase;letter-spacing:.09em}.resource-featured-item strong{position:relative;z-index:2;display:block;max-width:21ch;font-size:clamp(1.12rem,1.7vw,1.65rem);line-height:1.12;letter-spacing:-.04em;text-wrap:balance}.resource-featured-item.is-lead strong{font-size:clamp(2rem,3.5vw,3.8rem);line-height:.98;max-width:14ch}.resource-featured-item img{position:absolute;right:3%;top:15%;height:58%;max-width:42%;object-fit:contain;opacity:.48;filter:drop-shadow(0 10px 20px #0006);mask-image:linear-gradient(#000 50%,transparent 100%)}.resource-featured-item.is-lead img{right:5%;top:8%;height:68%;max-width:49%;opacity:.65}.resource-featured-footer{display:grid;grid-template-columns:minmax(0,1fr) 17px;gap:.7rem;align-items:end;position:relative;z-index:2}.resource-featured-item svg{position:static;width:17px;fill:none;stroke:#c8c1d5;stroke-width:1.5}
.resource-tools{display:flex;gap:.7rem;align-items:center}.resource-search{flex:1}.resource-sort select{min-height:44px;border:1px solid var(--line);background:#11151d;color:inherit;border-radius:12px;padding:0 1rem}
.resource-to-top{position:fixed;z-index:40;right:max(12px,env(safe-area-inset-right));bottom:max(12px,env(safe-area-inset-bottom));display:grid;place-items:center;width:40px;height:40px;border:1px solid #ffffff25;border-radius:50%;background:#141821df;backdrop-filter:blur(12px);box-shadow:0 8px 28px #0004;font-size:1rem}.resource-to-top[hidden]{display:none!important}
@media(max-width:760px){.resource-jumps{grid-template-columns:1fr;margin-bottom:4rem}.resource-jumps a,.resource-jumps a+a{min-height:62px;padding:1rem 0;border-right:0;border-bottom:1px solid var(--line)}.resource-jumps a:last-child{border-bottom:0}.resource-jumps small{grid-column:auto}.resource-jumps a:hover{padding-left:.5rem}.resource-library-heading{grid-template-columns:1fr;gap:1rem}.resource-library-heading p{margin:0}.resource-featured-grid{display:flex;gap:1px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain}.resource-featured-grid::-webkit-scrollbar{display:none}.resource-featured-item,.resource-featured-item.is-lead{flex:0 0 min(78vw,320px);min-height:265px;padding:1.3rem;scroll-snap-align:start}.resource-featured-item.is-lead strong{font-size:clamp(1.65rem,7vw,2.4rem)}.resource-featured-item strong{font-size:1.35rem}.resource-featured-item img{height:55%;top:9%}.resource-tools{align-items:stretch}.resource-sort select{max-width:128px}}
@media(max-width:760px){
 .resources-index .resource-jumps{grid-template-columns:repeat(3,minmax(0,1fr));margin-bottom:3.5rem}
 .resources-index .resource-jumps a,.resources-index .resource-jumps a+a{display:grid;grid-template-columns:1fr auto;align-items:end;min-height:80px;padding:.7rem .4rem .7rem 0;border-right:1px solid var(--line);border-bottom:0;gap:.3rem;font-size:clamp(.75rem,2.4vw,.94rem);line-height:1.15}
 .resources-index .resource-jumps a+a{padding-left:.6rem}.resources-index .resource-jumps a:last-child{border-right:0}.resources-index .resource-jumps small{grid-column:1/-1;align-self:start}.resources-index .resource-jumps b{font-size:.75rem}
 .resource-library-heading{display:block}.resource-library-heading p{margin:.85rem 0 0}
 .resource-featured-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));overflow:visible;scroll-snap-type:none}
 .resource-featured-item,.resource-featured-item.is-lead{grid-column:auto;grid-row:auto;min-height:220px;padding:1rem;scroll-snap-align:none;gap:.5rem}
 .resource-featured-item strong,.resource-featured-item.is-lead strong{font-size:clamp(1rem,3.4vw,1.35rem);line-height:1.12;max-width:none;overflow-wrap:anywhere}
 .resource-featured-item img,.resource-featured-item.is-lead img{right:2%;top:8%;height:47%;max-width:68%;opacity:.32}
 .resource-tools{align-items:stretch}.resource-sort select{max-width:128px}
}
</style>
<script>if([...new URL(location.href).searchParams.keys()].some(k=>['q','organization','following','topic','type','place','language'].includes(k)))document.getElementById('catalogue')?.scrollIntoView();</script>

<style>
@media(max-width:760px){.resource-featured-item:last-child:nth-child(odd){grid-column:1/-1}}
</style>

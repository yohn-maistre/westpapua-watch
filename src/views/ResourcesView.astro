---
import BaseLayout from '../layouts/BaseLayout.astro';import { resources } from '../data/resources';import { glossary } from '../data/glossary';import { topicTagBySlug } from '../data/taxonomy';import { t } from '../lib/i18n';import type { Locale } from '../data/types';import ui from '../../content/ui.json';
const {locale='en'}=Astro.props as {locale?:Locale};const usedTags=[...new Set(resources.flatMap(r=>r.tags))];const label=(slug:string)=>topicTagBySlug[slug]?.label?.[locale==='pmy'?'id':'en']||slug;
---
<BaseLayout locale={locale} active="resources" title={locale==='en'?'Resources':'Sumber'}>
<section class="section resources-index"><div class="wrap"><h1 class="page-title">{ui.resources.pageTitle[locale]}</h1><p class="page-intro">{ui.resources.intro[locale]}</p>
<div class="resource-tools"><input class="resource-search" data-resource-search placeholder={locale==='en'?'Search resources':'Cari sumber'} /><div class="filters" style="margin:0"><button class="filter active" data-resource-filter="all">{locale==='en'?'All':'Semua'}</button>{usedTags.map(slug=><button class="filter" data-resource-filter={slug}>{label(slug)}</button>)}</div></div>
<div class="resource-table" data-resource-table>{resources.map(r=><a class="resource-row" data-resource-row data-resource-type={r.type} data-resource-tags={r.tags.join(' ')} href={r.url} target="_blank" rel="noreferrer"><span class="type">{r.type}</span><div><h2>{r.title}</h2><p>{r.publisher}</p>{r.tags.length>0&&<p class="resource-topic-line">{r.tags.slice(0,3).map(label).join(' · ')}</p>}</div><p>{r.language?.toUpperCase()}</p><span>{r.year}</span></a>)}</div>
</div></section>
<section class="section" id="glossary"><div class="wrap"><div class="section-head section-head-simple"><h2>{locale==='en'?'Terms & concepts.':'Istilah & konsep.'}</h2></div><div class="glossary-grid">{glossary.map(item=><article class="term-card" id={item.slug}><h3>{item.term}</h3><p>{t(item.definition,locale)}</p></article>)}</div></div></section>
<script>
  const table=document.querySelector<HTMLElement>('[data-resource-table]');const input=document.querySelector<HTMLInputElement>('[data-resource-search]');const filters=[...document.querySelectorAll<HTMLElement>('[data-resource-filter]')];let active=filters.find(x=>x.classList.contains('active'))?.dataset.resourceFilter||'all';
  const apply=()=>{const term=(input?.value||'').toLowerCase();for(const row of document.querySelectorAll<HTMLElement>('[data-resource-row]')){const tags=(row.dataset.resourceTags||'').split(/\s+/).filter(Boolean);const matchTag=active==='all'||tags.includes(active);row.hidden=!(matchTag&&(!term||(row.textContent||'').toLowerCase().includes(term)))}};
  filters.forEach(button=>button.addEventListener('click',()=>{active=button.dataset.resourceFilter||'all';filters.forEach(x=>x.classList.toggle('active',x===button));apply()}));input?.addEventListener('input',apply);
  if(table)fetch('/api/resources',{headers:{accept:'application/json'}}).then(r=>r.ok?r.json():null).then(data=>{const existing=new Set([...table.querySelectorAll<HTMLAnchorElement>('a.resource-row')].map(x=>x.href));for(const item of data?.items||[]){if(existing.has(item.source_url))continue;const row=document.createElement('a');row.className='resource-row';row.dataset.resourceRow='';row.dataset.resourceType=item.kind||'reference';row.href=item.source_url;row.target='_blank';row.rel='noreferrer';const kind=document.createElement('span');kind.className='type';kind.textContent=item.kind||'reference';const main=document.createElement('div');const title=document.createElement('h2');title.textContent=item.title;const publisher=document.createElement('p');publisher.textContent=item.publisher_id||'';main.append(title,publisher);const tags=document.createElement('p');let parsed:string[]=[];try{parsed=JSON.parse(item.tags_json||'[]').slice(0,3);tags.textContent=parsed.join(' · ')}catch{tags.textContent=''}row.dataset.resourceTags=parsed.join(' ');const year=document.createElement('span');year.textContent=item.updated_at?new Date(item.updated_at).getFullYear().toString():'';row.append(kind,main,tags,year);table.append(row)}apply()}).catch(()=>{});
</script>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import {publicRecords,recordById} from '../data/records';
import {libraryItems} from '../data/library';
import ResourceList from '../components/resources/ResourceList.astro';
import {withLocale} from '../lib/i18n';
import '../styles/public-record.css';
const {record:r,locale='en'}=Astro.props;const en=locale==='en';const items=libraryItems.filter(i=>r.libraryIds.includes(i.id));const related=publicRecords.filter(x=>x.id!==r.id&&(x.relations.some(a=>a.target===r.id)||r.relations.some(a=>a.target===x.id)));
---
<BaseLayout locale={locale} active="data" title={r.title}><main class="wrap record-page"><a href={withLocale('/data/',locale)}>← {en?'Data':'Data'}</a><div class="record-heading"><span class="eyebrow">{r.kind}</span><h1>{r.title}</h1><p>{r.description}</p></div>
{r.observations.length>0&&<section><h2>{en?'Observations':'Pengamatan'}</h2><div class="record-table-wrap"><table><thead><tr>{(en?['Metric','Value','Unit','Period','Place','Measure','Source']:['Indikator','Nilai','Satuan','Periode','Wilayah','Ukuran','Sumber']).map(s=><th scope="col">{s}</th>)}</tr></thead><tbody>{r.observations.map(o=><tr><td>{o.metric}</td><td>{o.value.toLocaleString(en?'en-GB':'id-ID')}</td><td>{o.unit}</td><td>{o.period}</td><td>{o.place}</td><td>{o.measure}</td><td><a href={o.source.url}>{o.source.publisher} ↗</a></td></tr>)}</tbody></table></div></section>}
{related.length>0&&<section><h2>{en?'Related records':'Catatan terkait'}</h2><div class="record-links">{related.map(x=><a href={withLocale(`/data/${x.slug}/`,locale)}>{x.title} ↗</a>)}</div></section>}
{r.relations.length>0&&<section><h2>{en?'Relationships':'Hubungan'}</h2>{r.relations.map(rel=><p>{rel.predicate}: <a href={withLocale(`/data/${recordById.get(rel.target)?.slug}/`,locale)}>{recordById.get(rel.target)?.title||rel.target}</a> · <a href={rel.evidence.url}>{en?'Source':'Sumber'} ↗</a></p>)}</section>}
{items.length>0&&<section><h2>{en?'Library':'Pustaka'}</h2><ResourceList items={items} locale={locale} staticOnly/></section>}
<section class="record-sources"><h2>{en?'Sources':'Sumber'}</h2>{r.sources.map(s=><div><a href={s.url} target="_blank" rel="noreferrer">{s.publisher} ↗</a>{s.publishedAt&&<time>{s.publishedAt}</time>}{s.retrievedAt&&<small>{en?'Checked':'Diperiksa'} {s.retrievedAt}</small>}{s.note&&<p>{s.note}</p>}</div>)}</section>
<a class="chip" href={`/data/${r.slug}.json`} download>{en?'Download record':'Unduh catatan'} ↓</a></main></BaseLayout>

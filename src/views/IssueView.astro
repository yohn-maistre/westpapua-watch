---
import BaseLayout from '../layouts/BaseLayout.astro';import SourceList from '../components/SourceList.astro';import { developments } from '../data/developments';import { glossaryBySlug } from '../data/glossary';import { sourceById } from '../data/sources';import { t, withLocale } from '../lib/i18n';import type { Issue,Locale } from '../data/types';
const {locale='en',issue}=Astro.props as {locale?:Locale;issue:Issue};
const devs=developments.filter(d=>issue.developmentSlugs.includes(d.slug));
const reportingIds=issue.sourceIds.filter(id=>sourceById[id]?.type==='journalism');
const referenceIds=issue.sourceIds.filter(id=>sourceById[id]?.type!=='journalism');
---
<BaseLayout locale={locale} active="issues" title={t(issue.title,locale)} description={t(issue.summary,locale)}>
  <div class="wrap"><section class="dossier-head issue-head"><div><div class="eyebrow">{issue.category}</div><h1>{t(issue.title,locale)}</h1><p>{t(issue.summary,locale)}</p><div class="actions">{issue.concepts.filter(c=>glossaryBySlug[c]).slice(0,4).map(c=><a class="chip" href={withLocale(`/resources/#${c}`,locale)}>{glossaryBySlug[c].term}</a>)}<a class="chip" href={withLocale('/history/',locale)}>{locale==='en'?'History':'Sejarah'}</a></div></div><aside class="facts"><div class="fact"><span>{locale==='en'?'Status':'Status'}</span><strong>{t(issue.status,locale)}</strong></div><div class="fact"><span>{locale==='en'?'Updated':'Diperbarui'}</span><strong>{issue.updatedAt}</strong></div><div class="fact"><span>{locale==='en'?'Updates':'Pembaruan'}</span><strong>{devs.length}</strong></div><div class="fact"><span>{locale==='en'?'Sources':'Sumber'}</span><strong>{issue.sourceIds.length}</strong></div></aside></section>
    <div class="dossier-grid"><section class="box"><h2>{locale==='en'?'Overview':'Ringkasan'}</h2><p>{t(issue.summary,locale)}</p></section><section class="box"><h2>{locale==='en'?'Updates':'Pembaruan'}</h2>{devs.length?devs.map(d=><p class="issue-update"><a href={withLocale('/',locale)}><strong>{t(d.title,locale)}</strong></a><br/><small>{d.updatedAt} · {d.sourceIds.length} {locale==='en'?'sources':'sumber'}</small></p>):<p>{locale==='en'?'No new update has been attached yet.':'Belum ada pembaruan baru yang ditautkan.'}</p>}</section></div>
    {reportingIds.length>0 && <section class="section issue-sources"><div class="section-head section-head-simple"><h2>{locale==='en'?'Latest reporting.':'Laporan terbaru.'}</h2></div><SourceList sourceIds={reportingIds}/></section>}
    <section class="section issue-sources" id="sources"><div class="section-head section-head-simple"><h2>{locale==='en'?'Sources.':'Sumber.'}</h2></div><SourceList sourceIds={referenceIds.length?referenceIds:issue.sourceIds}/></section>
  </div>
</BaseLayout>

---
import followingNotes from '../../content/following.json';
import ResourceList from '../components/resources/ResourceList.astro';
import {libraryForTopic} from '../data/library';
import TopicTimeline from '../components/TopicTimeline.astro';
import {topicTimelines} from '../data/topic-timelines';
import BaseLayout from '../layouts/BaseLayout.astro';
import MapShell from '../components/map/MapShell.astro';
import SourceList from '../components/SourceList.astro';
import { developments } from '../data/developments';
import { glossaryBySlug } from '../data/glossary';
import { sourceById } from '../data/sources';
import { t,withLocale } from '../lib/i18n';
import type { Issue,Locale } from '../data/types';
import type {MapViewId} from '../lib/map/registry';
const {locale='en',issue}=Astro.props as {locale?:Locale;issue:Issue};
const background=followingNotes.find(x=>x.slug===issue.slug)?.background;
const devs=developments.filter(d=>issue.developmentSlugs.includes(d.slug));
const reportingIds=issue.sourceIds.filter(id=>sourceById[id]?.type==='journalism');
const relatedLibrary=libraryForTopic(issue.slug);
const referenceIds=issue.sourceIds.filter(id=>sourceById[id]?.type!=='journalism');
const umbrellaSlugs=new Set([
  'land-indigenous-rights','extraction-industrial-development','environment-biodiversity','climate-disasters',
  'human-rights-conflict-security','politics-governance-representation','economy-livelihoods','health-food-public-services',
  'education-language-culture','women-gender-social-inclusion','infrastructure-connectivity'
]);
const isUmbrella=umbrellaSlugs.has(issue.slug);
const mapView:MapViewId=
  issue.slug==='climate-disasters'?'climate':
  issue.slug==='extraction-industrial-development'||issue.slug==='land-indigenous-rights'||issue.slug.includes('raja')||issue.slug.includes('south-papua')||issue.slug.includes('freeport')?'extraction':
  issue.slug==='environment-biodiversity'||issue.slug==='climate-disasters'||issue.slug==='health-food-public-services'||issue.slug.includes('sentani')?'environment':
  issue.slug==='infrastructure-connectivity'?'infrastructure':
  issue.slug==='human-rights-conflict-security'||issue.slug.includes('conflict')||issue.slug.includes('displacement')?'conflict':'overview';
---
<BaseLayout locale={locale} active="issues" title={t(issue.title,locale)} description={t(issue.summary,locale)}>
<div class="wrap">
  <a class="story-back issue-back" href={withLocale('/topics/#following',locale)}>← {locale==='en'?'Following':'Dalam pantauan'}</a>

  <h1 class="page-title issue-page-title">{t(issue.title,locale)}</h1>


  <section class="issue-map-meta" id="overview" data-issue-page data-issue-slug={issue.slug} data-issue-kind={isUmbrella?'issue':'dossier'} data-locale={locale}>
    <div class="issue-map-copy">

      <p data-live-issue-summary>{t(issue.summary,locale)}</p>
      <div class="actions">{issue.concepts.filter(c=>glossaryBySlug[c]).slice(0,4).map(c=><a class="chip" href={withLocale(`/resources/#${c}`,locale)}>{glossaryBySlug[c].term}</a>)}<a class="chip" href={withLocale('/history/',locale)}>{locale==='en'?'History':'Sejarah'}</a></div>
    </div>
    <aside class="facts">

      <div class="fact"><span>{locale==='en'?'Updated':'Diperbarui'}</span><strong data-live-issue-updated>{issue.updatedAt}</strong></div>
      <div class="fact"><span>{locale==='en'?'Stories':'Berita'}</span><strong data-live-issue-count>{devs.length}</strong></div>
      <div class="fact"><span>{locale==='en'?'Sources':'Sumber'}</span><strong data-live-source-count>{issue.sourceIds.length}</strong></div>
    </aside>
  </section>

  {background&&<section class="following-background"><h2>{locale==='en'?'Background':'Latar belakang'}</h2><div><p>{t(background,locale)}</p><SourceList sourceIds={issue.sourceIds}/></div></section>}
  <nav class="topic-local-index" aria-label={locale==='en'?'On this page':'Di halaman ini'}><a href="#overview">{locale==='en'?'Overview':'Ringkasan'}</a><a href="#latest">{locale==='en'?'Latest':'Terbaru'}</a>{topicTimelines[issue.slug]&&<a href="#timeline">{locale==='en'?'Timeline':'Linimasa'}</a>}<a href="#sources">{locale==='en'?'Library':'Pustaka'}</a><a href="#places">{locale==='en'?'Places':'Lokasi'}</a></nav><div class="dossier-grid">

    <section class="box" id="latest"><h2>{locale==='en'?'Latest stories':'Berita terbaru'}</h2><div data-live-issue-updates data-issue-slug={issue.slug} data-locale={locale}>{devs.map(d=><p class="issue-update"><a href={withLocale('/',locale)}><strong>{t(d.title,locale)}</strong></a><br/><small>{d.updatedAt} · {d.sourceIds.length} {locale==='en'?'sources':'sumber'}</small></p>)}</div></section>
  </div>

  <TopicTimeline slug={issue.slug} locale={locale}/><div id="places"></div><MapShell locale={locale} mode="context" context="issue" contextValue={issue.slug} initialView={mapView} />

  <section class="section issue-sources"><div class="section-head section-head-simple"><h2>{locale==='en'?'Latest reporting.':'Laporan terbaru.'}</h2></div><div data-live-issue-reporting>{reportingIds.length?<SourceList sourceIds={reportingIds}/>:<p>{locale==='en'?'No indexed reporting yet.':'Belum ada laporan terindeks.'}</p>}</div></section>
  <section class="section issue-sources" id="sources"><div class="section-head section-head-simple"><h2>{locale==='en'?'Library.':'Pustaka.'}</h2><a href={withLocale('/resources/',locale)+'?topic='+issue.slug}>{locale==='en'?'Browse all ↗':'Lihat semua ↗'}</a></div><ResourceList items={relatedLibrary} locale={locale} topic={issue.slug}/></section>
</div>

<script>
const issuePage=document.querySelector<HTMLElement>('[data-issue-page]'),updates=document.querySelector<HTMLElement>('[data-live-issue-updates]'),slug=issuePage?.dataset.issueSlug||updates?.dataset.issueSlug||'',locale=issuePage?.dataset.locale==='pmy'?'pmy':'en';
if(issuePage&&slug)fetch(`/api/issue/${encodeURIComponent(slug)}`).then(r=>r.ok?r.json():null).then(data=>{
  if(!data)return;
  if(data.kind)issuePage.dataset.issueKind=data.kind;
  const set=(sel:string,v:any)=>{const n=document.querySelector<HTMLElement>(sel);if(n&&v!=null)n.textContent=String(v)};
  set('[data-live-issue-summary]',locale==='pmy'?(data.summary_id||data.summary_en):data.summary_en);
  set('[data-live-issue-overview]',locale==='pmy'?(data.summary_id||data.summary_en):data.summary_en);
  set('[data-live-issue-status]',locale==='pmy'?(data.status_id||data.status_en):data.status_en);
  if(!data.updated_at)set('[data-live-issue-updated]',locale==='pmy'?'Belum ada laporan':'No reports yet');
  if(data.updated_at)set('[data-live-issue-updated]',new Date(data.updated_at).toLocaleDateString(locale==='pmy'?'id-ID':'en-GB',{day:'numeric',month:'short',year:'numeric'}));
  set('[data-live-issue-count]',data.development_count||0);set('[data-live-source-count]',data.source_count||0);


  if(updates&&!data.developments?.length)updates.textContent=locale==='pmy'?'Belum ada berita terkait.':'No linked news yet.';
  if(updates&&data.developments?.length){
    const deltaByDev=new Map((data.deltas||[]).map((d:any)=>[Number(d.development_id),d]));const nodes=[];
    for(const dev of data.developments){
      const row=document.createElement('p');row.className='issue-update';const link=document.createElement('a');link.href=`${locale==='pmy'?'/pmy':''}${dev.story_url}`;
      const strong=document.createElement('strong');strong.textContent=locale==='pmy'?(dev.title_id||dev.title_en):dev.title_en;link.append(strong);
      const br=document.createElement('br'),meta=document.createElement('small');const published=dev.latest_report_at||dev.updated_at;meta.textContent=`${published?new Date(published).toLocaleDateString(locale==='pmy'?'id-ID':'en-GB',{day:'numeric',month:'short'}):''} · ${dev.article_count||1} ${locale==='pmy'?'laporan':'reports'} · ${dev.source_count} ${locale==='pmy'?'sumber':'sources'}`;row.append(link,br,meta);
      const delta:any=deltaByDev.get(Number(dev.id));if(delta?.delta_summary){const note=document.createElement('span');note.className='issue-live-delta';note.textContent=locale==='pmy'?(delta.delta_summary_id||delta.delta_summary):delta.delta_summary;row.append(note)}nodes.push(row)
    }updates.replaceChildren(...nodes)
  }
  const reporting=document.querySelector<HTMLElement>('[data-live-issue-reporting]');
  if(reporting&&data.reporting?.length){const ul=document.createElement('ul');ul.className='source-list';for(const r of data.reporting.slice(0,12)){const li=document.createElement('li'),a=document.createElement('a');a.href=r.canonical_url;a.target='_blank';a.rel='noreferrer';const main=document.createElement('span'),strong=document.createElement('strong'),small=document.createElement('small');strong.textContent=r.title;small.textContent=`${r.publisher}${r.published_at?' · '+new Date(r.published_at).toLocaleDateString(locale==='pmy'?'id-ID':'en-GB'):''}`;main.append(strong,small);const arrow=document.createElement('span');arrow.textContent='↗';a.append(main,arrow);li.append(a);ul.append(li)}reporting.replaceChildren(ul)}
}).catch(()=>{});
</script>
<style is:global>
.following-background{display:grid;grid-template-columns:1fr 2fr;gap:2rem;padding:2.5rem 0;border-top:1px solid var(--line)}.following-background h2{font-size:1.6rem;letter-spacing:-.04em;margin:0}.following-background p{font-size:1.05rem;line-height:1.8;max-width:65ch;color:var(--muted);margin:0 0 1.5rem}.following-background .source-list strong{font-size:.9rem!important}.following-background .source-list small{font-size:.72rem}@media(max-width:760px){.following-background{grid-template-columns:1fr;gap:1rem}}
.issue-back{display:inline-block;margin-top:2rem;margin-bottom:1rem;color:var(--muted)}
.issue-kind-label{display:block;margin-bottom:.8rem;font-size:.62rem;text-transform:uppercase;letter-spacing:.15em;color:rgba(247,247,251,.68)}
.issue-dossier-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
.issue-dossier-card{display:flex;flex-direction:column;min-height:220px;padding:1.25rem;border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(180deg,rgba(255,255,255,.025),rgba(255,255,255,.01))}
.issue-dossier-card small{font-size:.62rem;text-transform:uppercase;letter-spacing:.14em;color:var(--muted)}
.issue-dossier-card h3{font-size:clamp(1.8rem,3.3vw,3rem);line-height:.92;letter-spacing:-.05em;margin:1rem 0 .7rem}.issue-dossier-card p{margin:0;color:var(--muted)}
@media(max-width:700px){.issue-dossier-grid{grid-template-columns:1fr}}
</style>
</BaseLayout>

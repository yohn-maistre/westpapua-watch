---
import BaseLayout from '../layouts/BaseLayout.astro';import SourceList from '../components/SourceList.astro';import { developments } from '../data/developments';import { glossaryBySlug } from '../data/glossary';import { sourceById } from '../data/sources';import { t,withLocale } from '../lib/i18n';import type { Issue,Locale } from '../data/types';const {locale='en',issue}=Astro.props as {locale?:Locale;issue:Issue};const devs=developments.filter(d=>issue.developmentSlugs.includes(d.slug));const reportingIds=issue.sourceIds.filter(id=>sourceById[id]?.type==='journalism');const referenceIds=issue.sourceIds.filter(id=>sourceById[id]?.type!=='journalism');
---
<BaseLayout locale={locale} active="issues" title={t(issue.title,locale)} description={t(issue.summary,locale)}><div class="wrap"><section class="dossier-head issue-head"><div><div class="eyebrow">{issue.category}</div><h1>{t(issue.title,locale)}</h1><p>{t(issue.summary,locale)}</p><div class="actions">{issue.concepts.filter(c=>glossaryBySlug[c]).slice(0,4).map(c=><a class="chip" href={withLocale(`/resources/#${c}`,locale)}>{glossaryBySlug[c].term}</a>)}<a class="chip" href={withLocale('/history/',locale)}>{locale==='en'?'History':'Sejarah'}</a></div></div><aside class="facts"><div class="fact"><span>Status</span><strong>{t(issue.status,locale)}</strong></div><div class="fact"><span>{locale==='en'?'Updated':'Diperbarui'}</span><strong data-live-issue-updated>{issue.updatedAt}</strong></div><div class="fact"><span>{locale==='en'?'Updates':'Pembaruan'}</span><strong data-live-issue-count>{devs.length}</strong></div><div class="fact"><span>{locale==='en'?'Sources':'Sumber'}</span><strong data-live-source-count>{issue.sourceIds.length}</strong></div></aside></section><div class="dossier-grid"><section class="box"><h2>{locale==='en'?'Overview':'Ringkasan'}</h2><p>{t(issue.summary,locale)}</p><p class="issue-current-change" data-live-current-status hidden></p></section><section class="box"><h2>{locale==='en'?'Updates':'Pembaruan'}</h2><div data-live-issue-updates data-issue-slug={issue.slug} data-locale={locale}>{devs.map(d=><p class="issue-update"><a href={withLocale('/',locale)}><strong>{t(d.title,locale)}</strong></a><br/><small>{d.updatedAt} · {d.sourceIds.length} {locale==='en'?'sources':'sumber'}</small></p>)}</div></section></div><section class="section issue-sources"><div class="section-head section-head-simple"><h2>{locale==='en'?'Latest reporting.':'Laporan terbaru.'}</h2></div><div data-live-issue-reporting>{reportingIds.length?<SourceList sourceIds={reportingIds}/>:<p>{locale==='en'?'Live reporting will appear here when the Watch Engine has an update.':'Laporan live akan muncul di sini waktu Watch Engine dapat pembaruan.'}</p>}</div></section><section class="section issue-sources" id="sources"><div class="section-head section-head-simple"><h2>{locale==='en'?'Sources.':'Sumber.'}</h2></div><SourceList sourceIds={referenceIds.length?referenceIds:issue.sourceIds}/></section></div>
<script>
const updates=document.querySelector<HTMLElement>('[data-live-issue-updates]'),slug=updates?.dataset.issueSlug||'',locale=updates?.dataset.locale==='pmy'?'pmy':'en';if(updates&&slug)fetch(`/api/issue/${encodeURIComponent(slug)}`).then(r=>r.ok?r.json():null).then(data=>{if(!data?.developments?.length)return;const deltaByDev=new Map((data.deltas||[]).map((d:any)=>[Number(d.development_id),d]));const nodes=[];for(const dev of data.developments){const row=document.createElement('p');row.className='issue-update';const link=document.createElement('a');link.href=`${locale==='pmy'?'/pmy':''}${dev.story_url}`;const strong=document.createElement('strong');strong.textContent=locale==='pmy'?(dev.title_id||dev.title_en):dev.title_en;link.append(strong);const br=document.createElement('br'),meta=document.createElement('small');meta.textContent=`${dev.updated_at?new Date(dev.updated_at).toLocaleDateString(locale==='pmy'?'id-ID':'en-GB',{day:'numeric',month:'short'}):''} · ${dev.source_count} ${locale==='pmy'?'sumber':'sources'}`;row.append(link,br,meta);const delta:any=deltaByDev.get(Number(dev.id));if(delta?.delta_summary){const note=document.createElement('span');note.className='issue-live-delta';note.textContent=locale==='pmy'?(delta.delta_summary_id||delta.delta_summary):delta.delta_summary;row.append(note)}nodes.push(row)}updates.replaceChildren(...nodes);const count=document.querySelector<HTMLElement>('[data-live-issue-count]'),sources=document.querySelector<HTMLElement>('[data-live-source-count]'),updated=document.querySelector<HTMLElement>('[data-live-issue-updated]'),status=document.querySelector<HTMLElement>('[data-live-current-status]');if(count)count.textContent=String(data.development_count||0);if(sources)sources.textContent=String(data.source_count||0);if(updated&&data.updated_at)updated.textContent=new Date(data.updated_at).toISOString().slice(0,10);if(status&&data.current_status){status.hidden=false;status.textContent=`${locale==='pmy'?'Perubahan terbaru':'Latest change'}: ${locale==='pmy'?(data.current_status.id||data.current_status.en):(data.current_status.en||data.current_status.id)}`}const reporting=document.querySelector<HTMLElement>('[data-live-issue-reporting]');if(reporting&&data.reporting?.length){const ul=document.createElement('ul');ul.className='source-list';for(const r of data.reporting.slice(0,12)){const li=document.createElement('li'),a=document.createElement('a');a.href=r.canonical_url;a.target='_blank';a.rel='noreferrer';const main=document.createElement('span'),strong=document.createElement('strong'),small=document.createElement('small');strong.textContent=r.title;small.textContent=`${r.publisher}${r.published_at?' · '+new Date(r.published_at).toLocaleDateString(locale==='pmy'?'id-ID':'en-GB'):''}`;main.append(strong,small);const arrow=document.createElement('span');arrow.textContent='↗';a.append(main,arrow);li.append(a);ul.append(li)}reporting.replaceChildren(ul)}}).catch(()=>{});
</script></BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';import SourceList from '../components/SourceList.astro';import { developments } from '../data/developments';import { glossaryBySlug } from '../data/glossary';import { t, withLocale } from '../lib/i18n';import type { Issue,Locale } from '../data/types';
const {locale='en',issue}=Astro.props as {locale?:Locale;issue:Issue};const devs=developments.filter(d=>issue.developmentSlugs.includes(d.slug));
---
<BaseLayout locale={locale} active="issues" title={t(issue.title,locale)} description={t(issue.summary,locale)}>
  <div class="wrap"><section class="dossier-head"><div><div class="eyebrow">{locale==='en'?'Issue dossier':'Dossier isu'}</div><h1>{t(issue.title,locale)}</h1><p>{t(issue.summary,locale)}</p><div class="actions">{issue.concepts.filter(c=>glossaryBySlug[c]).slice(0,4).map(c=><a class="chip" href={withLocale(`/resources/#${c}`,locale)}>{glossaryBySlug[c].term}</a>)}<a class="chip" href={withLocale('/history/',locale)}>{locale==='en'?'History':'Sejarah'}</a></div></div><aside class="facts"><div class="eyebrow">{locale==='en'?'Current status':'Status sekarang'}</div><div class="fact"><span>{locale==='en'?'Status':'Status'}</span><strong>{t(issue.status,locale)}</strong></div><div class="fact"><span>{locale==='en'?'Last updated':'Diperbarui'}</span><strong>{issue.updatedAt}</strong></div><div class="fact"><span>{locale==='en'?'Developments':'Perkembangan'}</span><strong>{devs.length}</strong></div><div class="fact"><span>{locale==='en'?'Sources':'Sumber'}</span><strong>{issue.sourceIds.length}</strong></div></aside></section>
    <div class="dossier-grid"><section class="box"><h2>{locale==='en'?'Current summary':'Ringkasan sekarang'}</h2><p>{t(issue.summary,locale)}</p></section><section class="box"><h2>{locale==='en'?'What changed':'Yang berubah'}</h2>{devs.length?devs.map(d=><p style="margin-top:.65rem"><a href={withLocale('/',locale)}><strong>{t(d.title,locale)}</strong></a><br/><small style="color:var(--muted)">{d.updatedAt} · {d.sourceIds.length} {locale==='en'?'sources':'sumber'}</small></p>):<p>{locale==='en'?'No new development has been attached yet.':'Belum ada perkembangan baru yang ditautkan.'}</p>}</section></div>
    <section class="section" id="sources"><div class="section-head"><div><div class="eyebrow">{locale==='en'?'Sources':'Sumber'}</div><h2>{locale==='en'?'Source record':'Catatan sumber'}</h2></div></div><SourceList sourceIds={issue.sourceIds}/></section>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';import { events } from '../data/events';import type { Locale } from '../data/types';import ui from '../../content/ui.json';
const {locale='en'}=Astro.props as {locale?:Locale};
---
<BaseLayout locale={locale} active="events" title={locale==='en'?'Events':'Acara'}>
<section class="section"><div class="wrap"><h1 class="page-title">{ui.events.pageTitle[locale]}</h1><div class="event-hero"><div class="event-copy"><div class="eyebrow">{ui.events.heroEyebrow}</div><h2>{ui.events.heroTitle}</h2><p>{ui.events.heroBody[locale]}</p><div class="actions"><a class="chip primary" href="https://readmyworld.nl/" target="_blank" rel="noreferrer">Read My World ↗</a><a class="chip" href="#campaign">SOS Papua</a></div></div><div class="event-art"></div></div>
<div class="event-list">{events.map(e=><article class="event-row"><div><div class="eyebrow">{e.date}</div><strong>{e.time}</strong></div><h3>{e.title}</h3><p>{e.summary}<br/><small>{e.place}</small></p></article>)}</div>
</div></section>
<section class="section" id="campaign"><div class="wrap"><div class="section-head"><div><div class="eyebrow">SOS Papua</div><h2>{locale==='en'?'Campaign materials and public information.':'Materi kampanye deng informasi publik.'}</h2></div></div><div class="campaign-grid"><article class="issue-card"><div class="eyebrow">Programme</div><h3>Europe 2026</h3><p>{locale==='en'?'Confirmed programme, dates, venues and public events.':'Program, tanggal, tempat, deng acara publik yang sudah dikonfirmasi.'}</p></article><article class="issue-card"><div class="eyebrow">Materials</div><h3>{locale==='en'?'Downloads':'Unduhan'}</h3><p>{locale==='en'?'Posters, QR artwork, references and campaign files can live here.':'Poster, QR, referensi, deng file kampanye bisa ada di sini.'}</p></article><article class="issue-card"><div class="eyebrow">Organizations</div><h3>{locale==='en'?'Partners':'Mitra'}</h3><p>PUSAKA Bentala Rakyat, cultural participants, programme hosts, and supporting organizations.</p></article></div></div></section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import {events,campaignMaterials,eventsAsOf,dateInZone} from '../data/events';
import {withLocale,t} from '../lib/i18n';
import type {Locale} from '../data/types';
import type {WatchEvent} from '../data/events';
const {locale='en'}=Astro.props as {locale?:Locale};const en=locale==='en';
const current=events.filter(e=>e.openEnded&&e.date<=dateInZone(e.timezone)&&(!e.endDate||e.endDate>=dateInZone(e.timezone)));
const future=events.filter(e=>!e.openEnded&&(e.endDate||e.date)>=dateInZone(e.timezone));
const past=events.filter(e=>!e.openEnded&&(e.endDate||e.date)<dateInZone(e.timezone)).reverse();
const day=(date:string)=>new Intl.DateTimeFormat(en?'en-GB':'id-ID',{timeZone:'UTC',day:'2-digit'}).format(new Date(`${date}T12:00:00Z`));
const month=(date:string)=>new Intl.DateTimeFormat(en?'en-GB':'id-ID',{timeZone:'UTC',month:'short'}).format(new Date(`${date}T12:00:00Z`));
const kind=(name:string)=>en?name:({'Exhibition':'Pameran','Screening':'Pemutaran film','Festival':'Festival','Installation':'Instalasi','Programme':'Program','Public discussion':'Diskusi publik'} as Record<string,string>)[name]||name;
const zone=(event:WatchEvent)=>({'Asia/Jayapura':'WIT','Asia/Jakarta':'WIB'} as Record<string,string>)[event.timezone]||new Intl.DateTimeFormat('en-GB',{timeZone:event.timezone,timeZoneName:'short'}).formatToParts(new Date(`${event.date}T12:00:00Z`)).find(part=>part.type==='timeZoneName')?.value||event.timezone;
---
<BaseLayout locale={locale} active="events" title={en?'Events':'Acara'} description={en?'Public events, exhibitions and screenings about Papua.':'Acara publik, pameran, dan pemutaran film tentang Papua.'}>
<div class="events-page wrap" data-events-page>
  <header class="events-intro"><span class="eyebrow">{en?'PUBLIC PROGRAMME':'AGENDA PUBLIK'}</span><h1>{en?'Events':'Acara'}<span>.</span></h1><div class="events-intro-bottom"><p>{en?'Gatherings, screenings, discussions and exhibitions about Papua, wherever they happen.':'Pertemuan, pemutaran film, diskusi, dan pameran tentang Papua, di mana pun berlangsung.'}</p><a href="/events.ics" class="events-calendar">{en?'Calendar feed':'Kalender acara'} ↗</a></div></header>
  <nav class="events-index" aria-label={en?'Event sections':'Bagian acara'}><a href="#now">{en?'Now':'Saat ini'}</a><a href="#next">{en?'Next':'Mendatang'}</a><a href="#recent">{en?'Recent':'Sebelumnya'}</a></nav>
  <section class="events-section" id="now" data-now-section hidden={!current.length}><header><span class="eyebrow">01 / {en?'ON VIEW':'SEDANG BERLANGSUNG'}</span><h2>{en?'On view':'Sedang berlangsung'}</h2></header><div class="events-now-grid">
    {current.map(e=><article class="events-now-card" data-now-start={e.date} data-now-end={e.endDate||''} data-timezone={e.timezone}><span>{kind(e.kind)} · {e.place}</span><h3>{e.title}</h3><p>{t(e.summary,locale)}</p><div class="events-card-footer"><span>{day(e.date)} {month(e.date)} {e.date.slice(0,4)}{e.endDate&&<> – {day(e.endDate)} {month(e.endDate)} {e.endDate.slice(0,4)}</>}</span><a href={e.sourceUrl} target="_blank" rel="noreferrer">{en?'Host listing':'Halaman penyelenggara'} ↗</a></div></article>)}
  </div></section>
  <section class="events-section" id="next"><header><span class="eyebrow">02 / {en?'UPCOMING':'MENDATANG'}</span><h2>{en?'Next':'Mendatang'}</h2><p>{en?'Times are local to each event. Check the host page for changes.':'Waktu mengikuti lokasi acara. Periksa halaman penyelenggara untuk perubahan.'}</p></header>
    <div class="events-filters" data-event-filters aria-label={en?'Filter events':'Saring acara'}><button type="button" data-event-filter="all" aria-pressed="true">{en?'All':'Semua'}</button><button type="button" data-event-filter="Papua" aria-pressed="false">Papua</button><button type="button" data-event-filter="elsewhere" aria-pressed="false">{en?'Elsewhere':'Di tempat lain'}</button></div>
    <div class="events-rows" data-upcoming>{future.map(e=><article class="event-entry" data-event-entry data-region={e.region} data-end={e.endDate||e.date} data-timezone={e.timezone}>
      <div class="event-date"><strong>{day(e.date)}</strong><span>{month(e.date)} {e.date.slice(0,4)}</span></div><div class="event-entry-main"><span class="event-kicker">{kind(e.kind)} <i>·</i> {e.place}</span><h3><a href={e.sourceUrl} target="_blank" rel="noreferrer">{e.title}<span aria-hidden="true">↗</span></a></h3><p>{t(e.summary,locale)}</p><div class="event-entry-links">{e.issueSlug&&<a href={withLocale(`/topics/${e.issueSlug}/`,locale)}>{en?'Related issue':'Isu terkait'} ↗</a>}<a href={e.sourceUrl} target="_blank" rel="noreferrer">{en?'Source & details':'Sumber & rincian'} ↗</a></div></div><div class="event-time">{e.time?<><strong>{e.time}</strong><small title={e.timezone}>{zone(e)}</small></>:<small>{en?'Time not listed':'Waktu belum tercantum'}</small>}{e.endDate!==e.date&&<small>{en?'Until':'Hingga'} {day(e.endDate||e.date)} {month(e.endDate||e.date)}</small>}</div>
    </article>)}</div><p class="events-empty" data-events-empty hidden>{en?'No upcoming events in this selection. Browse recent events or check again soon.':'Belum ada acara mendatang dalam pilihan ini. Lihat acara sebelumnya atau periksa lagi nanti.'}</p>
  </section>
  <section class="events-section" id="recent" data-recent-section><header><span class="eyebrow">03 / {en?'ARCHIVE':'ARSIP'}</span><h2>{en?'Recently held':'Baru berlangsung'}</h2></header><div class="events-rows events-recent" data-recent>{past.map(e=><article class="event-entry" data-event-entry data-region={e.region} data-end={e.endDate||e.date} data-timezone={e.timezone}><div class="event-date"><strong>{day(e.date)}</strong><span>{month(e.date)} {e.date.slice(0,4)}</span></div><div class="event-entry-main"><span class="event-kicker">{kind(e.kind)} · {e.place}</span><h3><a href={e.sourceUrl} target="_blank" rel="noreferrer">{e.title} ↗</a></h3><p>{t(e.summary,locale)}</p></div></article>)}</div></section>
  <footer class="events-footer"><div><span class="eyebrow">{en?'FROM THE ARCHIVE':'DARI ARSIP'}</span><h2>{en?'Keep exploring.':'Jelajahi arsip.'}</h2><p class="events-reviewed">{en?'Listings reviewed':'Daftar diperiksa'} <time datetime={eventsAsOf}>{day(eventsAsOf)} {month(eventsAsOf)} {eventsAsOf.slice(0,4)}</time>. {en?'Confirm details with the host.':'Pastikan rincian dengan penyelenggara.'}</p></div><div>{campaignMaterials.map(item=><a href={item.href.startsWith('/')?withLocale(item.href,locale):item.href}>{en?item.label:({'programme':'Arsip program','resources':'Sumber','exhibition':'Pameran'} as Record<string,string>)[item.id]||item.label} ↗</a>)}</div></footer>
</div>
<script>
import {dateInZone} from '../data/events';
const page=document.querySelector<HTMLElement>('[data-events-page]');
if(page){const upcoming=page.querySelector<HTMLElement>('[data-upcoming]')!,recent=page.querySelector<HTMLElement>('[data-recent]')!,empty=page.querySelector<HTMLElement>('[data-events-empty]')!;
const filters=[...page.querySelectorAll<HTMLButtonElement>('[data-event-filter]')];let chosen='all';
const refresh=()=>{for(const row of [...page.querySelectorAll<HTMLElement>('[data-event-entry]')]){const isPast=(row.dataset.end||'')<dateInZone(row.dataset.timezone||'UTC');const destination=isPast?recent:upcoming;if(row.parentElement!==destination){isPast?recent.prepend(row):upcoming.append(row)}};for(const row of page.querySelectorAll<HTMLElement>('[data-upcoming] [data-event-entry]'))row.hidden=chosen==='Papua'?row.dataset.region!=='Papua':chosen==='elsewhere'?row.dataset.region==='Papua':false;for(const card of page.querySelectorAll<HTMLElement>('[data-now-end]'))card.hidden=(card.dataset.nowStart||'')>dateInZone(card.dataset.timezone||'UTC')||!!card.dataset.nowEnd&&card.dataset.nowEnd<dateInZone(card.dataset.timezone||'UTC');page.querySelector<HTMLElement>('[data-now-section]')!.hidden=!page.querySelector('[data-now-end]:not([hidden])');empty.hidden=!!upcoming.querySelector('[data-event-entry]:not([hidden])');page.querySelector<HTMLElement>('[data-recent-section]')!.hidden=!recent.children.length};
filters.forEach(button=>button.addEventListener('click',()=>{chosen=button.dataset.eventFilter||'all';filters.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));refresh()}));refresh();window.setInterval(refresh,60_000);}
</script>
</BaseLayout>
<style>
.events-now-card[hidden]{display:none}
.events-reviewed{color:var(--muted);font-size:.8rem;line-height:1.5}
.events-page{padding-bottom:8rem}.events-intro{padding:clamp(4rem,9vw,9rem) 0 3rem;border-bottom:1px solid var(--line);position:relative;isolation:isolate}.events-intro:before{content:'';position:absolute;z-index:-1;right:0;top:15%;width:min(48vw,640px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 42% 40%,#a895c922,#84b8c115 45%,transparent 70%);filter:blur(12px)}.events-intro h1{font-size:clamp(5rem,15vw,13rem);line-height:.84;letter-spacing:-.09em;margin:1.6rem 0 2.5rem}.events-intro h1 span{color:#b8b1da}.events-intro-bottom{display:flex;justify-content:space-between;align-items:end;gap:2rem}.events-intro-bottom p{font-size:clamp(1.15rem,2.1vw,1.7rem);color:var(--muted);max-width:30ch;line-height:1.45;margin:0}.events-calendar{border:1px solid var(--line);border-radius:50px;padding:13px 19px;white-space:nowrap}.events-index{display:flex;gap:2rem;padding:1.5rem 0;border-bottom:1px solid var(--line);color:var(--muted);font-size:.82rem}.events-index a:hover,.event-entry-links a:hover{color:#fff}.events-section{padding:clamp(3rem,6vw,6rem) 0 1rem;scroll-margin-top:90px}.events-section>header{display:flex;align-items:baseline;gap:1.5rem;flex-wrap:wrap;margin-bottom:2rem}.events-section>header h2{font-size:clamp(2.5rem,5vw,5rem);letter-spacing:-.06em;line-height:1;margin:0}.events-section>header p{color:var(--muted);font-size:.9rem;margin:0 0 0 auto;max-width:30ch}.events-now-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,390px),1fr));gap:14px}.events-now-card{min-height:330px;display:flex;flex-direction:column;padding:clamp(1.6rem,3vw,3rem);border-radius:24px;border:1px solid #ffffff20;background:radial-gradient(ellipse at 88% 8%,#9eaecd50,transparent 60%),radial-gradient(ellipse at 15% 100%,#ac86a239,transparent 65%),#222635;overflow:hidden;position:relative}.events-now-card:before{content:'';position:absolute;right:-10%;top:-42%;width:80%;aspect-ratio:1;border:1px solid #ffffff26;border-radius:50%;box-shadow:0 0 0 45px #ffffff05,0 0 0 90px #ffffff05}.events-now-card>span,.event-kicker{font-size:.66rem;text-transform:uppercase;letter-spacing:.12em;color:#f0edf0aa}.events-now-card h3{font-size:clamp(2.2rem,4vw,4rem);letter-spacing:-.06em;line-height:1.03;margin:auto 0 .9rem;position:relative}.events-now-card p{max-width:44ch;color:#e4e0e4b9}.events-card-footer{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid #ffffff25;padding-top:1rem;font-size:.8rem}.events-filters{display:flex;gap:8px;margin:2rem 0 1rem;flex-wrap:wrap}.events-filters button{border:1px solid var(--line);background:#ffffff08;color:var(--muted);border-radius:40px;padding:10px 18px;cursor:pointer}.events-filters button[aria-pressed=true]{background:#d7d3e9;color:#26242e}.events-rows{border-top:1px solid var(--line)}.event-entry{display:grid;grid-template-columns:clamp(86px,11vw,155px) 1fr minmax(80px,170px);gap:clamp(1rem,3vw,4rem);border-bottom:1px solid var(--line);padding:clamp(1.8rem,3vw,3.5rem) 0;align-items:start;transition:background .25s}.event-entry:hover{background:#ffffff07}.event-entry[hidden]{display:none}.event-date strong{display:block;font-size:clamp(2.4rem,5vw,5rem);line-height:.9;letter-spacing:-.08em;font-weight:500}.event-date span{display:block;color:#b1acc5;margin-top:.65rem;font-size:.8rem;white-space:nowrap}.event-entry h3{font-size:clamp(1.5rem,3vw,3rem);line-height:1.08;letter-spacing:-.05em;margin:1rem 0}.event-entry h3 a span{font-size:.55em;margin-left:12px;vertical-align:top;color:#b4b0c6}.event-entry-main p{max-width:55ch;color:var(--muted);line-height:1.6;margin:0 0 1.3rem}.event-entry-links{display:flex;gap:1.4rem;color:#beb8cf;font-size:.78rem;flex-wrap:wrap}.event-time{text-align:right;font-variant-numeric:tabular-nums}.event-time strong{font-size:1.4rem;font-weight:500}.event-time small{display:block;color:var(--muted);font-size:.67rem;line-height:1.6;overflow-wrap:anywhere}.events-recent{opacity:.7}.events-empty{padding:3rem 0;color:var(--muted)}.events-footer{border-top:1px solid var(--line);margin-top:4rem;padding-top:2.5rem;display:flex;justify-content:space-between;gap:2rem}.events-footer h2{font-size:clamp(2rem,4vw,4rem);letter-spacing:-.05em;margin:1rem 0}.events-footer>div:last-child{display:flex;flex-direction:column;gap:.8rem;color:var(--muted)}@media(max-width:680px){.events-intro{padding-top:4rem}.events-intro h1{font-size:clamp(4.5rem,18vw,7rem)}.events-intro-bottom{align-items:start;flex-direction:column}.events-section>header{display:block}.events-section>header h2{margin:.8rem 0}.events-section>header p{margin:1rem 0}.event-entry{grid-template-columns:68px 1fr;gap:1rem}.event-date strong{font-size:2.3rem}.event-entry h3{font-size:1.55rem;margin:.8rem 0}.event-time{grid-column:2;text-align:left;display:flex;gap:.6rem;align-items:baseline}.event-time small{font-size:.65rem}.events-footer{display:block}}
</style>
